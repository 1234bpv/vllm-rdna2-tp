# Preset: Qwen3.8-27B, AWQ int4 weights, two RDNA2 cards (tensor parallel 2).
# Format: KEY=value lines only. serve.sh reads this file as data, never runs it.
# PRESET_ENV entries are exported to the server. Shared defaults: BATCHTOK=8192,
# LONGPREFILL=2048 (set in lib.sh), REASON_END default (set in lib.sh).
HF_ID=philbert440/Qwen3.8-27B-W4A16-AWQ
CONVERT=
SERVED_NAME=qwen3.8-27b
CTX=262144
KV=int4_per_token_head
UTIL=0.92
MAXSEQ=8
MTP=0
MTP_METHOD=qwen3_5_mtp
MTP_CAPTURE_SIZES=[1,2,3,4,6,8,9,12,15,16,18,21,24,32,40,48]
TOOL_PARSER=qwen3_xml
REASONING_PARSER=qwen3
VISION_KWARGS=1
VISION_DEFAULT=0
PRESET_ENV=VLLM_ROCM_W4A8=256 VLLM_ROCM_W4A8_TILE=8 VLLM_ROCM_LMHEAD_INT8=1 VLLM_ROCM_EMBED_UVA=1 VLLM_ROCM_MIN_P_FLOOR=0.05 VLLM_ROCM_MAX_TEMPERATURE=0
