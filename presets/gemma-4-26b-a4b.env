# Preset: Gemma 4 26B-A4B (MoE), AWQ int4 weights, two RDNA2 cards (tensor parallel 2).
# No MTP for this model. REASON_END is empty: the reasoning-end phrase is off unless
# the REASONEND environment variable is set explicitly for one run.
# Format: KEY=value lines only. serve.sh reads this file as data, never runs it.
HF_ID=cyankiwi/gemma-4-26B-A4B-it-qat-AWQ-INT4
CONVERT=
SERVED_NAME=gemma-4-26b-a4b
CTX=262144
KV=int4_per_token_head
UTIL=0.97
MAXSEQ=16
MTP=0
MTP_METHOD=
TOOL_PARSER=gemma4
REASONING_PARSER=gemma4
VISION_KWARGS=0
VISION_DEFAULT=1
REASON_END=
PRESET_ENV=VLLM_ROCM_MOE_RDNA2=1 VLLM_ROCM_MAX_TEMPERATURE=0
