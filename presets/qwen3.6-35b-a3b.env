# Preset: Qwen3.6-35B-A3B (MoE) with MTP speculative decoding, two RDNA2 cards.
# Weights are converted from AWQ to compressed-tensors: scripts/download-model.sh
# writes the converted directory MODELS/qwen3.6-35b-a3b-ct-int4.
# Format: KEY=value lines only. serve.sh reads this file as data, never runs it.
HF_ID=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
CONVERT=awq-to-ct
SERVED_NAME=qwen3.6-35b-a3b
CTX=262144
KV=int4_per_token_head
UTIL=0.97
MAXSEQ=8
MTP=1
MTP_METHOD=qwen3_5_mtp
MTP_CAPTURE_SIZES=[1,2,3,4,6,8,9,12,16,18,24]
TOOL_PARSER=qwen3_xml
REASONING_PARSER=qwen3
VISION_KWARGS=1
VISION_DEFAULT=1
PRESET_ENV=VLLM_ROCM_MOE_RDNA2=1 VLLM_ROCM_W8A16=1 VLLM_ROCM_MAX_TEMPERATURE=0
