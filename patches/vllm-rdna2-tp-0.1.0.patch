+# ===========================================================================
+# Доповнення специфікації після рецензії (пункти A-E).
+# ===========================================================================
+
+ALIGN_TURNS = 5
+STAGGER_CASES = [(5, 1), (4, 2), (3, 3), (2, 2), (1, 3)]
+LONG_NEW_PROMPTS = [500, 700, 900]
+STAGGER_BUDGET = 256
+
+
+def _ceil_div(a: int, b: int) -> int:
+    return -(-a // b)
+
+
+def _new_requests(kind: str, k: int) -> list:
+    """k нових запитів: короткі (префіл за крок) або довгі різних довжин
+    (кілька шматків при бюджеті STAGGER_BUDGET)."""
+    out = []
+    for i in range(k):
+        if kind == "short":
+            prompt, max_tokens = SHORT_PROMPT, LONG_MAX_TOKENS
+        else:
+            prompt, max_tokens = LONG_NEW_PROMPTS[i], 500
+        (req,) = create_requests(
+            num_requests=1, num_tokens=prompt, max_tokens=max_tokens,
+            ignore_eos=True, req_ids=[f"new{i}"],
+        )
+        out.append(req)
+    return out
+
+
+def _all_decoding(requests) -> bool:
+    return all(r.num_output_tokens > 0 for r in requests)
+
+
+def _staggered_scenario(n0: int, k: int, kind: str, arrival: str):
+    """N0 запитів уже декодують; потім приходять k нових — разом або по
+    одному на оборот. Повертає рушій у мить, коли всі N=N0+k декодують."""
+    scheduler, engine, initial = _start_decoding(
+        n0, max_num_batched_tokens=STAGGER_BUDGET
+    )
+    engine.run_turns(WARMUP_TURNS)
+    newcomers = _new_requests(kind, k)
+    for i, req in enumerate(newcomers):
+        scheduler.add_request(req)
+        if arrival == "staggered" and i < k - 1:
+            engine.run_turns(1)
+    everyone = initial + newcomers
+    for _ in range(100 * engine.queue_size):
+        if _all_decoding(everyone):
+            break
+        engine.step()
+    assert _all_decoding(everyone), (
+        f"{n0}+{k} ({kind}, {arrival}): не всі вийшли з префілу за 100 "
+        f"оборотів: {[(r.request_id, r.num_output_tokens) for r in everyone]}"
+    )
+    return scheduler, engine, everyone
+
+
+STAGGER_PARAMS = [
+    pytest.param(n0, k, kind, arrival, id=f"{n0}+{k}-{kind}-{arrival}")
+    for n0, k in STAGGER_CASES
+    for kind in ("short", "long")
+    for arrival in ("together", "staggered")
+]
