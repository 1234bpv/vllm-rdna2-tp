diff --git a/vllm/v1/attention/ops/int4_decode_attn.hip b/vllm/v1/attention/ops/int4_decode_attn.hip
new file mode 100644
index 0000000000000000000000000000000000000000..8eae38bdd9486e5265b377fed335ae9c156e9ab9
--- /dev/null
+++ b/vllm/v1/attention/ops/int4_decode_attn.hip
@@ -0,0 +1,600 @@
+// HIP kernel for int4 KV decode attention on AMD RDNA2 (gfx1030).
+// Emulates Triton _attn_packed in 3D decode mode with W4A8, FP16_DOT,
+// 256 segments, online softmax, nibble unpacking, zero-point subtraction.
+// head_size 256 (most layers) and 512 (the global layers of Gemma 4), with an
+// optional sliding window (Gemma 4 local layers).
+//
+// QL > 1 is speculative-decode verification: QL query tokens of one
+// sequence share a workgroup, so the KV cache is read once for all of them
+// instead of once per Triton query block (with BLOCK_Q = 2 at qlen = 3 the
+// cache was read twice and the kernel ran at ~26 GB/s; 29.09).
+
+#include <torch/extension.h>
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <hip/hip_fp16.h>
+#include <cstdint>
+#include <algorithm>
+
+#define CUDART_INF_F __int_as_float(0x7f800000)
+
+// Tile of 32 tokens. Q·K: lane = token, each lane computes the full HS-dim
+// dot product of its own token, so no cross-lane reduction per token.
+// P·V: lane = 8 output dims per 256-dim chunk (HS / 256 chunks), as in the
+// Triton kernel. P crosses between the two layouts through LDS.
+constexpr int kTile = 32;
+
+__device__ __forceinline__ float wave_max(float x) {
+    #pragma unroll
+    for (int mask = 16; mask > 0; mask >>= 1) x = fmaxf(x, __shfl_xor(x, mask, 32));
+    return x;
+}
+
+__device__ __forceinline__ float wave_sum(float x) {
+    #pragma unroll
+    for (int mask = 16; mask > 0; mask >>= 1) x += __shfl_xor(x, mask, 32);
+    return x;
+}
+
+typedef _Float16 half2_t __attribute__((ext_vector_type(2)));
+
+__device__ __forceinline__ float scale_bits(uint32_t raw) {
+    uint32_t bits = raw & ~0xFu;
+    return *(const float*)&bits;
+}
+
+// Rows of one workgroup: R = QL * G (query token x query head of the KV
+// head). Each wave keeps at most 9 of them at HS = 256: at 12 rows per wave
+// the kernel already sat at 251 VGPRs, and 18 (G = 6, QL = 3 on one wave)
+// spilled 296 bytes per lane to scratch. At HS = 512 the accumulator and the
+// K row of a lane are twice as large, so the cap is 4 (G = 8, QL = 1: 256
+// VGPRs on two waves; measured 01.10 at 8192..32768 tokens, 1 and 4
+// sequences: cap 2 is 6..33 % slower, cap 8 on one wave 76..161 % slower).
+// The waves of a workgroup read the same K/V tile, so the second read comes
+// from the CU's cache, not from memory. HS = 256 with QL = 1 keeps the
+// original single-wave layout.
+constexpr int max_rows_per_wave(int hs) { return hs == 256 ? 9 : 4; }
+
+constexpr int wave_count(int rows, int hs) {
+    int w = (rows + max_rows_per_wave(hs) - 1) / max_rows_per_wave(hs);
+    while (rows % w != 0) ++w;
+    return w;
+}
+
+template <int HS, int G, int QL>
+struct RowSplit {
+    static constexpr int R = QL * G;
+    static constexpr int kWaves = wave_count(R, HS);
+    static constexpr int kRowsPerWave = R / kWaves;
+    static_assert(R % kWaves == 0, "rows must split evenly between waves");
+};
+
+template <int HS, int G, int QL>
+__global__ __launch_bounds__((32 * RowSplit<HS, G, QL>::kWaves)) void int4_decode_attn_kernel(
+    float* __restrict__ segm_output,
+    float* __restrict__ segm_max,
+    float* __restrict__ segm_expsum,
+    const int8_t* __restrict__ q_i8,
+    const float* __restrict__ q_scale,
+    const uint8_t* __restrict__ k_cache,
+    const uint8_t* __restrict__ v_cache,
+    const float* __restrict__ k_scale_cache,
+    const float* __restrict__ v_scale_cache,
+    const int32_t* __restrict__ block_table,
+    const int32_t* __restrict__ seqused_k,
+    const int32_t* __restrict__ cu_seqlens_q,
+    float softmax_scale,
+    int64_t block_table_stride,
+    int64_t q_i8_stride_0,
+    int64_t q_i8_stride_1,
+    int64_t q_scale_stride_0,
+    int64_t q_scale_stride_1,
+    int64_t stride_k_cache_0,
+    int64_t stride_k_cache_1,
+    int64_t stride_k_cache_2,
+    int64_t stride_k_cache_3,
+    int64_t stride_v_cache_0,
+    int64_t stride_v_cache_1,
+    int64_t stride_v_cache_2,
+    int64_t stride_v_cache_3,
+    int64_t stride_ks_blk,
+    int64_t stride_ks_slot,
+    int64_t stride_ks_head,
+    int64_t stride_vs_blk,
+    int64_t stride_vs_slot,
+    int64_t stride_vs_head,
+    int64_t segm_output_stride_0,
+    int64_t segm_output_stride_1,
+    int64_t segm_output_stride_2,
+    int64_t segm_output_stride_3,
+    int64_t segm_max_stride_0,
+    int64_t segm_max_stride_1,
+    int64_t segm_max_stride_2,
+    int64_t segm_expsum_stride_0,
+    int64_t segm_expsum_stride_1,
+    int64_t segm_expsum_stride_2,
+    int num_query_heads,
+    int num_kv_heads,
+    int num_segments,
+    int block_size,
+    int sliding_window,
+    int segment_tile
+) {
+    // Row r = qi * G + g: query token qi of the sequence, query head g of
+    // the KV head. s_q[r][j] / s_q[r][NJ + j]: Q bytes matching the even /
+    // odd nibbles of K dword j (dims 8j + {0,2,4,6} / 8j + {1,3,5,7}).
+    constexpr int R = RowSplit<HS, G, QL>::R;
+    constexpr int RW = RowSplit<HS, G, QL>::kRowsPerWave;
+    static_assert(HS == 256 || HS == 512, "head_size must be 256 or 512");
+    constexpr int NJ = HS / 8;   // K dwords per token
+    constexpr int NC = HS / 256; // 256-dim chunks: lane owns 8 dims of each
+    __shared__ int s_q[R][2 * NJ];
+    // P·V weights in fp16, as Triton feeds them: s_pv[t / 2][r] holds the
+    // pair (token t, token t + 1) of row r, so one v_dot2_f32_f16 covers two
+    // tokens and a wave reads the pairs of its rows as adjacent dwords.
+    __shared__ half2_t s_pv[kTile / 2][R];
+    // Uniform per-row constants live in LDS, not registers.
+    __shared__ float s_q_sum[R];
+    __shared__ float s_q_scale[R];
+
+    const int segm_idx = blockIdx.x;
+    const int kv_head_idx = blockIdx.y;
+    const int seq_idx = blockIdx.z;
+    const int lane = threadIdx.x & 31;
+    // This wave owns rows [row0, row0 + RW).
+    const int row0 = (threadIdx.x >> 5) * RW;
+
+    const int seq_len = seqused_k[seq_idx];
+    if (seq_len <= 0) return;
+
+    // Segment bounds in tiles of segment_tile tokens (16, or 32 for the
+    // Gemma 3/4 sliding layers), identical to Triton's compute_tile_loop_bounds,
+    // so reduce_segments sees the same segments. Not the 32 of kTile below.
+    const int seg_span = num_segments * segment_tile;
+    const int tiles_per_segment = (seq_len + seg_span - 1) / seg_span;
+    if (segm_idx * tiles_per_segment * segment_tile >= seq_len) return;
+    const int seg_lo = segm_idx * tiles_per_segment * segment_tile;
+    const int seg_hi = min((segm_idx + 1) * tiles_per_segment * segment_tile, seq_len);
+
+    const int token_idx = cu_seqlens_q[seq_idx];
+    // The caller guarantees q_len <= QL (QL >= max_seqlen_q).
+    const int q_len = cu_seqlens_q[seq_idx + 1] - token_idx;
+    if (q_len <= 0) return;
+    if (q_len > QL) {
+        // Rows qi >= QL do not exist in this instantiation. Poison every row
+        // of the sequence instead of leaving reduce_segments to read stale
+        // buffer contents, which look plausible.
+        const float nan = __int_as_float(0x7fc00000);
+        for (int idx = threadIdx.x; idx < q_len * G; idx += blockDim.x) {
+            const int64_t tok = token_idx + idx / G;
+            const int64_t head = kv_head_idx * G + idx % G;
+            segm_max[tok * segm_max_stride_0 + head * segm_max_stride_1 + (int64_t)segm_idx * segm_max_stride_2] = nan;
+            segm_expsum[tok * segm_expsum_stride_0 + head * segm_expsum_stride_1 + (int64_t)segm_idx * segm_expsum_stride_2] = nan;
+        }
+        return;
+    }
+    // Query token qi sits at absolute position context_len + qi and sees
+    // keys up to and including that position.
+    const int context_len = seq_len - q_len;
+
+    // Sliding window of W = sliding_window keys: row qi sees key p when
+    // p <= context_len + qi and context_len + qi - p < W, as Triton's
+    // compute_kv_seq_mask does. The oldest key any row needs belongs to
+    // row 0. tile_lo keeps the 16-token grid of the segment.
+    const int win = sliding_window > 0 ? sliding_window : 0x7fffffff;
+    const int tile_lo = max(seg_lo, max(context_len - win + 1, 0) & ~15);
+    if (sliding_window > 0 && tile_lo >= seg_hi) {
+        // The segment lies wholly outside the window. reduce_segments still
+        // reads it (it is below seq_len), and weighs it by exp(-inf) = 0
+        // only if its output is finite: write what an empty tile loop would,
+        // (M, L) = (-inf, 1) and zeros.
+        // Guarded by sliding_window: without a window tile_lo >= seg_hi never
+        // holds, and the unguarded test cost the head-256 kernel 2.7 % at
+        // 32768 tokens (probably code layout; measured 01.10).
+        for (int idx = threadIdx.x; idx < q_len * G; idx += blockDim.x) {
+            const int64_t tok = token_idx + idx / G;
+            const int64_t head = kv_head_idx * G + idx % G;
+            segm_max[tok * segm_max_stride_0 + head * segm_max_stride_1 + (int64_t)segm_idx * segm_max_stride_2] = -CUDART_INF_F;
+            segm_expsum[tok * segm_expsum_stride_0 + head * segm_expsum_stride_1 + (int64_t)segm_idx * segm_expsum_stride_2] = 1.0f;
+        }
+        for (int idx = threadIdx.x; idx < q_len * G * HS; idx += blockDim.x) {
+            const int row = idx / HS;
+            const int64_t tok = token_idx + row / G;
+            const int64_t head = kv_head_idx * G + row % G;
+            segm_output[tok * segm_output_stride_0 + head * segm_output_stride_1
+                        + (int64_t)segm_idx * segm_output_stride_2 + (int64_t)(idx % HS) * segm_output_stride_3] = 0.0f;
+        }
+        return;
+    }
+
+    #pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        const int r = row0 + i;
+        const int qi = r / G;
+        const int g = r % G;
+        if (qi < q_len) {
+            const int q_head = kv_head_idx * G + g;
+            const int64_t q_tok = token_idx + qi;
+            int part = 0;
+            #pragma unroll
+            for (int h = 0; h < NC; ++h) {
+                const int8_t* q_ptr = q_i8 + q_tok * q_i8_stride_0 + q_head * q_i8_stride_1 + 8 * (lane + 32 * h);
+                int8_t q[8];
+                #pragma unroll
+                for (int c = 0; c < 8; ++c) q[c] = q_ptr[c];
+                s_q[r][lane + 32 * h] = (uint8_t)q[0] | ((uint8_t)q[2] << 8) | ((uint8_t)q[4] << 16) | ((uint32_t)(uint8_t)q[6] << 24);
+                s_q[r][NJ + lane + 32 * h] = (uint8_t)q[1] | ((uint8_t)q[3] << 8) | ((uint8_t)q[5] << 16) | ((uint32_t)(uint8_t)q[7] << 24);
+                #pragma unroll
+                for (int c = 0; c < 8; ++c) part += q[c];
+            }
+            #pragma unroll
+            for (int mask = 16; mask > 0; mask >>= 1) part += __shfl_xor(part, mask, 32);
+            if (lane == 0) {
+                s_q_sum[r] = (float)part;
+                s_q_scale[r] = softmax_scale * q_scale[q_tok * q_scale_stride_0 + q_head * q_scale_stride_1];
+            }
+        } else {
+            #pragma unroll
+            for (int h = 0; h < NC; ++h) {
+                s_q[r][lane + 32 * h] = 0;
+                s_q[r][NJ + lane + 32 * h] = 0;
+            }
+            if (lane == 0) {
+                s_q_sum[r] = 0.0f;
+                s_q_scale[r] = 0.0f;
+            }
+        }
+    }
+    __syncthreads();
+
+    // M is uniform across lanes; L and the zero-point sum are per-lane
+    // partial sums (lane = token) reduced once in the epilogue. Triton starts
+    // L at 1 with M = -inf; the first rescale by alpha = 0 wipes it either way.
+    float acc[RW][8 * NC];
+    float M[RW], L_part[RW], zp_part[RW];
+    #pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        #pragma unroll
+        for (int c = 0; c < 8 * NC; ++c) acc[i][c] = 0.0f;
+        M[i] = -CUDART_INF_F;
+        L_part[i] = lane == 0 ? 1.0f : 0.0f;
+        zp_part[i] = 0.0f;
+    }
+
+    const int32_t* seq_bt = block_table + seq_idx * block_table_stride;
+
+    for (int tok0 = tile_lo; tok0 < seg_hi; tok0 += kTile) {
+        // tok0 is a multiple of 16 and block_size is 16 or >= kTile (checked
+        // by the caller): a tile spans at most two cache blocks.
+        const int blk_logical = tok0 / block_size;
+        const int blk_start = blk_logical * block_size;
+        const int blk_next = blk_start + block_size;
+        const int64_t phys_a = seq_bt[blk_logical];
+        const int64_t phys_b = tok0 + kTile > blk_next && blk_next < seq_len ? seq_bt[blk_logical + 1] : phys_a;
+
+        // Q·K: lane = token.
+        const int t_pos = tok0 + lane;
+        const uint32_t back = (uint32_t)(context_len - t_pos);
+        const bool valid = t_pos < seg_hi;
+        const bool in_a = t_pos < blk_next;
+        const int64_t phys = in_a ? phys_a : phys_b;
+        const int64_t slot = in_a ? t_pos - blk_start : t_pos - blk_next;
+
+        uint32_t kr[NJ];
+        float k_scale = 0.0f, k_zp = 0.0f, v_scale = 0.0f, v_zp = 0.0f;
+        if (valid) {
+            const uint32_t* kp = (const uint32_t*)(k_cache + phys * stride_k_cache_0 + slot * stride_k_cache_1 + kv_head_idx * stride_k_cache_2);
+            #pragma unroll
+            for (int j = 0; j < NJ; ++j) kr[j] = kp[j];
+            const uint32_t ks = *(const uint32_t*)(k_scale_cache + phys * stride_ks_blk + slot * stride_ks_slot + kv_head_idx * stride_ks_head);
+            const uint32_t vs = *(const uint32_t*)(v_scale_cache + phys * stride_vs_blk + slot * stride_vs_slot + kv_head_idx * stride_vs_head);
+            k_zp = (float)(ks & 0xFu);
+            k_scale = scale_bits(ks);
+            v_zp = (float)(vs & 0xFu);
+            v_scale = scale_bits(vs);
+        } else {
+            #pragma unroll
+            for (int j = 0; j < NJ; ++j) kr[j] = 0;
+        }
+
+        #pragma unroll
+        for (int i = 0; i < RW; ++i) {
+            const int r = row0 + i;
+            // Causal mask and window in one unsigned compare: the key is
+            // visible when 0 <= q_pos - t_pos < win, and a negative distance
+            // wraps above win. With QL = 1 qi is 0 and this is the single
+            // compare of the causal-only kernel (always true for valid lanes
+            // without a window, since t_pos < seg_hi <= seq_len).
+            const bool visible = valid && back + (uint32_t)(r / G) < (uint32_t)win;
+            int dot = 0;
+            #pragma unroll
+            for (int j = 0; j < NJ; ++j) {
+                dot = __builtin_amdgcn_sdot4(s_q[r][j], (int)(kr[j] & 0x0F0F0F0Fu), dot, false);
+                dot = __builtin_amdgcn_sdot4(s_q[r][NJ + j], (int)((kr[j] >> 4) & 0x0F0F0F0Fu), dot, false);
+            }
+            const float s = visible
+                ? ((float)dot - s_q_sum[r] * k_zp) * (s_q_scale[r] * k_scale)
+                : -CUDART_INF_F;
+
+            const float m_new = fmaxf(M[i], wave_max(s));
+            float al, p;
+            if (m_new <= -1e30f) {
+                // No key of this segment is visible to the row yet (only
+                // possible for QL > 1: the tile lies past the causal limit
+                // of an earlier query token). Keep M = -inf and L = 1 on
+                // lane 0: an unvisited segment then reads as Triton's empty
+                // one, (-inf, 1), which reduce_segments weighs by
+                // exp(-inf) = 0. Clamping M to 0, as a softmax step with
+                // everything masked otherwise would, could lift overall_max
+                // above the real maximum.
+                al = 1.0f;
+                p = 0.0f;
+            } else {
+                al = (M[i] <= -1e30f) ? 0.0f : expf(M[i] - m_new);
+                p = (s <= -1e30f) ? 0.0f : expf(s - m_new);
+                M[i] = m_new;
+            }
+
+            const float pv_f32 = p * v_scale;
+            L_part[i] = L_part[i] * al + p;
+            zp_part[i] = zp_part[i] * al + pv_f32 * v_zp;
+            // Triton feeds P·V in fp16: round the weight the same way.
+            // Through a half pointer on purpose: stored as s_pv[..][r][lane & 1]
+            // the compiler lowered it at R = 1 (G = 1, QL = 1) to a dword
+            // read-modify-write, and the two lanes of a pair then overwrote
+            // each other's half, leaving LDS garbage (NaN) in P.
+            ((_Float16*)&s_pv[0][0])[((lane >> 1) * R + r) * 2 + (lane & 1)] = (_Float16)pv_f32;
+            #pragma unroll
+            for (int c = 0; c < 8 * NC; ++c) acc[i][c] *= al;
+        }
+        __syncthreads();
+
+        // P·V: lane = 8 output dims of each 256-dim chunk; tokens are uniform,
+        // so the block lookup is scalar.
+        const int n_tok = min(kTile, seg_hi - tok0);
+        #pragma unroll
+        for (int h = 0; h < NC; ++h) {
+            const uint8_t* v_a = v_cache + phys_a * stride_v_cache_0 + kv_head_idx * stride_v_cache_2 + (int64_t)(4 * (lane + 32 * h)) * stride_v_cache_3;
+            const uint8_t* v_b = v_cache + phys_b * stride_v_cache_0 + kv_head_idx * stride_v_cache_2 + (int64_t)(4 * (lane + 32 * h)) * stride_v_cache_3;
+            uint32_t vbuf[kTile];
+            #pragma unroll
+            for (int t = 0; t < kTile; ++t) {
+                const int pos = tok0 + t;
+                if (t < n_tok) {
+                    vbuf[t] = pos < blk_next
+                        ? *(const uint32_t*)(v_a + (int64_t)(pos - blk_start) * stride_v_cache_1)
+                        : *(const uint32_t*)(v_b + (int64_t)(pos - blk_next) * stride_v_cache_1);
+                } else {
+                    vbuf[t] = 0;
+                }
+            }
+            // Tokens go in pairs. With an odd n_tok the second token of the last
+            // pair has vbuf = 0 and weight 0 (its lane was invalid or masked).
+            #pragma unroll
+            for (int t = 0; t < kTile; t += 2) {
+                if (t >= n_tok) break;
+                // v[c] = (nibble c of token t, nibble c of token t + 1) as half2:
+                // byte k of each token goes to the low byte of its half, the
+                // nibble is OR-ed into the mantissa of 1024.0 (0x6400), which
+                // represents 1024 + n exactly, and 1024 is then subtracted.
+                half2_t v[8];
+                #pragma unroll
+                for (int k = 0; k < 4; ++k) {
+                    const uint32_t pk = __builtin_amdgcn_perm(vbuf[t + 1], vbuf[t], 0x0c040c00u + 0x00010001u * k);
+                    const uint32_t lo = (pk & 0x000F000Fu) | 0x64006400u;
+                    const uint32_t hi = ((pk >> 4) & 0x000F000Fu) | 0x64006400u;
+                    v[2 * k] = __builtin_bit_cast(half2_t, lo) - (half2_t){(_Float16)1024.0f, (_Float16)1024.0f};
+                    v[2 * k + 1] = __builtin_bit_cast(half2_t, hi) - (half2_t){(_Float16)1024.0f, (_Float16)1024.0f};
+                }
+                #pragma unroll
+                for (int i = 0; i < RW; ++i) {
+                    const half2_t pv = s_pv[t >> 1][row0 + i];
+                    #pragma unroll
+                    for (int c = 0; c < 8; ++c) acc[i][8 * h + c] = __builtin_amdgcn_fdot2(pv, v[c], acc[i][8 * h + c], false);
+                }
+            }
+        }
+        // The next tile overwrites s_pv.
+        __syncthreads();
+    }
+
+    #pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        const int r = row0 + i;
+        const int qi = r / G;
+        if (qi >= q_len) continue;
+        const int q_head = kv_head_idx * G + r % G;
+        const float L = wave_sum(L_part[i]);
+        const float zp_acc = wave_sum(zp_part[i]);
+
+        const int64_t segm_base = (int64_t)(token_idx + qi) * segm_output_stride_0
+                                + (int64_t)q_head * segm_output_stride_1
+                                + (int64_t)segm_idx * segm_output_stride_2;
+        #pragma unroll
+        for (int h = 0; h < NC; ++h) {
+            #pragma unroll
+            for (int c = 0; c < 8; ++c) {
+                segm_output[segm_base + (int64_t)(256 * h + 8 * lane + c) * segm_output_stride_3] = acc[i][8 * h + c] - zp_acc;
+            }
+        }
+        if (lane == 0) {
+            segm_max[(int64_t)(token_idx + qi) * segm_max_stride_0 + (int64_t)q_head * segm_max_stride_1
+                     + (int64_t)segm_idx * segm_max_stride_2] = M[i];
+            segm_expsum[(int64_t)(token_idx + qi) * segm_expsum_stride_0 + (int64_t)q_head * segm_expsum_stride_1
+                        + (int64_t)segm_idx * segm_expsum_stride_2] = L;
+        }
+    }
+}
+
+void int4_decode_attn(
+    torch::Tensor segm_output,
+    torch::Tensor segm_max,
+    torch::Tensor segm_expsum,
+    torch::Tensor q_i8,
+    torch::Tensor q_scale,
+    torch::Tensor k_cache,
+    torch::Tensor v_cache,
+    torch::Tensor k_scale_cache,
+    torch::Tensor v_scale_cache,
+    torch::Tensor block_table,
+    torch::Tensor seqused_k,
+    torch::Tensor cu_seqlens_q,
+    double softmax_scale,
+    int64_t num_seqs,
+    int64_t num_query_heads,
+    int64_t num_kv_heads,
+    int64_t num_queries_per_kv,
+    int64_t head_size,
+    int64_t block_size,
+    int64_t num_segments,
+    int64_t max_query_len,
+    int64_t sliding_window,
+    int64_t segment_tile
+) {
+    if (num_seqs <= 0 || num_kv_heads <= 0 || num_segments <= 0) return;
+
+    TORCH_CHECK(head_size == 256 || head_size == 512, "head_size must be 256 or 512");
+    TORCH_CHECK(sliding_window >= 0 && sliding_window <= INT32_MAX, "sliding_window must be in 0..INT32_MAX (0 = off)");
+    TORCH_CHECK(num_queries_per_kv >= 1 && num_queries_per_kv <= 8, "num_queries_per_kv must be in 1..8");
+    TORCH_CHECK(segment_tile == 16 || segment_tile == 32, "segment_tile must be 16 or 32");
+    TORCH_CHECK(block_size == 16 || block_size >= 32, "block_size must be 16 or >= 32");
+    TORCH_CHECK(max_query_len >= 1 && max_query_len <= 4, "max_query_len must be in 1..4");
+    TORCH_CHECK(q_i8.dtype() == torch::kInt8, "q_i8 must be int8");
+    TORCH_CHECK(k_cache.dtype() == torch::kUInt8 && v_cache.dtype() == torch::kUInt8,
+                "k_cache and v_cache must be uint8");
+    for (const auto* t : {&q_scale, &k_scale_cache, &v_scale_cache,
+                          &segm_output, &segm_max, &segm_expsum}) {
+        TORCH_CHECK(t->dtype() == torch::kFloat32, "scales and segm_* must be float32");
+    }
+    TORCH_CHECK(block_table.dtype() == torch::kInt32, "block_table must be int32");
+    TORCH_CHECK(seqused_k.dtype() == torch::kInt32, "seqused_k must be int32");
+    TORCH_CHECK(cu_seqlens_q.dtype() == torch::kInt32, "cu_seqlens_q must be int32");
+
+    dim3 grid(num_segments, num_kv_heads, num_seqs);
+    hipStream_t stream = at::hip::getCurrentHIPStream();
+
+    #define LAUNCH_KERNEL(HS_VAL, G_VAL, QL_VAL) \
+        int4_decode_attn_kernel<HS_VAL, G_VAL, QL_VAL><<<grid, dim3(32 * RowSplit<HS_VAL, G_VAL, QL_VAL>::kWaves, 1, 1), 0, stream>>>( \
+            segm_output.data_ptr<float>(), \
+            segm_max.data_ptr<float>(), \
+            segm_expsum.data_ptr<float>(), \
+            q_i8.data_ptr<int8_t>(), \
+            q_scale.data_ptr<float>(), \
+            k_cache.data_ptr<uint8_t>(), \
+            v_cache.data_ptr<uint8_t>(), \
+            k_scale_cache.data_ptr<float>(), \
+            v_scale_cache.data_ptr<float>(), \
+            block_table.data_ptr<int32_t>(), \
+            seqused_k.data_ptr<int32_t>(), \
+            cu_seqlens_q.data_ptr<int32_t>(), \
+            (float)softmax_scale, \
+            block_table.stride(0), \
+            q_i8.stride(0), \
+            q_i8.stride(1), \
+            q_scale.stride(0), \
+            q_scale.stride(1), \
+            k_cache.stride(0), \
+            k_cache.stride(1), \
+            k_cache.stride(2), \
+            k_cache.stride(3), \
+            v_cache.stride(0), \
+            v_cache.stride(1), \
+            v_cache.stride(2), \
+            v_cache.stride(3), \
+            k_scale_cache.stride(0), \
+            k_scale_cache.stride(1), \
+            k_scale_cache.stride(2), \
+            v_scale_cache.stride(0), \
+            v_scale_cache.stride(1), \
+            v_scale_cache.stride(2), \
+            segm_output.stride(0), \
+            segm_output.stride(1), \
+            segm_output.stride(2), \
+            segm_output.stride(3), \
+            segm_max.stride(0), \
+            segm_max.stride(1), \
+            segm_max.stride(2), \
+            segm_expsum.stride(0), \
+            segm_expsum.stride(1), \
+            segm_expsum.stride(2), \
+            (int)num_query_heads, \
+            (int)num_kv_heads, \
+            (int)num_segments, \
+            (int)block_size, \
+            (int)sliding_window, \
+            (int)segment_tile \
+        )
+
+    // HS = 256: QL > 1 only for the head groups of the served models (G = 4:
+    // 9B, G = 6: 27B) and their neighbours, and only while the accumulators
+    // fit: R = QL * G <= 24 rows. HS = 512 (Gemma 4 global layers: G = 8 per
+    // TP rank, 2 and 4 for neighbours) is QL = 1 only: speculation is not
+    // served there, and the instantiations with QL > 1 cost compile time and,
+    // at G = 2, QL = 4, a 24-byte spill.
+    // int4_decode_attn.py mirrors these sets in _hip_supports and hands
+    // anything else to Triton.
+    #define LAUNCH_G(QL_VAL) \
+        switch (num_queries_per_kv) { \
+            case 1: LAUNCH_KERNEL(256, 1, QL_VAL); break; \
+            case 2: LAUNCH_KERNEL(256, 2, QL_VAL); break; \
+            case 4: LAUNCH_KERNEL(256, 4, QL_VAL); break; \
+            case 6: LAUNCH_KERNEL(256, 6, QL_VAL); break; \
+            case 8: \
+                if constexpr (8 * QL_VAL <= 24) { LAUNCH_KERNEL(256, 8, QL_VAL); } \
+                else { TORCH_CHECK(false, "Unsupported num_queries_per_kv/max_query_len: ", num_queries_per_kv, "/", max_query_len); } \
+                break; \
+            default: \
+                TORCH_CHECK(false, "Unsupported num_queries_per_kv/max_query_len: ", num_queries_per_kv, "/", max_query_len); \
+        }
+
+    if (head_size == 512) {
+        TORCH_CHECK(max_query_len == 1, "max_query_len must be 1 for head_size 512, got ", max_query_len);
+        switch (num_queries_per_kv) {
+            case 2: LAUNCH_KERNEL(512, 2, 1); break;
+            case 4: LAUNCH_KERNEL(512, 4, 1); break;
+            case 8: LAUNCH_KERNEL(512, 8, 1); break;
+            default:
+                TORCH_CHECK(false, "Unsupported num_queries_per_kv for head_size 512: ", num_queries_per_kv);
+        }
+    } else {
+        switch (max_query_len) {
+            case 1:
+                switch (num_queries_per_kv) {
+                    case 1: LAUNCH_KERNEL(256, 1, 1); break;
+                    case 2: LAUNCH_KERNEL(256, 2, 1); break;
+                    case 3: LAUNCH_KERNEL(256, 3, 1); break;
+                    case 4: LAUNCH_KERNEL(256, 4, 1); break;
+                    case 5: LAUNCH_KERNEL(256, 5, 1); break;
+                    case 6: LAUNCH_KERNEL(256, 6, 1); break;
+                    case 7: LAUNCH_KERNEL(256, 7, 1); break;
+                    case 8: LAUNCH_KERNEL(256, 8, 1); break;
+                    default:
+                        TORCH_CHECK(false, "Unsupported num_queries_per_kv: ", num_queries_per_kv);
+                }
+                break;
+            case 2: LAUNCH_G(2); break;
+            case 3: LAUNCH_G(3); break;
+            case 4: LAUNCH_G(4); break;
+        }
+    }
+    #undef LAUNCH_G
+    #undef LAUNCH_KERNEL
+    const hipError_t launch_err = hipGetLastError();
+    TORCH_CHECK(launch_err == hipSuccess, "int4_decode_attn launch failed: ",
+                hipGetErrorString(launch_err));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    // sliding_window (keys visible per query, 0 = off) and segment_tile are
+    // trailing and optional, so callers written for the 21-argument form keep
+    // working.
+    m.def("int4_decode_attn", &int4_decode_attn, "HIP kernel for int4 KV decode attention",
+          py::arg("segm_output"), py::arg("segm_max"), py::arg("segm_expsum"),
+          py::arg("q_i8"), py::arg("q_scale"), py::arg("k_cache"), py::arg("v_cache"),
+          py::arg("k_scale_cache"), py::arg("v_scale_cache"), py::arg("block_table"),
+          py::arg("seqused_k"), py::arg("cu_seqlens_q"), py::arg("softmax_scale"),
+          py::arg("num_seqs"), py::arg("num_query_heads"), py::arg("num_kv_heads"),
+          py::arg("num_queries_per_kv"), py::arg("head_size"), py::arg("block_size"),
+          py::arg("num_segments"), py::arg("max_query_len"), py::arg("sliding_window") = 0,
+          py::arg("segment_tile") = 16);
+}
diff --git a/vllm/v1/attention/ops/int4_decode_attn.py b/vllm/v1/attention/ops/int4_decode_attn.py
new file mode 100644
index 0000000000000000000000000000000000000000..08dce1becfa137a389afeef9bb1c5e9c72dded25
--- /dev/null
+++ b/vllm/v1/attention/ops/int4_decode_attn.py
@@ -0,0 +1,301 @@
+"""HIP ядро декоду уваги з int4-KV для AMD RDNA2 (gfx1030).
+
+Розширення компілюється при першому виклику через load_rdna_ext
+за зразком w4a4_ext, результат кешується.
+"""
+
+import os
+from functools import lru_cache
+from typing import Any, Optional, Tuple
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger("vllm.int4_decode_attn")
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+@lru_cache(maxsize=1)
+def int4_decode_attn_ext() -> Optional[Any]:
+    """Зібрати (за потреби) і повернути розширення HIP; None, якщо не вдалося."""
+    try:
+        from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+        # Ім'я з хешем вмісту, прапорців і теки: каталог збірки torch
+        # спільний для всіх робочих дерев форку, і однойменне розширення з
+        # іншого дерева перезбиралося б у той самий .so — поверх бібліотеки,
+        # яку вже тримає відображеною запущений сервер.
+        ext = load_rdna_ext(
+            "vllm_int4_decode_attn_rdna",
+            os.path.join(_DIR, "int4_decode_attn.hip"),
+            ["-O3", "--offload-arch=gfx1030"],
+        )
+        logger.info("HIP розширення int4_decode_attn зібрано й завантажено")
+        return ext
+    except Exception as e:
+        # Невдачу кешує lru_cache: повторна збірка на кожному кроці декоду
+        # дорожча за відступ на Triton до перезапуску, тож кажемо про це голосно.
+        logger.error("int4_decode_attn недоступний, до перезапуску процесу "
+                     "декод іде ядром Triton: %s", e)
+        return None
+
+
+def _sliding_window(window_size: Optional[Tuple[int, int]]) -> int:
+    """Скільки ключів бачить запит (0 — без вікна), як SLIDING_WINDOW у Triton."""
+    if window_size is None or window_size[0] < 0:
+        return 0
+    return 1 + window_size[0]
+
+
+def _hip_supports(num_queries_per_kv: int, max_seqlen_q: int, head_size: int) -> bool:
+    """Ті самі поєднання, що й диспетчер у int4_decode_attn.hip."""
+    if head_size == 512:
+        return num_queries_per_kv in (2, 4, 8) and max_seqlen_q == 1
+    if max_seqlen_q == 1:
+        return 1 <= num_queries_per_kv <= 8
+    if not 2 <= max_seqlen_q <= 4:
+        return False
+    return (num_queries_per_kv in (1, 2, 4, 6, 8)
+            and num_queries_per_kv * max_seqlen_q <= 24)
+
+
+def _unsupported_reason(
+    *,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    max_seqlen_q: int,
+    seqused_k: torch.Tensor,
+    window_size: Tuple[int, int],
+    block_table: torch.Tensor,
+    softcap: Optional[float],
+    sinks: Optional[torch.Tensor],
+    alibi_slopes: Optional[torch.Tensor],
+    qq_bias: Optional[torch.Tensor],
+    output_scale: Optional[float],
+    mm_prefix_range: Optional[torch.Tensor],
+    k_scale_cache: torch.Tensor,
+    v_scale_cache: torch.Tensor,
+    num_par_softmax_segments: int,
+    softmax_segm_output: Optional[torch.Tensor],
+    softmax_segm_max: Optional[torch.Tensor],
+    softmax_segm_expsum: Optional[torch.Tensor],
+    packing_factor: int,
+    q_i8: Optional[torch.Tensor],
+    q_scale: Optional[torch.Tensor],
+    w4a8: bool,
+    num_query_heads: int,
+    num_queries_per_kv: int,
+    head_size: int,
+    block_size: int,
+    num_seqs: int,
+    tile_size: int,
+) -> Optional[str]:
+    """Причина, з якої вхід не підходить ядру, або None.
+
+    Обмеження — зі специфікації (work/reports/e3-decode-kernel-spec.md) і з
+    того, як ядро адресує пам'ять; типи перевіряє й обгортка C++, тут — щоб
+    відступити на Triton, а не впасти.
+    """
+    if head_size not in (256, 512):
+        return f"head_size={head_size}"
+    if not _hip_supports(num_queries_per_kv, max_seqlen_q, head_size):
+        return f"head_size={head_size}, G={num_queries_per_kv}, qlen={max_seqlen_q}"
+    # Межі сегментів ядро рахує в тайлах по tile_size токенів — так само, як
+    # reduce_segments із TILE_SIZE_DECODE (16; 32 у ковзних шарів Gemma).
+    if tile_size not in (16, 32):
+        return f"tile_size={tile_size}"
+    if _sliding_window(window_size) > 2**31 - 1:
+        return "ковзне вікно не вміщується в int32"
+    if alibi_slopes is not None:
+        return "alibi"
+    if softcap is not None and softcap > 0:
+        return "softcap"
+    if sinks is not None:
+        return "sinks"
+    if qq_bias is not None:
+        return "qq_bias"
+    if mm_prefix_range is not None:
+        return "мультимодальний префікс"
+    if not w4a8 or q_i8 is None or q_scale is None:
+        return "без W4A8"
+    if output_scale is not None:
+        return "fp8-вихід"
+    if packing_factor != 2:
+        return f"packing_factor={packing_factor}"
+    if k_cache.dtype != torch.uint8 or v_cache.dtype != torch.uint8:
+        return "тип кеша KV"
+    if q_i8.dtype != torch.int8 or q_scale.dtype != torch.float32:
+        return "тип q_i8/q_scale"
+    if k_scale_cache.dtype != torch.float32 or v_scale_cache.dtype != torch.float32:
+        return "тип масштабів KV"
+    for name, t in (("block_table", block_table), ("seqused_k", seqused_k),
+                    ("cu_seqlens_q", cu_seqlens_q)):
+        if t.dtype != torch.int32:
+            return f"{name} не int32"
+    # Рядок таблиці блоків ядро читає підряд від block_table + seq * stride(0).
+    if block_table.dim() != 2 or (block_table.size(1) > 1 and block_table.stride(1) != 1):
+        return "block_table не суцільна за рядком"
+    if seqused_k.stride(0) != 1 or cu_seqlens_q.stride(0) != 1:
+        return "seqused_k/cu_seqlens_q не суцільні"
+    # Ядро індексує їх за seq_idx < num_seqs (і cu_seqlens_q[seq_idx + 1]).
+    if (block_table.size(0) < num_seqs or seqused_k.numel() < num_seqs
+            or cu_seqlens_q.numel() < num_seqs + 1):
+        return "метадані коротші за num_seqs"
+    # q_i8 ядро читає побайтно від q_ptr, 8 сусідніх вимірів на доріжку.
+    if q_i8.dim() != 3 or q_i8.stride(2) != 1:
+        return "q_i8 не суцільний за виміром голови"
+    if q_i8.size(0) < q.size(0) or q_i8.size(1) < num_query_heads or q_i8.size(2) < head_size:
+        return "q_i8 менший за q"
+    # q_scale ядро читає за stride_0/stride_1 для кожного (токен, голова).
+    if q_scale.dim() != 2 or q_scale.size(0) < q.size(0) or q_scale.size(1) < num_query_heads:
+        return "q_scale менший за q"
+    if k_cache.stride(3) != 1 or v_cache.stride(3) != 1:
+        return "кеш KV не суцільний за внутрішнім виміром"
+    # тайл ядра — 32 токени, початок кратний 16: охоплює щонайбільше два
+    # блоки кеша, якщо блок 16 або не менший за 32
+    if block_size != 16 and block_size < 32:
+        return f"block_size={block_size}"
+    # рядки K і V ядро читає словами по 4 байти
+    for t in (k_cache, v_cache):
+        if t.data_ptr() % 4 or any(s % 4 for s in t.stride()[:3]):
+            return "кеш KV не вирівняний на 4 байти"
+    if softmax_segm_output is None or softmax_segm_max is None or softmax_segm_expsum is None:
+        return "немає буферів сегментів"
+    # Буфери сегментів ядро бачить щільними — так само, як _attn_packed і
+    # reduce_segments (див. _dense_segm_views); меж воно не перевіряє.
+    rows = q.size(0) * num_query_heads * num_par_softmax_segments
+    for name, t, per in (("segm_max", softmax_segm_max, 1),
