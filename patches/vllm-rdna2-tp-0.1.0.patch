+    const int token_idx = cu_seqlens_q[seq_idx];
+    const int q_len = cu_seqlens_q[seq_idx + 1] - token_idx;
+    const int q_start = (blk - (token_idx / QB + seq_idx)) * QB;
+    if (q_start >= q_len) return;
+
+    const int seq_len = seqused_k[seq_idx];
+    const int context_len = seq_len - q_len;
+
+    // This wave owns rows [row0, row0 + RW). Its query tokens, and so its key
+    // range, are known up front: it never looks at keys past its last token.
+    const int row0 = wave * RW;
+    const int tok_a = q_start + row0 / G;
+    if (tok_a >= q_len) return;
+    const int tok_b = min(q_start + (row0 + RW - 1) / G, q_len - 1);
+    const int key_hi = context_len + tok_b + 1;
+
+    // Window of W keys: row at position p sees key t when 0 <= p - t < W
+    // (one unsigned compare, a negative distance wraps above W). The first
+    // tile is the one holding the oldest key of the first row, kept on the
+    // 16-key grid: a group of 16 keys then lies within one cache block.
+    const int win = sliding_window > 0 ? sliding_window : 0x7fffffff;
+    const int tile_lo = sliding_window > 0 ? (max(context_len + tok_a - win + 1, 0) & ~15) : 0;
+
+    // Per-row constants, uniform over the wave: moved to scalar registers, a
+    // VGPR copy of each would cost eight registers per constant at RW = 8.
+    // A row without a token (past the end of the sequence) gets the position
+    // 0xFFFFFFFF, for which no key is ever visible.
+    uint32_t row_pos[RW];
+    float row_scale[RW], row_qsum[RW];
+    #pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        const int qi = q_start + (row0 + i) / G;
+        const int q_head = kv_head_idx * G + (row0 + i) % G;
+        const bool ok = qi < q_len;
+        int part = 0;
+        #pragma unroll
+        for (int h = 0; h < NC; ++h) {
+            int q4[2] = {0, 0};
+            if (ok) {
+                const int8_t* q_ptr = q_i8 + (int64_t)(token_idx + qi) * q_i8_stride_0 + (int64_t)q_head * q_i8_stride_1 + 8 * (lane + 32 * h);
+                int8_t q[8];
+                #pragma unroll
+                for (int c = 0; c < 8; ++c) q[c] = q_ptr[c];
+                q4[0] = (uint8_t)q[0] | ((uint8_t)q[2] << 8) | ((uint8_t)q[4] << 16) | ((uint32_t)(uint8_t)q[6] << 24);
+                q4[1] = (uint8_t)q[1] | ((uint8_t)q[3] << 8) | ((uint8_t)q[5] << 16) | ((uint32_t)(uint8_t)q[7] << 24);
+                #pragma unroll
+                for (int c = 0; c < 8; ++c) part += q[c];
+            }
+            s_q[wave][i][lane + 32 * h] = q4[0];
+            s_q[wave][i][NJ + lane + 32 * h] = q4[1];
+        }
+        #pragma unroll
+        for (int mask = 16; mask > 0; mask >>= 1) part += __shfl_xor(part, mask, 32);
+        const float scale_row = ok
+            ? softmax_scale * q_scale[(int64_t)(token_idx + qi) * q_scale_stride_0 + (int64_t)q_head * q_scale_stride_1]
+            : 0.0f;
+        row_pos[i] = __builtin_amdgcn_readfirstlane(ok ? (uint32_t)(context_len + qi) : 0xFFFFFFFFu);
+        row_qsum[i] = __builtin_bit_cast(float, __builtin_amdgcn_readfirstlane(__builtin_bit_cast(int, (float)part)));
+        row_scale[i] = __builtin_bit_cast(float, __builtin_amdgcn_readfirstlane(__builtin_bit_cast(int, scale_row)));
+    }
+    // Wave-local: LDS operations of one wave execute in order, only the
+    // compiler must not reorder them.
+    asm volatile("s_waitcnt lgkmcnt(0)" ::: "memory");
+
+    float acc[RW][8 * NC];
+    float M[RW], L_part[RW], zp_part[RW];
+    #pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        #pragma unroll
+        for (int c = 0; c < 8 * NC; ++c) acc[i][c] = 0.0f;
+        M[i] = -CUDART_INF_F;
+        L_part[i] = lane == 0 ? 1.0f : 0.0f;
+        zp_part[i] = 0.0f;
+    }
+
+    const int32_t* seq_bt = block_table + (int64_t)seq_idx * block_table_stride;
+    // Last 16-key group that holds a key; later groups of the tile re-read it.
+    const int last_group = (key_hi - 1) & ~15;
+
+    for (int tok0 = tile_lo; tok0 < key_hi; tok0 += TILE) {
+        // Cache block and in-block slot of every 16-key group of the tile
+        // (tok0 is a multiple of 16 and block_size a multiple of 16, so a
+        // group never straddles two blocks). Groups wholly past the last key
+        // borrow the last group: their loads stay in bounds, and their
+        // weights are zero.
+        int64_t grp_phys[NG];
+        int grp_slot[NG];
+        #pragma unroll
+        for (int g = 0; g < NG; ++g) {
+            const int pos = min(tok0 + 16 * g, last_group);
+            const int bl = pos / block_size;
+            grp_phys[g] = seq_bt[bl];
+            grp_slot[g] = pos - bl * block_size;
+        }
+
+        // Q.K: lane = key, TPL keys per lane (lane + 32 u). A key past the
+        // last one reads valid memory (see above) and is masked below.
+        float k_zp[TPL], k_scale[TPL], v_zp[TPL], v_scale[TPL];
+        const uint32_t* kp[TPL];
+        bool valid[TPL];
+        #pragma unroll
+        for (int u = 0; u < TPL; ++u) {
+            valid[u] = tok0 + lane + 32 * u < key_hi;
+            const int64_t phys = lane < 16 ? grp_phys[2 * u] : grp_phys[2 * u + 1];
+            const int64_t slot = (lane < 16 ? grp_slot[2 * u] : grp_slot[2 * u + 1]) + (lane & 15);
+            kp[u] = (const uint32_t*)(k_cache + phys * stride_k_cache_0 + slot * stride_k_cache_1 + kv_head_idx * stride_k_cache_2);
+            const uint32_t ks = *(const uint32_t*)(k_scale_cache + phys * stride_ks_blk + slot * stride_ks_slot + kv_head_idx * stride_ks_head);
+            const uint32_t vs = *(const uint32_t*)(v_scale_cache + phys * stride_vs_blk + slot * stride_vs_slot + kv_head_idx * stride_vs_head);
+            k_zp[u] = (float)(ks & 0xFu);
+            k_scale[u] = scale_bits(ks);
+            v_zp[u] = valid[u] ? (float)(vs & 0xFu) : 0.0f;
+            v_scale[u] = valid[u] ? scale_bits(vs) : 0.0f;
+        }
+
+        // The K rows go through registers in chunks of 16 dwords: all rows of
+        // the wave take their share of a chunk before the next one is loaded.
+        int dots[RW][TPL];
+        #pragma unroll
+        for (int i = 0; i < RW; ++i) {
+            #pragma unroll
+            for (int u = 0; u < TPL; ++u) dots[i][u] = 0;
+        }
+        #pragma unroll 1
+        for (int jc = 0; jc < NJ; jc += 16) {
+            uint32_t kk[TPL][16];
+            #pragma unroll
+            for (int u = 0; u < TPL; ++u) {
+                #pragma unroll
+                for (int jj = 0; jj < 16; jj += 4) {
+                    const u32x4_t w = *(const u32x4_t*)(kp[u] + jc + jj);
+                    kk[u][jj] = w[0]; kk[u][jj + 1] = w[1]; kk[u][jj + 2] = w[2]; kk[u][jj + 3] = w[3];
+                }
+            }
+            #pragma unroll
+            for (int i = 0; i < RW; ++i) {
+                #pragma unroll
+                for (int jj = 0; jj < 16; ++jj) {
+                    const int q_even = s_q[wave][i][jc + jj];
+                    const int q_odd = s_q[wave][i][NJ + jc + jj];
+                    #pragma unroll
+                    for (int u = 0; u < TPL; ++u) {
+                        dots[i][u] = __builtin_amdgcn_sdot4(q_even, (int)(kk[u][jj] & 0x0F0F0F0Fu), dots[i][u], false);
+                        dots[i][u] = __builtin_amdgcn_sdot4(q_odd, (int)((kk[u][jj] >> 4) & 0x0F0F0F0Fu), dots[i][u], false);
+                    }
+                }
+            }
+        }
+
+        #pragma unroll
+        for (int i = 0; i < RW; ++i) {
+            float sc[TPL];
+            float s_max = -CUDART_INF_F;
+            #pragma unroll
+            for (int u = 0; u < TPL; ++u) {
+                const bool visible = valid[u] && row_pos[i] - (uint32_t)(tok0 + lane + 32 * u) < (uint32_t)win;
+                sc[u] = visible
+                    ? ((float)dots[i][u] - row_qsum[i] * k_zp[u]) * (row_scale[i] * k_scale[u])
+                    : -CUDART_INF_F;
+                s_max = fmaxf(s_max, sc[u]);
+            }
+
+            const float m_new = fmaxf(M[i], wave_max(s_max));
+            float al = 1.0f;
+            float p[TPL];
+            #pragma unroll
+            for (int u = 0; u < TPL; ++u) p[u] = 0.0f;
+            if (m_new > -1e30f) {
+                // Otherwise nothing of this tile is visible to the row yet
+                // (the tile lies past its causal limit, or before its
+                // window): keep M = -inf, as the decode kernel does for QL > 1.
+                al = (M[i] <= -1e30f) ? 0.0f : __builtin_amdgcn_exp2f((M[i] - m_new) * 1.4426950408889634f);
+                #pragma unroll
+                for (int u = 0; u < TPL; ++u) p[u] = (sc[u] <= -1e30f) ? 0.0f : __builtin_amdgcn_exp2f((sc[u] - m_new) * 1.4426950408889634f);
+                M[i] = m_new;
+            }
+
+            float p_sum = 0.0f, zp_sum = 0.0f;
+            #pragma unroll
+            for (int u = 0; u < TPL; ++u) {
+                const float pv_f32 = p[u] * v_scale[u];
+                p_sum += p[u];
+                zp_sum += pv_f32 * v_zp[u];
+                // Triton feeds P.V in fp16: round the weight the same way.
+                // Through a half pointer on purpose (see the decode kernel: a
+                // half2 element store was lowered to a dword read-modify-write).
+                ((_Float16*)&s_pv[wave][0][0])[(((32 * u + lane) >> 1) * RW + i) * 2 + (lane & 1)] = (_Float16)pv_f32;
+            }
+            L_part[i] = L_part[i] * al + p_sum;
+            zp_part[i] = zp_part[i] * al + zp_sum;
+            #pragma unroll
+            for (int c = 0; c < 8 * NC; ++c) acc[i][c] *= al;
+        }
+        asm volatile("s_waitcnt lgkmcnt(0)" ::: "memory");
+
+        // P.V: lane = 8 output dims of each 256-dim chunk; keys are uniform
+        // over the wave, so the block lookup is scalar.
+        #pragma unroll
+        for (int h = 0; h < NC; ++h) {
+            // Sixteen keys at a time: all of them at once would hold their
+            // registers next to the accumulators.
+            #pragma unroll
+            for (int g = 0; g < NG; ++g) {
+                if (tok0 + 16 * g >= key_hi) break;
+                const uint8_t* v_g = v_cache + grp_phys[g] * stride_v_cache_0 + kv_head_idx * stride_v_cache_2
+                    + (int64_t)grp_slot[g] * stride_v_cache_1 + (int64_t)(4 * (lane + 32 * h));
+                uint32_t vbuf[16];
+                #pragma unroll
+                for (int t = 0; t < 16; ++t) vbuf[t] = *(const uint32_t*)(v_g + (int64_t)t * stride_v_cache_1);
+                #pragma unroll
+                for (int t = 0; t < 16; t += 2) {
+                    // v[c] = (nibble c of key t, nibble c of key t + 1) as
+                    // half2: the nibble is OR-ed into the mantissa of 1024.0
+                    // (0x6400), which represents 1024 + n exactly, and 1024 is
+                    // then subtracted.
+                    half2_t v[8];
+                    #pragma unroll
+                    for (int k = 0; k < 4; ++k) {
+                        const uint32_t pk = __builtin_amdgcn_perm(vbuf[t + 1], vbuf[t], 0x0c040c00u + 0x00010001u * k);
+                        const uint32_t lo_n = (pk & 0x000F000Fu) | 0x64006400u;
+                        const uint32_t hi_n = ((pk >> 4) & 0x000F000Fu) | 0x64006400u;
+                        v[2 * k] = __builtin_bit_cast(half2_t, lo_n) - (half2_t){(_Float16)1024.0f, (_Float16)1024.0f};
+                        v[2 * k + 1] = __builtin_bit_cast(half2_t, hi_n) - (half2_t){(_Float16)1024.0f, (_Float16)1024.0f};
+                    }
+                    #pragma unroll
+                    for (int i = 0; i < RW; ++i) {
+                        const half2_t pv = s_pv[wave][(16 * g + t) >> 1][i];
+                        #pragma unroll
+                        for (int c = 0; c < 8; ++c) acc[i][8 * h + c] = __builtin_amdgcn_fdot2(pv, v[c], acc[i][8 * h + c], false);
+                    }
+                }
+            }
+        }
+        // The next tile overwrites s_pv.
+        asm volatile("s_waitcnt lgkmcnt(0)" ::: "memory");
+    }
+
+    #pragma unroll
+    for (int i = 0; i < RW; ++i) {
+        const int qi = q_start + (row0 + i) / G;
+        if (qi >= q_len) continue;
+        const int q_head = kv_head_idx * G + (row0 + i) % G;
+        const float L = wave_sum(L_part[i]);
+        const float zp_acc = wave_sum(zp_part[i]);
+        _Float16* o = out + (int64_t)(token_idx + qi) * out_stride_0 + (int64_t)q_head * out_stride_1;
+        #pragma unroll
+        for (int h = 0; h < NC; ++h) {
+            half8_t v8;
+            #pragma unroll
+            for (int c = 0; c < 8; ++c) v8[c] = (_Float16)((acc[i][8 * h + c] - zp_acc) / L);
+            *(half8_t*)(o + 256 * h + 8 * lane) = v8;
+        }
+    }
+}
+
+void int4_prefill_attn(
+    torch::Tensor out,
+    torch::Tensor q_i8,
+    torch::Tensor q_scale,
+    torch::Tensor k_cache,
+    torch::Tensor v_cache,
+    torch::Tensor k_scale_cache,
+    torch::Tensor v_scale_cache,
+    torch::Tensor block_table,
+    torch::Tensor seqused_k,
+    torch::Tensor cu_seqlens_q,
+    double softmax_scale,
+    int64_t num_seqs,
+    int64_t num_query_heads,
+    int64_t num_kv_heads,
+    int64_t num_queries_per_kv,
+    int64_t head_size,
+    int64_t block_size,
+    int64_t sliding_window
+) {
+    if (num_seqs <= 0 || num_kv_heads <= 0) return;
+
+    TORCH_CHECK(head_size == 256 || head_size == 512, "head_size must be 256 or 512");
+    TORCH_CHECK(sliding_window >= 0 && sliding_window <= INT32_MAX, "sliding_window must be in 0..INT32_MAX (0 = off)");
+    TORCH_CHECK(block_size % 16 == 0, "block_size must be a multiple of 16");
+    TORCH_CHECK(out.dtype() == torch::kFloat16, "out must be float16");
+    TORCH_CHECK(q_i8.dtype() == torch::kInt8, "q_i8 must be int8");
+    TORCH_CHECK(k_cache.dtype() == torch::kUInt8 && v_cache.dtype() == torch::kUInt8,
+                "k_cache and v_cache must be uint8");
+    for (const auto* t : {&q_scale, &k_scale_cache, &v_scale_cache}) {
+        TORCH_CHECK(t->dtype() == torch::kFloat32, "scales must be float32");
+    }
+    TORCH_CHECK(block_table.dtype() == torch::kInt32, "block_table must be int32");
+    TORCH_CHECK(seqused_k.dtype() == torch::kInt32, "seqused_k must be int32");
+    TORCH_CHECK(cu_seqlens_q.dtype() == torch::kInt32, "cu_seqlens_q must be int32");
+
+    const int64_t num_tokens = q_i8.size(0);
+    hipStream_t stream = at::hip::getCurrentHIPStream();
+
+    // Query blocks are allotted as num_tokens / QB + num_seqs, the bound
+    // Triton's launch uses: a sequence never needs more than its share.
+    #define LAUNCH_KERNEL(HS_VAL, G_VAL, RW_VAL, NW_VAL, TPL_VAL) { \
+        constexpr int QB_ = (RW_VAL) * (NW_VAL) / (G_VAL); \
+        dim3 grid((unsigned)(num_tokens / QB_ + num_seqs), (unsigned)num_kv_heads, 1); \
+        int4_prefill_attn_kernel<HS_VAL, G_VAL, RW_VAL, NW_VAL, TPL_VAL><<<grid, dim3(32 * (NW_VAL), 1, 1), 0, stream>>>( \
+            reinterpret_cast<_Float16*>(out.data_ptr<at::Half>()), \
+            q_i8.data_ptr<int8_t>(), \
+            q_scale.data_ptr<float>(), \
+            k_cache.data_ptr<uint8_t>(), \
+            v_cache.data_ptr<uint8_t>(), \
+            k_scale_cache.data_ptr<float>(), \
+            v_scale_cache.data_ptr<float>(), \
+            block_table.data_ptr<int32_t>(), \
+            seqused_k.data_ptr<int32_t>(), \
+            cu_seqlens_q.data_ptr<int32_t>(), \
+            (float)softmax_scale, \
+            (int)num_seqs, \
+            block_table.stride(0), \
+            out.stride(0), \
+            out.stride(1), \
+            q_i8.stride(0), \
+            q_i8.stride(1), \
+            q_scale.stride(0), \
+            q_scale.stride(1), \
+            k_cache.stride(0), \
+            k_cache.stride(1), \
+            k_cache.stride(2), \
+            v_cache.stride(0), \
+            v_cache.stride(1), \
+            v_cache.stride(2), \
+            k_scale_cache.stride(0), \
+            k_scale_cache.stride(1), \
+            k_scale_cache.stride(2), \
+            v_scale_cache.stride(0), \
+            v_scale_cache.stride(1), \
+            v_scale_cache.stride(2), \
+            (int)block_size, \
+            (int)sliding_window); \
+    }
+
+    // (rows per wave, waves per workgroup, keys per lane per tile), measured on
+    // card 2 (work/reports/2026-10-03-gemma-prefill-attn.md): head 512 takes
+    // 8 rows x 4 waves x 1 key (at 2 keys per lane the accumulators spill),
+    // head 256 takes 6 x 4 x 2.
+    if (head_size == 512) {
+        switch (num_queries_per_kv) {
+            case 2: LAUNCH_KERNEL(512, 2, 8, 4, 1); break;
+            case 4: LAUNCH_KERNEL(512, 4, 8, 4, 1); break;
+            case 8: LAUNCH_KERNEL(512, 8, 8, 4, 1); break;
+            default:
+                TORCH_CHECK(false, "Unsupported num_queries_per_kv for head_size 512: ", num_queries_per_kv);
+        }
+    } else {
+        switch (num_queries_per_kv) {
+            case 1: LAUNCH_KERNEL(256, 1, 6, 4, 2); break;
+            case 2: LAUNCH_KERNEL(256, 2, 6, 4, 2); break;
+            case 4: LAUNCH_KERNEL(256, 4, 6, 4, 2); break;
+            case 8: LAUNCH_KERNEL(256, 8, 6, 4, 2); break;
+            default:
+                TORCH_CHECK(false, "Unsupported num_queries_per_kv for head_size 256: ", num_queries_per_kv);
+        }
+    }
+    #undef LAUNCH_KERNEL
+    const hipError_t launch_err = hipGetLastError();
+    TORCH_CHECK(launch_err == hipSuccess, "int4_prefill_attn launch failed: ",
+                hipGetErrorString(launch_err));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("int4_prefill_attn", &int4_prefill_attn, "HIP kernel for int4 KV prefill attention",
+          py::arg("out"), py::arg("q_i8"), py::arg("q_scale"), py::arg("k_cache"), py::arg("v_cache"),
+          py::arg("k_scale_cache"), py::arg("v_scale_cache"), py::arg("block_table"),
+          py::arg("seqused_k"), py::arg("cu_seqlens_q"), py::arg("softmax_scale"),
+          py::arg("num_seqs"), py::arg("num_query_heads"), py::arg("num_kv_heads"),
+          py::arg("num_queries_per_kv"), py::arg("head_size"), py::arg("block_size"),
+          py::arg("sliding_window") = 0);
+}
