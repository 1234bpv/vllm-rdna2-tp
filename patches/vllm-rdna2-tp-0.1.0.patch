+    # звичайним множенням fp32.
+    #
+    # Ціна памʼяті — одна смуга: 8192 × 5120 × 4 Б = 160 МіБ, замість повної
+    # копії ваги у fp32 (2,4 ГіБ на ранг).
+    "VLLM_ROCM_HEAD_CHUNK": lambda: int(
+        os.getenv("VLLM_ROCM_HEAD_CHUNK", "0")
