+++ b/vllm/v1/sample/logits_processor/probe_hooks.py
@@ -0,0 +1,347 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Зачепи для збереження проміжних величин моделі у робочих процесах vLLM.
+
+Модуль лежить УСЕРЕДИНІ дерева vLLM свідомо: робочі процеси імпортують
+`vllm`, тож функцію звідси вони знайдуть за іменем без жодних додаткових
+налаштувань шляху пошуку. Ті самі функції, оголошені у скрипті запуску,
+воркерам недосяжні, бо той скрипт для них — просто `__main__`.
+"""
+from __future__ import annotations
+
+import json
+import math
+import re
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+import torch.nn as nn
+
+class ProbeHookManager:
+    """Керує реєстрацією зачепів (hooks) та збереженням тензорів на рангах TP."""
+
+    def __init__(
+        self,
+        output_dir: Path | str,
+        layer_indices: list[int] | None = None,
+        save_all_layers: bool = False,
+        hook_pattern: str | None = None,
+        tp_rank: int = 0,
+        tp_world_size: int = 1,
+    ) -> None:
+        self.output_dir = Path(output_dir)
+        self.tensors_dir = self.output_dir / "tensors"
+        self.layer_indices = set(layer_indices) if layer_indices is not None else {17}
+        self.save_all_layers = save_all_layers
+        self.pattern = re.compile(hook_pattern) if hook_pattern else None
+        self.tp_rank = tp_rank
+        self.tp_world_size = tp_world_size
+
+        self.current_step = 0
+        self.tensor_idx_in_step = 0
+        self.manifest_entries: list[dict[str, Any]] = []
+        self.hook_handles: list[Any] = []
+
+        if self.tp_rank == 0:
+            self.tensors_dir.mkdir(parents=True, exist_ok=True)
+            self.manifest_path = self.output_dir / "tensors_info.txt"
+            with open(self.manifest_path, "w", encoding="utf-8") as f:
+                f.write("# Manifest of saved intermediate tensors\n")
+                f.write(
+                    "# step\tidx\tname\ttype\tshape\tbytes\tmin\tmax\tmean\tl2_norm\tfile\n"
+                )
+
+    def step_forward(self) -> None:
+        """Перехід на наступний крок генерації."""
+        self.current_step += 1
+        self.tensor_idx_in_step = 0
+
+    def reset_step(self, step: int = 0) -> None:
+        self.current_step = step
+        self.tensor_idx_in_step = 0
+
+    def _compute_stats(self, t_f32: torch.Tensor) -> tuple[float, float, float, float]:
+        t_min = float(torch.min(t_f32).item())
+        t_max = float(torch.max(t_f32).item())
+        t_mean = float(torch.mean(t_f32).item())
+        t_norm = float(torch.linalg.vector_norm(t_f32).item())
+        return t_min, t_max, t_mean, t_norm
+
+    def record_tensor(
+        self,
+        tensor: torch.Tensor,
+        name: str,
+        is_sharded: bool = False,
+    ) -> None:
+        """Зберігає тензор у двійковий float32 файл та додає запис у маніфест."""
+        if not isinstance(tensor, torch.Tensor):
+            return
+
+        t_f32 = tensor.detach().to(dtype=torch.float32, device="cpu").contiguous()
+
+        # Форма тензора для запису
+        shape_list = list(t_f32.shape)
+        shape_str = "[" + ",".join(str(s) for s in shape_list) + "]"
+
+        t_min, t_max, t_mean, t_norm = self._compute_stats(t_f32)
+        nbytes = t_f32.numel() * 4
+
+        # Очищення імені для файлової системи
+        clean_name = re.sub(r"[^\w\-_\.]", "_", name)
+        step = self.current_step
+        idx = self.tensor_idx_in_step
+
+        if is_sharded:
+            filename = f"step_{step:04d}_{idx:04d}_{clean_name}_rank{self.tp_rank}.bin"
+        else:
+            filename = f"step_{step:04d}_{idx:04d}_{clean_name}.bin"
+
+        rel_path = f"tensors/{filename}"
+        abs_path = self.tensors_dir / filename
+
+        # Запис у двійковий файл
+        if is_sharded or self.tp_rank == 0:
+            t_np = t_f32.numpy()
+            t_np.tofile(str(abs_path))
+
+        if self.tp_rank == 0:
+            line = (
+                f"{step}\t{idx}\t{name}\tf32\t{shape_str}\t{nbytes}\t"
+                f"{t_min:+.6e}\t{t_max:+.6e}\t{t_mean:+.6e}\t{t_norm:+.6e}\t{rel_path}\n"
+            )
+            with open(self.manifest_path, "a", encoding="utf-8") as f:
+                f.write(line)
+
+            self.manifest_entries.append(
+                {
+                    "step": step,
+                    "idx": idx,
+                    "name": name,
+                    "type": "f32",
+                    "shape": shape_list,
+                    "bytes": nbytes,
+                    "min": t_min,
+                    "max": t_max,
+                    "mean": t_mean,
+                    "l2_norm": t_norm,
+                    "file": rel_path,
+                    "is_sharded": is_sharded,
+                }
+            )
+
+        self.tensor_idx_in_step += 1
+
+    def attach_to_model(self, model: nn.Module) -> None:
+        """Реєструє зачепи на шарах та модулях моделі."""
+        self.detach()
+
+        # Визначаємо внутрішню структуру моделі
+        underlying_model = model
+        if hasattr(model, "model"):
+            underlying_model = model.model
+
+        # Знаходимо список шарів
+        layers = None
+        if hasattr(underlying_model, "layers"):
+            layers = underlying_model.layers
+        elif hasattr(model, "layers"):
+            layers = model.layers
+
+        # Реєструємо зачепи для кожного шару декодера
+        if layers is not None:
+            for l_idx, layer in enumerate(layers):
+                if (
+                    not self.save_all_layers
+                    and l_idx not in self.layer_indices
+                    and not (self.pattern and self.pattern.search(f"layer_{l_idx}"))
+                ):
+                    continue
+
+                self._attach_to_layer(layer, l_idx)
+
+        # Зачіп фінальної нормалізації перед LM Head
+        if hasattr(underlying_model, "norm") and isinstance(
+            underlying_model.norm, nn.Module
+        ):
+
+            def make_final_norm_hook():
+                def hook(module, inp, out):
+                    t = out[0] if isinstance(out, tuple) else out
+                    self.record_tensor(t, "final_norm", is_sharded=False)
+
+                return hook
+
+            h = underlying_model.norm.register_forward_hook(make_final_norm_hook())
+            self.hook_handles.append(h)
+
+    def _attach_to_layer(self, layer: nn.Module, l_idx: int) -> None:
+        """Приєднує зачепи до конкретного шару декодера."""
+
+        # 1. Вхід у шар (pre-hook на шарі)
+        def make_layer_pre_hook(layer_num: int):
+            def hook(module, args):
+                if len(args) > 0 and isinstance(args[0], torch.Tensor):
+                    hidden = args[0]
+                    residual = args[1] if len(args) > 1 else None
+                    if residual is not None and isinstance(residual, torch.Tensor):
+                        full_in = hidden + residual
+                    else:
+                        full_in = hidden
+                    self.record_tensor(full_in, f"norm-{layer_num}", is_sharded=False)
+
+            return hook
+
+        h_pre = layer.register_forward_pre_hook(make_layer_pre_hook(l_idx))
+        self.hook_handles.append(h_pre)
+
+        # 2. Результат вхідної нормалізації (input_layernorm)
+        if hasattr(layer, "input_layernorm") and isinstance(
+            layer.input_layernorm, nn.Module
+        ):
+
+            def make_input_norm_hook(layer_num: int):
+                def hook(module, inp, out):
+                    t = out[0] if isinstance(out, tuple) else out
+                    self.record_tensor(
+                        t, f"attn_norm-{layer_num}", is_sharded=False
+                    )
+
+                return hook
+
+            h = layer.input_layernorm.register_forward_hook(
+                make_input_norm_hook(l_idx)
+            )
+            self.hook_handles.append(h)
+
+        # 3. Результат блоку уваги (linear_attn або self_attn)
+        attn_mod = getattr(layer, "linear_attn", None) or getattr(
+            layer, "self_attn", None
+        )
+        if attn_mod is not None and isinstance(attn_mod, nn.Module):
+
+            def make_attn_hook(layer_num: int):
+                def hook(module, inp, out):
+                    t = out[0] if isinstance(out, tuple) else out
+                    self.record_tensor(
+                        t, f"linear_attn_out-{layer_num}", is_sharded=False
+                    )
+
+                return hook
+
+            h = attn_mod.register_forward_hook(make_attn_hook(l_idx))
+            self.hook_handles.append(h)
+
+        # 4. Результат пост-уважної нормалізації (post_attention_layernorm)
+        if hasattr(layer, "post_attention_layernorm") and isinstance(
+            layer.post_attention_layernorm, nn.Module
+        ):
+
+            def make_post_norm_hook(layer_num: int):
+                def hook(module, inp, out):
