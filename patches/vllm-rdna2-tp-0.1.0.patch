+            # ⚠️ БЕЗ ЦЬОГО ПРАВКА НЕ ДІЄ. Звільнений блок лишається в кеші
+            # алокатора PyTorch, а профілювальник пам'яті vLLM міряє справжню
+            # зайнятість карти й бачить його як зайнятий. 02.09: завантаження
+            # ваг чесно впало з 8,6 до 8,0 ГіБ, але «не-torch» зросла з 1,25
+            # до 3,04, тобто рівно на ті 1,18 ГіБ, які ми відпустили, — і кеш
+            # KV не виріс, а впав із 324 949 до 191 146 токенів.
+            torch.cuda.empty_cache()
+
     def tie_weights(self, embed_tokens: VocabParallelEmbedding):
         """Tie the weights with word embeddings."""
         return self.quant_method.tie_weights(self, embed_tokens)
diff --git a/vllm/model_executor/layers/w8a16_skinny.hip b/vllm/model_executor/layers/w8a16_skinny.hip
new file mode 100644
index 0000000000000000000000000000000000000000..12a0ef5688237f0b54f092dd05c7211d0d106d21
--- /dev/null
+++ b/vllm/model_executor/layers/w8a16_skinny.hip
@@ -0,0 +1,267 @@
+// W8A16 skinny GEMV for decode on RDNA2 (gfx1030, wave32).
+//
+// y[n, m] = sum_k x[n, k] * W[m, k] * scale[m], W int8 [M, K] row-major,
+// x fp16 [N, K], fp32 accumulation, fp16 (or fp32) output, N = 1..5.
+//
+// One block = KW waves, one tile = YT weight rows. Every wave covers a
+// strided set of 512-element K steps (a lane owns 16 consecutive bytes), so
+// the weights are read exactly once; the KW partial sums are added through
+// LDS. Activations are read straight from L1/L2: they are shared by all
+// waves of a CU and are tiny next to the weights.
+//
+// int8 -> fp16 is exact and costs no multiply: (byte ^ 0x80) | 0x6400 is the
+// fp16 number 1024 + w + 128, so one packed subtraction of 1152 yields w.
+
+#include <torch/extension.h>
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <cstdint>
+#include <algorithm>
+
+namespace {
+
+typedef _Float16 f16x2 __attribute__((ext_vector_type(2)));
+typedef unsigned int u32x4 __attribute__((ext_vector_type(4)));
+
+constexpr int kThrds = 32;               // wave32
+constexpr int kChunk = 16;               // K elements per lane per step
+constexpr int kStepK = kThrds * kChunk;  // K elements per wave per step
+constexpr int kMaxN = 5;
+constexpr int kMaxKW = 8;
+
+__device__ __forceinline__ float dot2(uint32_t a, f16x2 b, float c) {
+  return __builtin_amdgcn_fdot2(__builtin_bit_cast(f16x2, a), b, c, false);
+}
+
+#define REDUCE_SUM_DPP_WAVE32(val)                                        \
+  do {                                                                    \
+    val += __builtin_amdgcn_mov_dpp(val, 0x118, 0xf, 0xf, 1);             \
+    val += __builtin_amdgcn_mov_dpp(val, 0x114, 0xf, 0xf, 1);             \
+    val += __builtin_amdgcn_mov_dpp(val, 0x112, 0xf, 0xf, 1);             \
+    val += __builtin_amdgcn_mov_dpp(val, 0x111, 0xf, 0xf, 1);             \
+    val += __shfl_xor(val, 16);                                           \
+  } while (0)
+
+template <int N, int YT, int KW, bool F32>
+__global__ void __launch_bounds__(KW* kThrds) w8_kernel(
+    const int K, const int M, const int8_t* __restrict__ W,
+    const _Float16* __restrict__ A, const float* __restrict__ scale,
+    const _Float16* __restrict__ BIAS, void* C) {
+  const int lane = threadIdx.x;
+  const int wave = threadIdx.y;
+  const int m0 = blockIdx.x * YT;
+
+  const int8_t* wrow[YT];
+#pragma unroll
+  for (int y = 0; y < YT; y++)
+    wrow[y] = W + (size_t)min(m0 + y, M - 1) * K;  // tail rows are discarded
+
+  float sum[N][YT];
+#pragma unroll
+  for (int n = 0; n < N; n++)
+#pragma unroll
+    for (int y = 0; y < YT; y++) sum[n][y] = 0.f;
+
+#pragma unroll 2
+  for (int k1 = wave * kStepK; k1 < K; k1 += KW * kStepK) {
+    const int k = k1 + lane * kChunk;
+    if (k >= K) continue;  // K < 512 or a ragged last step
+    u32x4 q[YT];
+#pragma unroll
+    for (int y = 0; y < YT; y++)
+      q[y] = __builtin_nontemporal_load((const u32x4*)(wrow[y] + k));
+    u32x4 xa[N][2];
+#pragma unroll
+    for (int n = 0; n < N; n++) {
+      xa[n][0] = *(const u32x4*)(A + (size_t)n * K + k);
+      xa[n][1] = *(const u32x4*)(A + (size_t)n * K + k + 8);
+    }
+#pragma unroll
+    for (int y = 0; y < YT; y++) {
+      f16x2 wv[8];
+#pragma unroll
+      for (int j = 0; j < 4; j++) {
+        const uint32_t u = q[y][j] ^ 0x80808080u;
+        // bytes (b0,b1) and (b2,b3) into 16-bit lanes, magic exponent on top
+        const uint32_t lo =
+            __builtin_amdgcn_perm(0u, u, 0x0c010c00u) | 0x64006400u;
+        const uint32_t hi =
+            __builtin_amdgcn_perm(0u, u, 0x0c030c02u) | 0x64006400u;
+        const f16x2 off = {(_Float16)1152.0f, (_Float16)1152.0f};
+        wv[2 * j] = __builtin_bit_cast(f16x2, lo) - off;
+        wv[2 * j + 1] = __builtin_bit_cast(f16x2, hi) - off;
+      }
+#pragma unroll
+      for (int n = 0; n < N; n++) {
+        float p = 0.f;
+#pragma unroll
+        for (int b = 0; b < 4; b++) p = dot2(xa[n][0][b], wv[b], p);
+#pragma unroll
+        for (int b = 0; b < 4; b++) p = dot2(xa[n][1][b], wv[4 + b], p);
+        sum[n][y] += p;
+      }
+    }
+  }
+
+#pragma unroll
+  for (int n = 0; n < N; n++)
+#pragma unroll
+    for (int y = 0; y < YT; y++) REDUCE_SUM_DPP_WAVE32(sum[n][y]);
+
+  // After the DPP reduction the full wave sum sits in the last lane.
+  __shared__ float red[KW][N * YT];
+  if (lane == kThrds - 1) {
+#pragma unroll
+    for (int n = 0; n < N; n++)
+#pragma unroll
+      for (int y = 0; y < YT; y++) red[wave][n * YT + y] = sum[n][y];
+  }
+  // Безумовно: при KW = 1 запис і читання red — різні лінії однієї хвилі.
+  __syncthreads();
+  if (wave == 0 && lane < N * YT) {
+    const int n = lane / YT;
+    const int y = lane - n * YT;
+    const int m = m0 + y;
+    if (m < M) {
+      float v = 0.f;
+#pragma unroll
+      for (int w = 0; w < KW; w++) v += red[w][lane];
+      v *= scale[m];
+      if (BIAS) v += (float)BIAS[m];
+      if (F32)
+        ((float*)C)[(size_t)n * M + m] = v;
+      else
+        ((_Float16*)C)[(size_t)n * M + m] = (_Float16)v;
+    }
+  }
+}
+
+struct Params {
+  int K, M;
+  const int8_t* w;
+  const _Float16* a;
+  const float* scale;
+  const _Float16* bias;
+  void* c;
+  hipStream_t stream;
+  bool f32;
+  int ytile, kw;
+};
+
+template <int N, int Y, int KW, bool F32>
+void launch_one(const Params& p) {
+  w8_kernel<N, Y, KW, F32>
+      <<<dim3((p.M + Y - 1) / Y), dim3(kThrds, KW), 0, p.stream>>>(
+          p.K, p.M, p.w, p.a, p.scale, p.bias, p.c);
+}
+
+template <int N, int Y, int KW>
+bool try_cfg(const Params& p) {
+  if (p.ytile != Y || p.kw != KW) return false;
+  if (p.f32)
+    launch_one<N, Y, KW, true>(p);
+  else
+    launch_one<N, Y, KW, false>(p);
+  return true;
+}
+
+template <int N>
+bool dispatch_n(const Params& p) {
+  return try_cfg<N, 1, 1>(p) || try_cfg<N, 1, 2>(p) || try_cfg<N, 1, 4>(p) ||
+         try_cfg<N, 1, 8>(p) || try_cfg<N, 2, 1>(p) || try_cfg<N, 2, 2>(p) ||
+         try_cfg<N, 2, 4>(p) || try_cfg<N, 2, 8>(p) || try_cfg<N, 4, 1>(p) ||
+         try_cfg<N, 4, 2>(p) || try_cfg<N, 4, 4>(p);
+}
+
+// Measured on RX 6800 (fp16-gemv-bw.py --w8hip, gfx1030, graph, cold cache,
+// 03.10.2026): four waves per row tile are enough for K = 2048 (one 512 step
+// each; eight give the same, two lose 10-30%), YT 1 and 2 are equal, YT 4 is
+// slower. For K < 512 half the lanes idle, so one wave and more rows per wave.
+void auto_cfg(int N, int M, int K, int& y, int& kw) {
+  y = K < kStepK ? 4 : 2;
+  kw = K >= 4 * kStepK ? 4 : (K >= 2 * kStepK ? 2 : 1);
+}
+
+}  // namespace
+
+torch::Tensor w8_gemv(const at::Tensor& w, const at::Tensor& x,
+                      const at::Tensor& scale,
+                      const std::optional<at::Tensor>& bias, bool out_f32,
+                      int64_t ytile, int64_t kw) {
+  TORCH_CHECK(w.is_cuda() && x.is_cuda() && scale.is_cuda(),
+              "tensors must be on the GPU");
+  TORCH_CHECK(w.dtype() == torch::kInt8 && w.dim() == 2,
+              "weight must be int8 [M, K]");
+  TORCH_CHECK(x.dtype() == torch::kFloat16 && x.dim() == 2,
+              "x must be fp16 [N, K]");
+  TORCH_CHECK(scale.dtype() == torch::kFloat32 && scale.dim() == 1,
+              "scale must be fp32 [M]");
+  const int64_t M = w.size(0);
+  const int64_t K = w.size(1);
+  const int64_t N = x.size(0);
+  TORCH_CHECK(x.size(1) == K, "x has K=", x.size(1), ", weight has K=", K);
+  TORCH_CHECK(scale.size(0) == M, "scale must have M=", M, " entries");
+  TORCH_CHECK(1 <= N && N <= kMaxN, "N must be 1..", kMaxN, ", got ", N);
+  TORCH_CHECK(M >= 1 && K >= 1, "empty weight");
+  TORCH_CHECK(K % kChunk == 0, "K must be divisible by 16, got ", K);
+  TORCH_CHECK(M * K < (1ll << 40), "weight too large");
+  TORCH_CHECK(w.is_contiguous() && x.is_contiguous() && scale.is_contiguous(),
+              "tensors must be contiguous");
+  TORCH_CHECK(w.device() == x.device() && w.device() == scale.device(),
+              "tensors on different devices");
+  TORCH_CHECK(reinterpret_cast<uintptr_t>(w.data_ptr()) % 16 == 0 &&
+                  reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0,
+              "weight and x must be 16-byte aligned");
+  TORCH_CHECK(reinterpret_cast<uintptr_t>(scale.data_ptr()) % 4 == 0,
+              "scale must be 4-byte aligned");
+  const bool has_bias = bias.has_value() && bias->numel() > 0;
+  if (has_bias) {
+    TORCH_CHECK(bias->dtype() == torch::kFloat16 && bias->dim() == 1 &&
+                    bias->size(0) == M && bias->is_contiguous() &&
+                    bias->device() == x.device(),
+                "bias must be fp16 [M], contiguous, on the device of x");
+  }
+
+  auto out = torch::empty(
+      {N, M}, torch::TensorOptions()
+                  .dtype(out_f32 ? torch::kFloat32 : torch::kFloat16)
+                  .device(x.device()));
+
+  Params p;
+  p.K = K;
+  p.M = M;
+  p.w = reinterpret_cast<const int8_t*>(w.data_ptr());
+  p.a = reinterpret_cast<const _Float16*>(x.data_ptr());
+  p.scale = reinterpret_cast<const float*>(scale.data_ptr());
+  p.bias = has_bias ? reinterpret_cast<const _Float16*>(bias->data_ptr())
+                    : nullptr;
+  p.c = out.data_ptr();
+  p.stream = at::hip::getCurrentHIPStream();
+  p.f32 = out_f32;
+  if (ytile == 0) {
+    auto_cfg((int)N, (int)M, (int)K, p.ytile, p.kw);
+  } else {
+    p.ytile = ytile;
+    p.kw = kw;
+  }
+
+  bool ok = false;
+  switch (N) {
+    case 1: ok = dispatch_n<1>(p); break;
+    case 2: ok = dispatch_n<2>(p); break;
+    case 3: ok = dispatch_n<3>(p); break;
+    case 4: ok = dispatch_n<4>(p); break;
+    case 5: ok = dispatch_n<5>(p); break;
+  }
+  TORCH_CHECK(ok, "no instantiation for N=", N, " ytile=", p.ytile,
+              " kw=", p.kw);
+  const hipError_t err = hipGetLastError();
+  TORCH_CHECK(err == hipSuccess,
+              "w8a16_skinny launch failed: ", hipGetErrorString(err));
+  return out;
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("w8_gemv", &w8_gemv,
+        "W8A16 skinny GEMV, N<=5, weights read once (gfx1030)");
+}
diff --git a/vllm/model_executor/layers/w8a16_skinny.py b/vllm/model_executor/layers/w8a16_skinny.py
new file mode 100644
index 0000000000000000000000000000000000000000..52dd337209764f8c079f6e5d6c491ba9ab43be6d
--- /dev/null
+++ b/vllm/model_executor/layers/w8a16_skinny.py
@@ -0,0 +1,196 @@
+"""W8A16 skinny GEMV для декоду на RDNA2 (gfx1030): ваги int8 + масштаб на рядок.
+
+Ядро `w8a16_skinny.hip` читає вагу int8 [M, K] один раз і множить на fp16-активації
+(n = 1..5 рядків), накопичуючи у fp32. Розширення компілюється при першому виклику
+через load_rdna_ext. Для неквантованих лінійних шарів (VLLM_ROCM_W8A16=1) вага після
+завантаження квантується тут же (`quantize_layer`), а `w8a16_linear` — власна операція,
+у якій і лежить розгалуження за n: apply_weights трасується torch.compile, і форма-залежна
+гілка в трасованому коді застигла б ввімкненою для всіх партій.
+"""
+
+import os
+from functools import lru_cache
+from typing import Any, Optional
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger("vllm.w8a16_skinny")
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+# Скільки рядків бере одне звернення до ядра (стеля шаблонів у .hip).
+KERNEL_MAX_N = 5
+# До цієї кількості рядків ядро викликається шматками по KERNEL_MAX_N: крок
+# перевірки MTP має потоки × 3 рядків, і кілька читань int8 дешевші за
+# деквантизацію всієї ваги у fp16. Понад це — деквантизація і звичайний GEMM.
+SKINNY_MAX_N = 16
+
+
+@lru_cache(maxsize=1)
+def w8a16_ext() -> Any:
+    """Зібрати (за потреби) і повернути розширення HIP; кидає виняток, якщо не вийшло."""
+    from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+
+    ext = load_rdna_ext(
+        "vllm_w8a16_skinny_rdna",
+        os.path.join(_DIR, "w8a16_skinny.hip"),
+        ["-O3", "--offload-arch=gfx1030"],
+    )
+    logger.info("HIP розширення w8a16_skinny зібрано й завантажено")
+    return ext
+
+
+def quantize_w8(w: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Симетричне RTN-квантування ваги [M, K] на рядок: (int8 [M, K], scale fp32 [M]).
+
+    Масштаб amax/127 округлено до fp16 і збережено в fp32: тоді деквантизація
+    префілу (int8 * fp16-масштаб) і ядро (int8 * fp32-масштаб) дають ту саму вагу.
+    Квантуємо скибками, щоб не створювати fp32-копію всієї ваги (див. lm_head).
+    """
+    m = w.shape[0]
+    w_q = torch.empty(w.shape, dtype=torch.int8, device=w.device)
+    scale = torch.empty(m, dtype=torch.float32, device=w.device)
+    step = 16384
+    for i in range(0, m, step):
+        j = min(i + step, m)
+        chunk = w[i:j].to(torch.float32)
+        s = (chunk.abs().amax(dim=1) / 127.0).clamp_min(1e-7).to(torch.float16)
+        s = s.to(torch.float32)
+        w_q[i:j] = torch.clamp(torch.round(chunk / s[:, None]), -127, 127).to(torch.int8)
+        scale[i:j] = s
+        del chunk
+    return w_q, scale
+
+
+def w8a16_gemv(
+    x: torch.Tensor,
+    w_int8: torch.Tensor,
+    scale: torch.Tensor,
+    bias: Optional[torch.Tensor] = None,
+    out_f32: bool = False,
+    ytile: int = 0,
+    kw: int = 0,
+) -> torch.Tensor:
+    """x [n, K] fp16 @ (w_int8 [M, K] * scale [M])^T -> [n, M]; n = 1..5.
+
+    Непідтримані входи ядро відхиляє виняткам (TORCH_CHECK), мовчазного
+    відступу тут немає. ytile/kw = 0 — вибір за формою.
+    """
+    return w8a16_ext().w8_gemv(w_int8, x, scale, bias, out_f32, ytile, kw)
+
+
+def w8a16_gemv_f32(
+    x: torch.Tensor, w_int8: torch.Tensor, scale: torch.Tensor
+) -> torch.Tensor:
+    """Те саме для lm_head: вихід fp32 (без кроку сітки fp16), n = 1..SKINNY_MAX_N."""
+    n = x.shape[0]
+    if not 1 <= n <= SKINNY_MAX_N:
+        raise ValueError(f"w8a16_gemv_f32: n має бути 1..{SKINNY_MAX_N}, отримано {n}")
+    out = torch.empty((n, w_int8.shape[0]), dtype=torch.float32, device=x.device)
+    for i in range(0, n, KERNEL_MAX_N):
+        nn = min(KERNEL_MAX_N, n - i)
+        out[i : i + nn] = w8a16_gemv(x[i : i + nn], w_int8, scale, None, True)
+    return out
+
+
+def w8a16_dequant(
+    w_int8: torch.Tensor, scale: torch.Tensor, dtype: torch.dtype = torch.float16
+) -> torch.Tensor:
+    # Масштаб — через fp16 (так його округлено при квантуванні), далі в тип активацій.
+    return (w_int8.to(torch.float16) * scale.to(torch.float16)[:, None]).to(dtype)
+
+
+def _w8a16_linear_impl(
+    x: torch.Tensor,
+    w_int8: torch.Tensor,
+    scale: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor:
+    k = w_int8.shape[1]
+    m = w_int8.shape[0]
+    x2 = x.reshape(-1, k)
+    n = x2.shape[0]
+    if x2.dtype == torch.float16 and 1 <= n <= SKINNY_MAX_N:
+        x2 = x2.contiguous()
+        if x2.data_ptr() % 16 != 0:
+            # Суцільний зріз зі зсувом: ядро вимагає вирівнювання на 16 байтів.
+            x2 = x2.clone()
+        if n <= KERNEL_MAX_N:
+            out = w8a16_gemv(x2, w_int8, scale, bias)
+        else:
+            out = torch.empty((n, m), dtype=torch.float16, device=x.device)
+            for i in range(0, n, KERNEL_MAX_N):
+                nn = min(KERNEL_MAX_N, n - i)
+                out[i : i + nn] = w8a16_gemv(x2[i : i + nn], w_int8, scale, bias)
+    else:
+        out = torch.nn.functional.linear(
+            x2, w8a16_dequant(w_int8, scale, x2.dtype), bias
+        )
+    return out.reshape(*x.shape[:-1], m)
+
+
+def _w8a16_linear_fake(
+    x: torch.Tensor,
+    w_int8: torch.Tensor,
+    scale: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor:
+    return x.new_empty((*x.shape[:-1], w_int8.shape[0]))
+
+
+direct_register_custom_op(
+    op_name="w8a16_linear",
+    op_func=_w8a16_linear_impl,
+    mutates_args=[],
+    fake_impl=_w8a16_linear_fake,
+)
+
+
+def w8a16_linear(
+    x: torch.Tensor,
+    w_int8: torch.Tensor,
+    scale: torch.Tensor,
+    bias: torch.Tensor | None = None,
+) -> torch.Tensor:
+    return torch.ops.vllm.w8a16_linear(x, w_int8, scale, bias)
+
+
+# Шари, чию вагу не квантуємо: маршрутизатор експертів (RTN у 8 бітів може
+# перекинути top-k; у Gemma 4 це «….router.proj», у Llama 4 — «….router») і зір.
+_SKIP_PREFIX_PARTS = ("visual", "vision", ".router")
+_SKIP_PREFIX_SUFFIXES = (".gate", ".shared_expert_gate")
+
+
+def layer_eligible(layer: torch.nn.Module) -> bool:
+    """Чи квантувати вагу цього неквантованого лінійного шару у W8A16."""
+    w = getattr(layer, "weight", None)
