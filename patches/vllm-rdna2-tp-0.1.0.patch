+"""Злите ядро GDN decode для gfx1030 (RDNA2, wave32).
+
+Розширення збирається на першому виклику (`load_rdna_ext`),
+щоб не перезбирати весь vLLM. Результат кешується.
+"""
+
+import os
+from functools import lru_cache
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger("vllm.gdn_fused")
+
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+@lru_cache(maxsize=1)
+def gdn_fused_ext():
+    """Зібрати (за потреби) і повернути розширення; None, якщо не вдалося."""
+    try:
+        from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+
+        ext = load_rdna_ext(
+            "vllm_gdn_fused_rdna",
+            os.path.join(_DIR, "gdn_fused_ext.hip"),
+            # Джерело одне — gdn_fused_ext.hip. Файл уже написано мовою HIP,
+            # тож hipify його пропускає («skipped, no changes») і збирає як
+            # є. Якщо колись hipify щось у ньому замінить, результат ляже
+            # поруч як gdn_fused_ext_hip.hip — це ЗГЕНЕРОВАНИЙ файл (у
+            # .gitignore), правити треба лише gdn_fused_ext.hip.
+            ["-O3", "--offload-arch=gfx1030"],
+        )
+        logger.info("Розширення GDN Fused зібрано й завантажено")
+        return ext
+    except Exception as e:  # збірка може не вдатися на іншій машині
+        logger.warning("GDN Fused розширення недоступне: %s", e)
+        return None
+
+
+_CALL_COUNT = 0
+_LOGGED = False
+
+
+def get_gdn_fused_ext_calls() -> int:
+    return _CALL_COUNT
+
+
+def fused_gdn_decode_post_conv_mtp(
+    mixed_qkv: torch.Tensor,
+    a: torch.Tensor,
+    b: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    state_indices: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    state: torch.Tensor,
+    output_gate: torch.Tensor,
+    norm_weight: torch.Tensor,
+    out: torch.Tensor | None = None,
+    scale: float = 128**-0.5,
+    norm_eps: float = 1e-5,
+) -> torch.Tensor:
+    """Обгортка над зібраним розширенням fused_gdn_decode_post_conv_mtp.
+
+    Сигнатура ідентична vllm._custom_ops.fused_gdn_decode_post_conv_mtp.
+    """
+    if out is None:
+        out = torch.empty_like(output_gate)
+    ext = gdn_fused_ext()
+    if ext is None:
+        raise RuntimeError("gdn_fused розширення недоступне")
+    global _CALL_COUNT, _LOGGED
+    _CALL_COUNT += 1
+    if not _LOGGED:
+        logger.info("GDN Fused ext: fused_gdn_decode_post_conv_mtp активовано")
+        _LOGGED = True
+    ext.fused_gdn_decode_post_conv_mtp(
+        mixed_qkv,
+        a,
+        b,
+        A_log,
+        dt_bias,
+        state_indices,
+        cu_seqlens,
+        num_accepted_tokens,
+        state,
+        output_gate,
+        norm_weight,
+        out,
+        scale,
+        norm_eps,
+    )
+    return out
