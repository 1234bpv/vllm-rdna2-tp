+def _fake_quant_act(x: torch.Tensor, mode: int, is_row: bool) -> torch.Tensor:
+    """Квантування активацій у 4 біти й негайне розквантування.
+
+    Повторює арифметику `quant_rows` із w4a4_ext.hip: масштаб = max|x|/7,
+    значення = clamp(round(x/масштаб), -8, 7). Режими:
+      1 — масштаб на РЯДОК цілком (як у теперішньому ядрі);
+      2 — масштаб на ГРУПУ зі 128 значень уздовж K (як у ваг), усі шари;
+      3 — на групу, але лише шари, що НЕ RowParallel (qkv, gate_up);
+      4 — на групу, лише RowParallel (down_proj, o_proj);
+      5 — обертання Адамара в межах групи + на групу, усі шари;
+      6 — те саме, але лише шари, що НЕ RowParallel.
+    """
+    if mode == 3 and is_row:
+        return x
+    if mode in (4, 6) and not is_row:
+        return x
+    if mode >= 5:
+        # ── обертання Адамара в межах групи ──
+        # x @ W^T = (x H)(W H)^T для ортогональної H. Якби ми будували це
+        # по-справжньому, вагу теж треба було б обернути й ПЕРЕквантувати —
+        # робота на години. Але питання зараз інше: чи прибирає обертання
+        # саме ту надбавку, яку дало квантування АКТИВАЦІЙ (база 6,656 вже
+        # містить 4-бітні ваги). Тож обертаємо, квантуємо й одразу повертаємо
+        # назад: q(xH)·H^T. Вага лишається як є, і видно чистий внесок
+        # обертання з боку активацій. Це оптимістична межа: у справжній
+        # реалізації додасться похибка переквантування ваги.
+        k = x.shape[-1]
+        g = 128
+        H = _hadamard128(x.device)
+        xg = x.float().view(-1, k // g, g) @ H
+        sa = xg.abs().amax(dim=-1, keepdim=True).clamp_min(1e-8) / 7.0
+        q = torch.clamp(torch.round(xg / sa), -8.0, 7.0)
+        return ((q * sa) @ H).view(-1, k).to(x.dtype)
+    orig = x.dtype
+    xf = x.float()
+    if mode >= 2:
+        k = xf.shape[-1]
+        g = 128
+        assert k % g == 0
+        xg = xf.view(-1, k // g, g)
+        sa = xg.abs().amax(dim=-1, keepdim=True).clamp_min(1e-8) / 7.0
+        q = torch.clamp(torch.round(xg / sa), -8.0, 7.0)
+        return (q * sa).view(-1, k).to(orig)
+    sa = xf.abs().amax(dim=-1, keepdim=True).clamp_min(1e-8) / 7.0
+    q = torch.clamp(torch.round(xf / sa), -8.0, 7.0)
+    return (q * sa).to(orig)
+
