new file mode 100644
index 0000000000000000000000000000000000000000..a473df205d7b972d3e2ec3b243080e673d38e3e3
--- /dev/null
+++ b/vllm/v1/pp_stage_trace.py
@@ -0,0 +1,227 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Форк gfx1030: прилад часу стадій конвеєрного паралелізму.
+
+Вмикається `VLLM_PP_STAGE_TRACE=1`. Кожен ранг PP пише `rank{N}.jsonl`, рушій
+— `engine.jsonl`: по рядку на мікропакет. Зведення — у
+`tests/tools/pp-stage-trace-summary.py`.
+
+Мікропакети зіставляються за `seq`: порядковим номером виклику
+`execute_model`. Рушій викликає його для кожного мікропакета, а кожен ранг
+отримує ті самі виклики в тому самому порядку (широкомовна черга RPC), тож
+лічильники на всіх процесах збігаються без жодної передачі даних.
+
+Годинник — `time.monotonic_ns()` (CLOCK_MONOTONIC), спільний між процесами
+однієї машини; `perf_counter_ns` на Linux читає той самий годинник, але
+монотонний тут названо явно.
+
+Час GPU береться з подій HIP. `elapsed_time` НЕ читається на гарячому шляху:
+рядки з подіями лежать у черзі, а окремий потік читає їх, коли
+`event.query()` каже, що всі події справдилися (це не синхронізація).
+"""
+
+import atexit
+import json
+import os
+import threading
+import time
+from collections import deque
+from typing import Any
+
+import torch
+
+# Скільки рядків накопичувати перед записом і як довго максимум тримати
+# непорожній буфер (бо хвіст прогону менший за пачку).
+_BATCH_ROWS = 64
+_MAX_HOLD_S = 2.0
+_POLL_S = 0.25
+
+
+def now_ns() -> int:
+    return time.monotonic_ns()
+
+
+class TraceWriter:
+    """Буферизований запис JSONL окремим потоком.
+
+    `add()` лише кладе рядок у чергу (дешево, без блокувань). Потік
+    серіалізує рядок і скидає пачками. Рядок із подіями GPU чекає в черзі,
+    доки всі його події не справдяться; порядок рядків зберігається.
+    """
+
+    def __init__(self, path: str) -> None:
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        # "w": кожен запуск сервера починає seq з нуля, тож дописування до
+        # файлу минулого прогону змішало б два ряди номерів.
+        self._file = open(path, "w", encoding="utf-8")
+        self._queue: deque[dict[str, Any]] = deque()
+        self._buf: list[str] = []
+        self._last_write = time.monotonic()
+        self._stop = threading.Event()
+        self._lock = threading.Lock()
+        self._thread = threading.Thread(
+            target=self._loop, name="pp-stage-trace-writer", daemon=True
+        )
+        self._thread.start()
+        atexit.register(self.close)
+
+    def add(self, row: dict[str, Any]) -> None:
+        self._queue.append(row)
+
+    @staticmethod
+    def _events_ready(row: dict[str, Any]) -> bool:
+        return all(e.query() for e in row.get("_ev", {}).values())
+
+    @staticmethod
+    def _resolve(row: dict[str, Any]) -> dict[str, Any]:
+        ev = row.pop("_ev", None)
+        if not ev:
+            return row
+
+        def ms(a: str, b: str) -> float | None:
+            if a in ev and b in ev:
+                return round(ev[a].elapsed_time(ev[b]), 4)
+            return None
+
+        # Чистий прохід: від кінця очікування прийому (подія "c" стоїть після
+        # копії хост->карта) до кінця графа. Повний проміжок m0..m1 містить
+        # ще й простій CPU в очікуванні тензорів, тож його теж пишемо.
+        start = "c" if "c" in ev else "m0"
+        row["gpu_fwd_ms"] = ms(start, "m1")
+        row["gpu_fwd_span_ms"] = ms("m0", "m1")
+        row["gpu_logits_ms"] = ms("l0", "l1")
+        row["gpu_sample_ms"] = ms("s0", "s1")
+        return row
+
+    def _drain(self, force: bool) -> None:
+        while self._queue:
+            row = self._queue[0]
+            if not force and not self._events_ready(row):
+                break
+            if force:
+                for e in row.get("_ev", {}).values():
+                    e.synchronize()
+            self._queue.popleft()
+            self._buf.append(json.dumps(self._resolve(row), separators=(",", ":")))
+
+    def _write(self, force: bool) -> None:
+        if not self._buf:
+            return
+        if (
+            force
+            or len(self._buf) >= _BATCH_ROWS
+            or time.monotonic() - self._last_write >= _MAX_HOLD_S
+        ):
+            self._file.write("\n".join(self._buf) + "\n")
+            self._file.flush()
+            self._buf.clear()
+            self._last_write = time.monotonic()
+
+    def _loop(self) -> None:
+        while not self._stop.wait(_POLL_S):
+            with self._lock:
+                try:
+                    self._drain(force=False)
+                    self._write(force=False)
+                except Exception:
+                    # Прилад не має валити сервер; втрата рядків видна за
+                    # розривом seq у зведенні.
+                    pass
+
+    def close(self) -> None:
+        if self._stop.is_set():
+            return
+        self._stop.set()
+        with self._lock:
+            try:
+                self._drain(force=True)
+                self._write(force=True)
+            finally:
+                self._file.close()
+
+
+class StageTracer:
+    """Запис одного мікропакета на одному ранзі. Живе в процесі воркера."""
+
+    def __init__(self, trace_dir: str, pp_rank: int, pp_size: int) -> None:
+        self.pp_rank = pp_rank
+        self.pp_size = pp_size
+        self.seq = -1
+        self.cur: dict[str, Any] | None = None
+        self._writer = TraceWriter(os.path.join(trace_dir, f"rank{pp_rank}.jsonl"))
+
+    def begin(self, n_reqs: int, n_tokens: int) -> None:
+        self.seq += 1
+        self.cur = {
+            "seq": self.seq,
+            "pp_rank": self.pp_rank,
+            "n_reqs": n_reqs,
+            "n_tokens": n_tokens,
+            "_ev": {},
+        }
+
+    def t(self, name: str) -> None:
+        cur = self.cur
+        if cur is not None:
+            cur[name] = now_ns()
+
+    def ev(self, name: str) -> None:
+        cur = self.cur
+        if cur is not None:
+            e = torch.cuda.Event(enable_timing=True)
+            e.record()
+            cur["_ev"][name] = e
+
+    def finish(self) -> None:
+        cur = self.cur
+        self.cur = None
+        # Порожній крок (жодного токена) мікропакетом не є.
+        if cur is not None and cur["n_tokens"] > 0:
+            self._writer.add(cur)
+
+
+class EngineTracer:
+    """Запис мікропакетів на боці рушія (процес EngineCore)."""
+
+    def __init__(self, trace_dir: str, queue_size: int) -> None:
+        self.queue_size = queue_size
+        self.seq = -1
+        self._open: dict[int, dict[str, Any]] = {}
+        self._writer = TraceWriter(os.path.join(trace_dir, "engine.jsonl"))
+
+    def begin(self, t_sched_start: int, t_sched_end: int, depth: int) -> dict:
+        self.seq += 1
+        return {
+            "seq": self.seq,
+            "t_sched_start": t_sched_start,
+            "t_sched_end": t_sched_end,
+            "queue_depth_at_sched": depth,
+        }
+
+    def attach(self, scheduler_output: Any, rec: dict[str, Any]) -> None:
+        # Запис прив'язано до scheduler_output, бо в гілці відкладеного
+        # відбору (структурований вивід) черга поповнюється пізніше, ніж
+        # ідуть виклики.
+        self._open[id(scheduler_output)] = rec
+
+    def peek(self, scheduler_output: Any) -> dict[str, Any] | None:
+        return self._open.get(id(scheduler_output))
+
+    def pop(self, scheduler_output: Any) -> dict[str, Any] | None:
+        return self._open.pop(id(scheduler_output), None)
+
+    def finish(self, rec: dict[str, Any]) -> None:
+        if rec.get("n_tokens", 0) > 0:
+            self._writer.add(rec)
+
+
+def make_worker_tracer(pp_rank: int, pp_size: int) -> StageTracer:
+    from vllm import envs
+
+    return StageTracer(envs.VLLM_PP_STAGE_TRACE_DIR, pp_rank, pp_size)
+
+
+def make_engine_tracer(queue_size: int) -> EngineTracer:
+    from vllm import envs
+
+    return EngineTracer(envs.VLLM_PP_STAGE_TRACE_DIR, queue_size)
