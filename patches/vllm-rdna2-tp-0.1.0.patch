+def _stable_accelerator_memory_info(
+    device: torch.types.Device, timeout_s: float = 2.0, poll_interval_s: float = 0.05
+) -> tuple[int, int]:
+    """`torch.accelerator.get_memory_info()` on ROCm can lag the driver's
+    actual page bookkeeping by up to ~1 GiB right after a large free/alloc
+    burst (the same symptom `GPUWorker.sleep()` already waits out with an
+    identical settle-loop, see `vllm/v1/worker/gpu_worker.py`). Every
+    `MemorySnapshot.measure()` call — in particular the init snapshot and
+    the post-profile snapshot used to size the KV cache — reads this same
+    counter without waiting, so two otherwise-identical `vllm serve`
+    launches can see free_memory differ by ~1 GiB purely from driver
+    timing, producing a swing of hundreds of thousands of tokens in the
+    advertised "GPU KV cache size". Poll until two consecutive reads agree
+    (within a small tolerance) or give up after timeout_s and return the
+    last reading, so we settle when we can and never hang when we can't.
+    """
+    if not current_platform.is_rocm():
+        return torch.accelerator.get_memory_info(device)
+
+    tolerance_bytes = 8 * MiB_bytes
+    prev_free: int | None = None
+    deadline = time.monotonic() + timeout_s
+    while True:
+        free, total = torch.accelerator.get_memory_info(device)
+        if prev_free is not None and abs(free - prev_free) <= tolerance_bytes:
+            return free, total
+        prev_free = free
+        if time.monotonic() >= deadline:
+            return free, total
+        time.sleep(poll_interval_s)
+
