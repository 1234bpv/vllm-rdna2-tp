+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HIP prefill kernel for the int4 per-token-head KV cache (RDNA2).
+
+The kernel (`int4_prefill_attn.hip`, enabled with
+`VLLM_ROCM_INT4_PREFILL_KERNEL=hip`) replaces the Triton `_attn_packed` launch
+on the 2D path (qlen > 1). It is checked against a float32 reference built
+from the dequantized cache (softmax in fp32, explicit causal and sliding-window
+mask), with the criterion of the Gemma 4 attention reference
+(work/reports/2026-10-01-gemma-attn-reference.md: int4 fails above
+rel_dequant = 0.20; the Triton kernel itself sits at 5-8 % there), and against
+the Triton kernel on the same input.
+"""
+
+import math
+
+import pytest
+import torch
+
+import vllm.envs as envs
+from vllm.platforms import current_platform
+from vllm.utils.torch_utils import get_dtype_size
+from vllm.v1.attention.backends.triton_attn import TritonAttentionBackend
+from vllm.v1.attention.ops import int4_prefill_attn as prefill_mod
+from vllm.v1.attention.ops.int4_per_token_head import (
+    reshape_and_cache_int4,
+    single_rht,
+)
+from vllm.v1.attention.ops.triton_unified_attention import unified_attention
+from vllm.v1.kv_cache_interface import KVQuantMode
+
+if not current_platform.is_rocm():
+    pytest.skip("ROCm only", allow_module_level=True)
+from vllm.platforms.rocm import on_gfx10  # noqa: E402
+
+if not on_gfx10():
+    pytest.skip("RDNA2 (gfx10) only", allow_module_level=True)
+
+DEVICE = "cuda"
+
+# (heads_q, heads_kv, head_size, sliding_window): the two Gemma 4 layer kinds
+# per TP=2 rank, then the other group sizes the kernel dispatches.
+SHAPES = {
+    "gemma_global": (8, 1, 512, 0),
+    "gemma_sliding": (8, 4, 256, 1024),
+    "g2_hs512": (8, 4, 512, 0),
+    "g4_hs256": (8, 2, 256, 0),
+    "g8_hs256": (8, 1, 256, 0),
+    "g4_hs512": (8, 2, 512, 0),
+    "g1_hs256_window": (4, 4, 256, 300),
+}
+
+# One sequence is (context already in the cache, query tokens of the chunk).
+CASES = {
+    "from_scratch": [(0, 300)],
+    "single_token": [(0, 1)],
+    "short_chunk_with_prefix": [(100, 5)],
+    "chunked_prefill": [(3000, 700)],
+    "tile_tails": [(33, 31), (65, 64), (127, 3)],
+    "window_edges": [(1023, 17), (1024, 1), (1025, 64), (2048, 128)],
+    "batch": [(0, 130), (700, 33), (2000, 257)],
+}
+
+
+def _scale_caches(kv_cache: torch.Tensor):
+    """fp32 views of the scale tails (copy of TritonAttentionImpl's, no fill)."""
+    num_blocks, nkv, block_size, content = kv_cache.shape
+    dtype_sz = kv_cache.element_size()
+    scale_pad = get_dtype_size(torch.float32) // dtype_sz
+    padded_hs = content // 2
+    hs = padded_hs - scale_pad
+    base_f32 = torch.tensor([], dtype=torch.float32, device=kv_cache.device).set_(
+        kv_cache.untyped_storage()
+    )
+
+    def u(elements):
+        return elements * dtype_sz // 4
+
+    st = kv_cache.stride()
+    size = (num_blocks, block_size, nkv)
+    stride = (u(st[0]), u(st[2]), u(st[1]))
+    base = u(kv_cache.storage_offset())
+    k = torch.as_strided(base_f32, size, stride, base + u(hs))
+    v = torch.as_strided(base_f32, size, stride, base + u(padded_hs + hs))
+    return k, v
+
+
+class _Case:
+    """A paged int4 cache with several sequences and the chunk's queries."""
+
+    def __init__(self, heads_q, heads_kv, head_size, seqs, block_size, seed=0):
+        self.heads_q, self.heads_kv, self.head_size = heads_q, heads_kv, head_size
+        self.block_size = block_size
+        gen = torch.Generator(device="cpu").manual_seed(seed)
+        seq_lens = [ctx + qlen for ctx, qlen in seqs]
+        blocks = [math.ceil(n / block_size) for n in seq_lens]
+        num_blocks = sum(blocks) + 2
+        shape = TritonAttentionBackend.get_kv_cache_shape(
+            num_blocks, block_size, heads_kv, head_size, "int4_per_token_head"
+        )
+        # NHD physical order, as in the engine.
+        phys = torch.zeros(
+            (shape[0], shape[2], shape[1], shape[3]), dtype=torch.uint8, device=DEVICE
+        )
+        kv_cache = phys.permute(0, 2, 1, 3)
+        self.k_scale, self.v_scale = _scale_caches(kv_cache)
+        padded_hs = kv_cache.shape[-1] // 2
+        self.k_cache, self.v_cache = kv_cache.transpose(1, 2).split(padded_hs, dim=-1)
+
+        perm = torch.randperm(num_blocks, generator=gen).to(torch.int32)
+        bt = torch.zeros((len(seqs), max(blocks)), dtype=torch.int32)
+        start = 0
+        for i, n in enumerate(blocks):
+            bt[i, :n] = perm[start : start + n]
+            start += n
+        self.block_table = bt.to(DEVICE)
+
+        for i, n in enumerate(seq_lens):
+            pos = torch.arange(n, dtype=torch.int64)
+            slots = bt[i, pos // block_size].to(torch.int64) * block_size + pos % block_size
+            k = torch.randn(n, heads_kv, head_size, dtype=torch.float16, generator=gen)
+            v = torch.randn(n, heads_kv, head_size, dtype=torch.float16, generator=gen)
+            reshape_and_cache_int4(
+                k.to(DEVICE),
+                v.to(DEVICE),
+                self.k_cache,
+                self.v_cache,
+                slots.to(DEVICE),
+                k_scale_cache=self.k_scale,
+                v_scale_cache=self.v_scale,
+            )
+        total_q = sum(qlen for _, qlen in seqs)
+        self.q = torch.randn(
+            total_q, heads_q, head_size, dtype=torch.float16, generator=gen
+        ).to(DEVICE)
+        self.seqs = seqs
+        self.seq_lens = torch.tensor(seq_lens, dtype=torch.int32, device=DEVICE)
+        cu = [0]
+        for _, qlen in seqs:
+            cu.append(cu[-1] + qlen)
+        self.cu_seqlens_q = torch.tensor(cu, dtype=torch.int32, device=DEVICE)
+
+    def dequantized(self, i: int):
+        """K and V of sequence i as fp32, nibbles undone and RHT inverted."""
+        ctx, qlen = self.seqs[i]
+        n = ctx + qlen
+        bs, hs = self.block_size, self.head_size
+        p = torch.arange(n, device=DEVICE)
+        b = self.block_table[i, p // bs].long()
+        slot = p % bs
+
+        def one(cache, scale_cache):
+            sc_raw = scale_cache[b, slot, :].view(torch.int32)
+            zp = (sc_raw & 0x0F).float().unsqueeze(-1)
+            scale = (sc_raw & ~0x0F).view(torch.float32).unsqueeze(-1)
+            raw = cache[b, slot, :, : hs // 2]
+            even = (raw & 0x0F).float()
+            odd = ((raw >> 4) & 0x0F).float()
+            nib = torch.stack([even, odd], dim=-1).reshape(n, -1, hs)
+            return single_rht((nib - zp) * scale, inverse=True, scale=1.0 / hs)
+
+        return one(self.k_cache, self.k_scale), one(self.v_cache, self.v_scale)
+
+    def run(self, window, softmax_scale, sinks=None):
+        out = torch.zeros_like(self.q)
+        unified_attention(
+            q=self.q,
+            k=self.k_cache,
+            v=self.v_cache,
+            out=out,
+            cu_seqlens_q=self.cu_seqlens_q,
+            max_seqlen_q=max(qlen for _, qlen in self.seqs),
+            seqused_k=self.seq_lens,
+            max_seqlen_k=int(self.seq_lens.max()),
+            softmax_scale=softmax_scale,
+            causal=True,
+            window_size=(window - 1, 0) if window else (-1, -1),
+            block_table=self.block_table,
+            softcap=0.0,
+            q_descale=None,
+            k_descale=None,
+            v_descale=None,
+            sinks=sinks,
+            kv_quant_mode=KVQuantMode.INT4_PER_TOKEN_HEAD,
+            k_scale_cache=self.k_scale,
+            v_scale_cache=self.v_scale,
+        )
+        return out
+
+    def reference(self, window, softmax_scale):
+        """fp32 attention over the dequantized cache, explicit mask."""
+        outs = []
+        g = self.heads_q // self.heads_kv
+        for i, (ctx, qlen) in enumerate(self.seqs):
+            k, v = self.dequantized(i)
+            q = self.q[self.cu_seqlens_q[i] : self.cu_seqlens_q[i + 1]].float()
+            k = k.repeat_interleave(g, dim=1)
+            v = v.repeat_interleave(g, dim=1)
+            s = torch.einsum("qhd,khd->hqk", q, k) * softmax_scale
+            qpos = (ctx + torch.arange(qlen, device=DEVICE))[:, None]
+            kpos = torch.arange(ctx + qlen, device=DEVICE)[None, :]
+            mask = kpos <= qpos
+            if window:
+                mask &= kpos > qpos - window
+            s = s.masked_fill(~mask[None], float("-inf"))
+            outs.append(torch.einsum("hqk,khd->qhd", torch.softmax(s, dim=-1), v))
+        return torch.cat(outs)
+
+
+@pytest.fixture(autouse=True)
+def _fresh_envs(monkeypatch):
+    if envs._is_envs_cache_enabled():
+        envs.disable_envs_cache()
+    monkeypatch.setenv("VLLM_ROCM_INT4_PREFILL_KERNEL", "triton")
+
+
+@pytest.fixture
+def hip_launches(monkeypatch):
+    """Counts launches of the HIP kernel through the dispatcher's hook."""
+    log = []
+    original = prefill_mod.try_launch_int4_prefill_attn
+
+    def spy(**kwargs):
+        done = original(**kwargs)
+        log.append(done)
+        return done
+
+    monkeypatch.setattr(prefill_mod, "try_launch_int4_prefill_attn", spy)
+    return log
+
+
+def _rel(a, b):
+    return ((a.float() - b.float()).norm() / b.float().norm().clamp(min=1e-12)).item()
+
+
+@pytest.mark.parametrize("block_size", [16, 32])
+@pytest.mark.parametrize("softmax_scale_kind", ["unit", "inv_sqrt"])
+@pytest.mark.parametrize("case", list(CASES))
+@pytest.mark.parametrize("shape", list(SHAPES))
+def test_hip_prefill_matches_reference(
+    shape, case, softmax_scale_kind, block_size, monkeypatch, hip_launches
+):
+    heads_q, heads_kv, head_size, window = SHAPES[shape]
+    # Gemma 4 normalises q and k, so its softmax scale is 1.0; the other value
+    # gives a flat softmax, where an error in the weights shows up differently.
+    softmax_scale = 1.0 if softmax_scale_kind == "unit" else head_size**-0.5
+    c = _Case(heads_q, heads_kv, head_size, CASES[case], block_size)
+
+    triton_out = c.run(window, softmax_scale)
+    assert hip_launches == []
+
+    monkeypatch.setenv("VLLM_ROCM_INT4_PREFILL_KERNEL", "hip")
+    hip_out = c.run(window, softmax_scale)
+    assert hip_launches and all(hip_launches), "HIP prefill kernel did not run"
+
+    assert torch.isfinite(hip_out).all()
+    ref = c.reference(window, softmax_scale)
+    err_hip = _rel(hip_out, ref)
+    err_triton = _rel(triton_out, ref)
+    assert err_hip < 0.20, f"rel_dequant {err_hip:.4f} (Triton {err_triton:.4f})"
+    # The int8 P.V of the Triton kernel adds noise the fp16 P.V does not.
+    assert err_hip <= err_triton * 1.1 + 1e-3, (
+        f"HIP {err_hip:.4f} worse than Triton {err_triton:.4f}"
+    )
+
+
+def test_hip_prefill_hands_unsupported_inputs_to_triton(monkeypatch, hip_launches):
+    heads_q, heads_kv, head_size, window = SHAPES["gemma_global"]
+    c = _Case(heads_q, heads_kv, head_size, CASES["from_scratch"], 16)
+    sinks = torch.randn(heads_q, dtype=torch.float32, device=DEVICE)
+    monkeypatch.setenv("VLLM_ROCM_INT4_PREFILL_KERNEL", "hip")
+    out = c.run(window, 1.0, sinks=sinks)
+    assert hip_launches == [False]
+    assert torch.isfinite(out).all()
+
+
+def test_hip_prefill_flag_is_on_by_default(hip_launches, monkeypatch):
+    # Специфікація змінена 03.10: HIP типовий після наскрізного заміру на Gemma 4.
+    monkeypatch.delenv("VLLM_ROCM_INT4_PREFILL_KERNEL", raising=False)
+    assert envs.VLLM_ROCM_INT4_PREFILL_KERNEL == "hip"
+    heads_q, heads_kv, head_size, window = SHAPES["gemma_sliding"]
+    _Case(heads_q, heads_kv, head_size, CASES["from_scratch"], 16).run(window, 1.0)
+    assert hip_launches and all(hip_launches)
