+# --- C. Інваріант лічильника кроків у дорозі -------------------------------
+
+
+def _counter_mismatches(engine: EngineSim) -> list[tuple[int, int | None, int]]:
+    return [entry for entry in engine.counter_log if entry[1] != entry[2]]
+
+
+@pytest.mark.parametrize(
+    "num_requests", sorted(EXPECTED_STEADY_SIZES), ids=lambda n: f"N={n}"
+)
+def test_counter_equals_nonempty_in_flight_steady(num_requests: int):
+    """Після кожного кроку scheduler._pp_steps_in_flight дорівнює числу
+    непорожніх пакетів у черзі — від першого префілу до кінця прогону."""
+    _, engine, _ = _start_decoding(num_requests)
+    engine.run_turns(WARMUP_TURNS + CHECK_TURNS)
+    bad = _counter_mismatches(engine)
+    assert not bad, (
+        f"N={num_requests}: (крок, лічильник, непорожніх у черзі): {bad[:8]}"
+    )
+
+
+@pytest.mark.parametrize("n0, k, kind, arrival", STAGGER_PARAMS)
+def test_counter_equals_nonempty_in_flight_staggered(n0, k, kind, arrival):
+    """Той самий інваріант під час приходу нових запитів і шматків префілу
+    (витіснень і скасувань тут немає, тож рівність сувора)."""
+    _, engine, _ = _staggered_scenario(n0, k, kind, arrival)
+    engine.run_turns(ALIGN_TURNS + CHECK_TURNS)
+    assert not engine.events, "Сценарій не мав містити витіснень"
+    bad = _counter_mismatches(engine)
+    assert not bad, (
+        f"{n0}+{k} ({kind}, {arrival}): (крок, лічильник, непорожніх): "
+        f"{bad[:8]}"
+    )
+
+
+def _counter_violations_with_events(engine: EngineSim, pp_size: int) -> list:
+    """Інваріант C там, де він визначений, з допуском після подій.
+
+    Дозволено лише ЗАНИЖЕННЯ лічильника (лічильник < непорожніх у черзі),
+    і лише (1) після першої події (витіснення чи скасування) та
+    (2) серією не довшою за один оборот (pp_size кроків поспіль).
+    Завищення, від'ємне значення, розбіжність до першої події чи серія,
+    довша за оборот (тобто дрейф), — порушення.
+    """
+    violations = []
+    first_event = min(engine.events) if engine.events else None
+    run_len = 0
+    for step, counter, actual in engine.counter_log:
+        if counter == actual:
+            run_len = 0
+            continue
+        run_len += 1
+        if counter is None or counter < 0 or counter > actual:
+            violations.append(("не нижче", step, counter, actual))
+        elif first_event is None or step < first_event:
+            violations.append(("до події", step, counter, actual))
+        elif run_len > pp_size:
+            violations.append(("довше обороту", step, counter, actual))
+    return violations
+
+
+# --- D. Краї ---------------------------------------------------------------
+
+PREEMPT_MAX_TOKENS = 100
+
+
+@pytest.mark.parametrize("num_requests", [4, 6], ids=lambda n: f"N={n}")
+@pytest.mark.parametrize("num_blocks", [12, 20], ids=lambda b: f"blocks={b}")
+def test_preemption_mid_decode_engine_drains(num_requests, num_blocks):
+    """D1. Брак блоків KV посеред декоду: витіснення стається, рушій не
+    застрягає, кожен запит завершується з повним числом токенів."""
+    scheduler = _make_pp_scheduler(num_blocks=num_blocks)
+    engine = EngineSim(
+        scheduler=scheduler,
+        queue_size=scheduler.vllm_config.max_concurrent_batches,
+    )
+    requests = create_requests(
+        num_requests=num_requests, num_tokens=SHORT_PROMPT,
+        max_tokens=PREEMPT_MAX_TOKENS, ignore_eos=True,
+    )
+    for req in requests:
+        scheduler.add_request(req)
+    limit = 4000
+    for _ in range(limit):
+        if not scheduler.has_requests() and not engine.queue:
+            break
+        engine.step()
+    stuck = scheduler.has_requests() or bool(engine.queue)
+    left = [
+        (r.request_id, r.status.name, r.num_output_tokens)
+        for r in scheduler.requests.values()
+    ]
+    assert not stuck, f"Рушій не спорожнів за {limit} кроків: {left}"
+    assert sum(r.num_preemptions for r in requests) > 0, (
+        "Витіснення не сталося — сценарій нічого не перевірив"
+    )
+    unfinished = [
+        (r.request_id, r.status.name, r.num_output_tokens)
+        for r in requests
+        if r.status != RequestStatus.FINISHED_LENGTH_CAPPED
+        or r.num_output_tokens != PREEMPT_MAX_TOKENS
+    ]
+    assert not unfinished, f"Не завершилися повністю: {unfinished}"
+
+
+@pytest.mark.parametrize("num_requests", [4, 6], ids=lambda n: f"N={n}")
+@pytest.mark.parametrize("num_blocks", [12, 20], ids=lambda b: f"blocks={b}")
+def test_preemption_counter_invariant_with_tolerance(num_requests, num_blocks):
+    """D1. Інваріант C при витісненнях: лічильник ніколи не більший за
+    число непорожніх пакетів у черзі; менший — лише після витіснення і не
+    довше одного обороту поспіль; після спорожнення рушія — нуль."""
+    scheduler = _make_pp_scheduler(num_blocks=num_blocks)
+    engine = EngineSim(
+        scheduler=scheduler,
+        queue_size=scheduler.vllm_config.max_concurrent_batches,
+    )
+    for req in create_requests(
+        num_requests=num_requests, num_tokens=SHORT_PROMPT,
+        max_tokens=PREEMPT_MAX_TOKENS, ignore_eos=True,
+    ):
+        scheduler.add_request(req)
+    for _ in range(4000):
+        if not scheduler.has_requests() and not engine.queue:
+            break
+        engine.step()
+    violations = _counter_violations_with_events(engine, PP_SIZE)
+    assert not violations, (
+        f"Витіснень на кроках {engine.events[:10]}; порушення "
+        f"(вид, крок, лічильник, непорожніх): {violations[:8]}"
+    )
+    assert getattr(scheduler, "_pp_steps_in_flight", None) == 0, (
+        "Після спорожнення рушія лічильник мав бути 0: "
+        f"{getattr(scheduler, '_pp_steps_in_flight', None)}"
+    )
