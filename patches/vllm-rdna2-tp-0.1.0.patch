+class TestCudaGraphCaptureSpec:
+    """Tests against Specification 5: HIP CUDAGraph capture and replay bitwise fidelity."""
+
+    @pytest.mark.parametrize("n", [1, 4])
+    @pytest.mark.parametrize("with_bias", [False, True])
+    def test_cuda_graph_capture_and_replay(self, n: int, with_bias: bool):
+        """Replay after modifying static x must produce bitwise identical output to direct call."""
+        torch.manual_seed(n * 50 + (1 if with_bias else 0))
+        m, k = 128, 256
+        w_int8 = torch.randint(-127, 128, (m, k), dtype=torch.int8, device="cuda")
+        scale = torch.rand(m, dtype=torch.float32, device="cuda") * 0.05 + 0.001
+        bias = torch.randn(m, dtype=torch.float16, device="cuda") if with_bias else None
+
+        static_x = torch.randn(n, k, dtype=torch.float16, device="cuda")
+
+        # Warmup on side stream
+        s = torch.cuda.Stream()
+        s.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(s):
+            for _ in range(3):
+                _ = w8a16_linear(static_x, w_int8, scale, bias)
+        torch.cuda.current_stream().wait_stream(s)
+
+        # Capture graph
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            static_out = w8a16_linear(static_x, w_int8, scale, bias)
+
+        # Mutate static_x content
+        new_x = torch.randn(n, k, dtype=torch.float16, device="cuda")
+        static_x.copy_(new_x)
+
+        # Replay graph
+        graph.replay()
+        torch.cuda.synchronize()
+
+        # Direct execution with new_x
+        direct_out = w8a16_linear(new_x, w_int8, scale, bias)
+        torch.cuda.synchronize()
+
+        assert torch.equal(static_out, direct_out), (
+            f"CUDAGraph replay diverged from direct execution for n={n}, with_bias={with_bias}: "
+            f"max diff = {(static_out.float() - direct_out.float()).abs().max().item()}"
+        )
