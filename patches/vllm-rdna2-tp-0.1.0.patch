+# --- пофазний хронометраж спекулятивного декоду (VLLM_ROCM_TIME_SPEC=N кроків) ---
+_SPEC_T: dict[str, float] = {}
+_SPEC_N_STEPS = 0
+
+
+def _spec_on() -> bool:
