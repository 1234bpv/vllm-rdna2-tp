+++ b/vllm/model_executor/kernels/moe/moe_q_gemm_rdna2.hip
@@ -0,0 +1,584 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// Злите ядро MoE W4A16 (лише fp16) для RDNA2 (gfx1030).
+//
+// Перенесено з csrc/rocm/moe_q_gemm_rdna3.cu (+ qdq_4_rdna3.cuh) апстріму:
+// маршрутизація експертів (sorted_token_ids / expert_ids), деквантизація
+// int4 бітовим трюком exllama та скалярний добуток v_dot2_f32_f16 (є на
+// gfx1030) в одному запуску. Гілки bf16 вилучено: на gfx1030 немає
+// v_dot2_f32_bf16, а модель працює лише у fp16.
+//
+// Відмінності від апстріму:
+//   * файл самодостатній (потрібні частини qdq_4_rdna3.cuh вбудовано),
+//     збирається як JIT-розширення через load_rdna_ext;
+//   * масштаб НЕ вбудовано в деквантизацію. Апстрімна prep_zero_scale_fp16
+//     кладе в fp16 добуток scale*(-1024-zero) (величина ~1024*scale, крок
+//     fp16 там 0.5..1 scale), тобто кожна вага має систематичну похибку до
+//     півкроку квантування: виміряно 2,3e-2 відносної похибки Фробеніуса
+//     проти еталону fp32 (поріг 2e-3). Тут (q - zero) обчислюється точно
+//     (малі цілі в fp16), скалярний добуток сумується без масштабу в межах
+//     групи, а scale множиться в fp32 один раз на групу (як у exllama);
+//   * зсув нуля `zero_offset` — аргумент запуску, а не константа 1.
+//     Формат GPTQ v1 зберігає zp-1 (zero_offset=1), тому нуль-точку 0
+//     ним закодувати не можна; compressed-tensors зберігає справжню zp
+//     (zero_offset=0). Обидва випадки перевіряє tests/tools/
+//     moe-rdna2-accept.py;
+//   * замість регістрації в _rocm_C — pybind11.
+//
+// Формат ваг: [E, K/8, N] uint32 (exllama-перемішані), scales [E, groups, N]
+// fp16, zeros [E, groups, N/8] uint32. Виведення — атомарним додаванням
+// 4 half (64-бітний CAS) у заздалегідь обнулений тензор (лише
+// deterministic=false). Детермінований режим: див. OutMode і moe_reduce_kernel.
+
+#include <torch/extension.h>
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <hip/hip_fp16.h>
+#include <algorithm>
+#include <cstdint>
+
+#define BLOCK_KN_SIZE 256
+#define THREADS_X 256
+#define REDUCE_QUADS 64  // четвірок стовпців на блок зведення
+#define REDUCE_LANES 4   // смуг по (j, s); REDUCE_QUADS * REDUCE_LANES потоків
+
+namespace {
+
+// Сталі для точного (q - zero) у fp16 (без масштабу):
+//   z1z16[0] = -(1024 + zero)   для «нижніх» пар:   (1024 + q) + z1z16[0]
+//   z1z16[1] = -(64 + zero)     для «верхніх» пар:  (16q + 1024)/16 + z1z16[1]
+// Усі значення - цілі до 2048, у fp16 точні.
+__forceinline__ __device__ void prep_zero_fp16(uint32_t zero, half2 (&z1z16)[2]) {
+  z1z16[0] = __half2half2(__int2half_rn(-1024 - (int)zero));
+  z1z16[1] = __half2half2(__int2half_rn(-64 - (int)zero));
+}
+
+// Одне int32 (вісім перемішаних 4-бітних ваг) у чотири half2 значень q - zero.
+__forceinline__ __device__ void dequant_4bit_8_fp16(uint32_t qa, half2 (&dq)[4],
+                                                    half2 (&z1z16)[2]) {
+  const uint32_t c0 = 0x64006400;
+  const half2 one = __half2half2(__float2half_rn(1.0f));
+  const half2 sixteenth = __half2half2(__float2half_rn(1.0f / 16.0f));
+
+  union {
+    uint32_t u;
+    half2 h2;
+  } q0, q1, q2, q3;
+  q0.u = (qa & 0x000F000F) | c0;
+  q1.u = (qa & 0x00F000F0) | c0;
+  uint32_t qa_hi = qa >> 8;
+  q2.u = (qa_hi & 0x000F000F) | c0;
+  q3.u = (qa_hi & 0x00F000F0) | c0;
+
+  dq[0] = __hfma2(q0.h2, one, z1z16[0]);
+  dq[1] = __hfma2(q1.h2, sixteenth, z1z16[1]);
+  dq[2] = __hfma2(q2.h2, one, z1z16[0]);
+  dq[3] = __hfma2(q3.h2, sixteenth, z1z16[1]);
+}
+
+__forceinline__ __device__ float dot22_8_f(half2 (&dq)[4], const half* a_ptr) {
+  float result = 0.0f;
+  const half2* a2_ptr = (const half2*)a_ptr;
+#pragma unroll
+  for (int i = 0; i < 4; i++) {
+    result = __builtin_amdgcn_fdot2(dq[i], *a2_ptr++, result, /*clamp=*/false);
+  }
+  return result;
+}
+
+__forceinline__ __device__ void atomic_add_pk4_f16(half* addr, half2 v01,
+                                                   half2 v23) {
+  unsigned long long* addr_u = reinterpret_cast<unsigned long long*>(addr);
+  unsigned long long old = *addr_u;
+  while (true) {
+    union {
+      unsigned long long u;
+      half2 h2[2];
+    } cur, sum;
+    cur.u = old;
+    sum.h2[0] = __hadd2(cur.h2[0], v01);
+    sum.h2[1] = __hadd2(cur.h2[1], v23);
+    unsigned long long prev = atomicCAS(addr_u, old, sum.u);
+    if (prev == old) break;
+    old = prev;
+  }
+}
+
+__forceinline__ __device__ void load4_zeros(const uint32_t* qzeros_row, int n,
+                                            int (&zeros)[4]) {
+  int qcol = n / 8;
+  int shift = (n & 0x07) * 4;
+  uint32_t d = qzeros_row[qcol] >> shift;
+  zeros[0] = (int)(d & 0xF);
+  zeros[1] = (int)((d >> 4) & 0xF);
+  zeros[2] = (int)((d >> 8) & 0xF);
+  zeros[3] = (int)((d >> 12) & 0xF);
+}
+
+// Куди ядро кладе результат шматка K:
+//   OUT_ATOMIC - атомарне додавання в fp16 (стара поведінка, недетермінована);
+//   OUT_PLAIN  - прямий запис fp16 (потрібне рівно одне K-розщеплення);
+//   OUT_WS32   - fp32-комірка (розщеплення, рядок) у робочому буфері.
+enum OutMode { OUT_ATOMIC = 0, OUT_PLAIN = 1, OUT_WS32 = 2 };
+
+template <int BLOCK_SIZE_M, int OUT_MODE>
+__global__ void moe_gemm_q4_kernel_rdna2(
+    const half* __restrict__ a,               // [size_m, size_k] або [M*topk, K]
+    half* __restrict__ c,                     // [M*topk, size_n], обнулений
+    const uint32_t* __restrict__ b_q_weight,  // [E, K/8, N]
+    const half* __restrict__ b_scales,        // [E, groups, N]
+    const uint32_t* __restrict__ b_qzeros,    // [E, groups, N/8]
+    const float* __restrict__ topk_weights,   // [M*topk] або nullptr
+    const int32_t* __restrict__ sorted_token_ids,
+    const int32_t* __restrict__ expert_ids,
+    const int32_t* __restrict__ num_tokens_post_padded, const int size_m,
+    const int size_n, const int size_k, const int groups, const int top_k,
+    const int expert_weight_stride,  // (K/8) * N
+    const int expert_scales_stride,  // groups * N
+    const int expert_zeros_stride,   // groups * (N/8)
+    const bool mul_topk_weight,
+    const int output_topk,  // >0: згорнути рядок виводу як token_id/output_topk
+    const int zero_offset,
+    float* __restrict__ ws,  // [splits, ws_rows, size_n] fp32 (OUT_WS32)
+    const int ws_rows,       // size_m * top_k
+    const int chunks_per_block) {  // шматків K по BLOCK_KN_SIZE на групу
+  const int t = threadIdx.x;
+  const int token_block = blockIdx.x;
+  const int offset_n = blockIdx.y * BLOCK_KN_SIZE * 4;
+  const int offset_k = blockIdx.z * chunks_per_block * BLOCK_KN_SIZE;
+  const int block_end_k =
+      min(offset_k + chunks_per_block * BLOCK_KN_SIZE, size_k);
+  const int n = offset_n + t * 4;
+  const bool active = n < size_n;
+
+  // Блок вирівнювання або експерт поза картою (expert_map = -1)
+  if (token_block * BLOCK_SIZE_M >= num_tokens_post_padded[0]) return;
+
+  const int expert_id = expert_ids[token_block];
+  if (expert_id == -1) return;
+
+  const uint32_t* expert_weights =
+      b_q_weight + (int64_t)expert_id * expert_weight_stride;
+  const half* expert_scales =
+      b_scales + (int64_t)expert_id * expert_scales_stride;
+  const uint32_t* expert_qzeros =
+      b_qzeros + (int64_t)expert_id * expert_zeros_stride;
+
+  constexpr int LDS_PAD = 8;
+  __shared__ half block_a[BLOCK_SIZE_M][BLOCK_KN_SIZE + LDS_PAD];
+
+  static_assert(BLOCK_KN_SIZE == THREADS_X,
+                "BLOCK_KN_SIZE must equal THREADS_X");
+
+  const int offset_m_base = token_block * BLOCK_SIZE_M;
+  const int groupsize = size_k / groups;
+
+  half2 z1z16_h[4][2];
+  float scale_f[4];
+
+  auto refresh_group = [&](int g) {
+    const uint32_t* qz_row = expert_qzeros + g * (size_n / 8);
+    const half* sc_row = expert_scales + g * size_n;
+    int zeros[4];
+    load4_zeros(qz_row, n, zeros);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      prep_zero_fp16((uint32_t)(zeros[i] + zero_offset), z1z16_h[i]);
+      scale_f[i] = __half2float(sc_row[n + i]);
+    }
+  };
+
+  float block_c[BLOCK_SIZE_M][4];
+#pragma unroll
+  for (int m = 0; m < BLOCK_SIZE_M; ++m) {
+#pragma unroll
+    for (int j = 0; j < 4; ++j) block_c[m][j] = 0.0f;
+  }
+
+  // Шматки K по BLOCK_KN_SIZE обробляються послідовно в одному порядку,
+  // тож сума однієї групи робочих завжди збирається в тому самому порядку.
+  for (int chunk_k = offset_k; chunk_k < block_end_k; chunk_k += BLOCK_KN_SIZE) {
+    const int end_k = min(chunk_k + BLOCK_KN_SIZE, size_k);
+
+    if (chunk_k + t < end_k) {
+#pragma unroll
+      for (int m = 0; m < BLOCK_SIZE_M; ++m) {
+        int32_t token_id = sorted_token_ids[offset_m_base + m];
+        int token_row = token_id / top_k;
+        half av = __float2half_rn(0.0f);
+        if (token_row < size_m) {
+          av = a[(int64_t)token_row * size_k + chunk_k + t];
+        }
+        block_a[m][t] = av;
+      }
+    }
+    __syncthreads();
+
+    if (active) {
+      int group = chunk_k / groupsize;
+      int nextgroup = (group + 1) * groupsize;
+      const uint32_t* b_ptr = expert_weights + (chunk_k / 8) * size_n + n;
+
+      int k = chunk_k;
+      while (k < end_k) {
+        refresh_group(group);
+        const int group_end = min(nextgroup, end_k);
+
+        float grp_c[BLOCK_SIZE_M][4];
+#pragma unroll
+        for (int m = 0; m < BLOCK_SIZE_M; ++m) {
+#pragma unroll
+          for (int j = 0; j < 4; ++j) grp_c[m][j] = 0.0f;
+        }
+
+        while (k < group_end) {
+          // Випереджувальне читання 4 слів ваг (128 байт)
+          int4 b_w[4];
+#pragma unroll
+          for (int j = 0; j < 4; ++j) {
+            b_w[j] = *(const int4*)(b_ptr + j * size_n);
+          }
+          b_ptr += 4 * size_n;
+
+#pragma unroll
+          for (int j = 0; j < 4; ++j) {
+            const int a_off = (k - chunk_k) + 8 * j;
+
+            half2 dq[4][4];
+            dequant_4bit_8_fp16((uint32_t)b_w[j].x, dq[0], z1z16_h[0]);
+            dequant_4bit_8_fp16((uint32_t)b_w[j].y, dq[1], z1z16_h[1]);
+            dequant_4bit_8_fp16((uint32_t)b_w[j].z, dq[2], z1z16_h[2]);
+            dequant_4bit_8_fp16((uint32_t)b_w[j].w, dq[3], z1z16_h[3]);
+
+#pragma unroll
+            for (int m = 0; m < BLOCK_SIZE_M; ++m) {
+              const half* a_ptr =
+                  reinterpret_cast<const half*>(&block_a[m][a_off]);
+              grp_c[m][0] += dot22_8_f(dq[0], a_ptr);
+              grp_c[m][1] += dot22_8_f(dq[1], a_ptr);
+              grp_c[m][2] += dot22_8_f(dq[2], a_ptr);
+              grp_c[m][3] += dot22_8_f(dq[3], a_ptr);
+            }
+          }
+          k += 32;
+        }
+
+#pragma unroll
+        for (int m = 0; m < BLOCK_SIZE_M; ++m) {
+#pragma unroll
+          for (int j = 0; j < 4; ++j) block_c[m][j] += grp_c[m][j] * scale_f[j];
+        }
+        group++;
+        nextgroup += groupsize;
+      }
+    }
+    __syncthreads();
+  }
+
+  if (!active) return;
+
+#pragma unroll
+  for (int m = 0; m < BLOCK_SIZE_M; ++m) {
+    int32_t token_id = sorted_token_ids[offset_m_base + m];
+    if (token_id / top_k >= size_m) continue;
+
+    if (mul_topk_weight && topk_weights != nullptr) {
+      float tw = topk_weights[token_id];
+#pragma unroll
+      for (int j = 0; j < 4; ++j) block_c[m][j] *= tw;
+    }
+
+    if constexpr (OUT_MODE == OUT_WS32) {
+      // Часткова сума шматка K у власну комірку: жодних атомарних додавань,
+      // зведення робить moe_reduce_kernel у фіксованому порядку.
+      float4* slot = reinterpret_cast<float4*>(
+          ws + ((int64_t)blockIdx.z * ws_rows + token_id) * size_n + n);
+      *slot = make_float4(block_c[m][0], block_c[m][1], block_c[m][2],
+                          block_c[m][3]);
+    } else if constexpr (OUT_MODE == OUT_PLAIN) {
+      // Увесь K в одній робочій групі: рядок token_id пише лише вона.
+      half2* out = reinterpret_cast<half2*>(c + (int64_t)token_id * size_n + n);
+      out[0] = __halves2half2(__float2half_rn(block_c[m][0]),
+                              __float2half_rn(block_c[m][1]));
+      out[1] = __halves2half2(__float2half_rn(block_c[m][2]),
+                              __float2half_rn(block_c[m][3]));
+    } else {
+      int64_t out_row = (output_topk > 0) ? (int64_t)(token_id / output_topk)
+                                          : (int64_t)token_id;
+      half* out = c + out_row * size_n + n;
+      half2 r01 = __halves2half2(__float2half_rn(block_c[m][0]),
+                                 __float2half_rn(block_c[m][1]));
+      half2 r23 = __halves2half2(__float2half_rn(block_c[m][2]),
+                                 __float2half_rn(block_c[m][3]));
+      atomic_add_pk4_f16(out, r01, r23);
+    }
+  }
+}
+
+// Зведення часткових сум: out[r, n] = sum_{j<group} sum_{s<splits}
+// src[s][r*group + j][n], порядок фіксований (спершу j, потім s), накопичення
+// в fp32, одне округлення до fp16 наприкінці. Рядки, до яких не дійшов жоден
+// блок (чужі експерти, expert_map), у src обнулені в moe_gemm_rdna2 (make_ws
+// при rows_covered=false); при rows_covered=true таких рядків немає.
+// Сітка: x - рядок виводу (межа gridDim.x величезна, на відміну від y),
+// y - плитка стовпців.
+template <typename T>
+__global__ void moe_reduce_kernel(const T* __restrict__ src,
+                                  half* __restrict__ c, const int splits,
+                                  const int src_rows, const int out_rows,
+                                  const int size_n, const int group) {
+  // Блок: REDUCE_QUADS четвірок стовпців x REDUCE_LANES смуг уздовж
+  // (j, s). Смуга l бере доданки l, l + LANES, ...; смуги складаються в
+  // фіксованому порядку через LDS, тож результат не залежить від планування.
+  __shared__ float lane_sum[REDUCE_LANES][REDUCE_QUADS][4];
+  const int quads = size_n / 4;
+  const int lane = threadIdx.x / REDUCE_QUADS;
+  const int q = blockIdx.y * REDUCE_QUADS + threadIdx.x % REDUCE_QUADS;
+  const int64_t r = blockIdx.x;
+  const int n = q * 4;
+  const int terms = group * splits;
+
+  float acc[4] = {0.f, 0.f, 0.f, 0.f};
+  if (q < quads) {
+    for (int i = lane; i < terms; i += REDUCE_LANES) {
+      const int j = i / splits;
+      const int s = i - j * splits;
+      const T* p = src + ((int64_t)s * src_rows + r * group + j) * size_n + n;
+      if constexpr (sizeof(T) == 4) {
+        const float4 v = *reinterpret_cast<const float4*>(p);
+        acc[0] += v.x; acc[1] += v.y; acc[2] += v.z; acc[3] += v.w;
+      } else {
+        const half2 v01 = reinterpret_cast<const half2*>(p)[0];
+        const half2 v23 = reinterpret_cast<const half2*>(p)[1];
+        acc[0] += __low2float(v01); acc[1] += __high2float(v01);
+        acc[2] += __low2float(v23); acc[3] += __high2float(v23);
+      }
+    }
+  }
+#pragma unroll
+  for (int i = 0; i < 4; ++i) lane_sum[lane][threadIdx.x % REDUCE_QUADS][i] = acc[i];
+  __syncthreads();
+  if (lane != 0 || q >= quads) return;
+  const int tq = threadIdx.x % REDUCE_QUADS;
+  float tot[4] = {0.f, 0.f, 0.f, 0.f};
+#pragma unroll
+  for (int l = 0; l < REDUCE_LANES; ++l) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) tot[i] += lane_sum[l][tq][i];
+  }
+  half2* out = reinterpret_cast<half2*>(c + r * size_n + n);
+  out[0] = __halves2half2(__float2half_rn(tot[0]), __float2half_rn(tot[1]));
+  out[1] = __halves2half2(__float2half_rn(tot[2]), __float2half_rn(tot[3]));
+}
+
+template <int BLOCK_SIZE_M, int OUT_MODE>
+void launch(const half* a, half* c, const uint32_t* b_q_weight,
+            const half* b_scales, const uint32_t* b_qzeros,
+            const float* topk_weights, const int32_t* sorted_token_ids,
+            const int32_t* expert_ids, const int32_t* num_tokens_post_padded,
+            int num_token_blocks, int size_m, int size_n, int size_k,
+            int groups, int top_k, int expert_weight_stride,
+            int expert_scales_stride, int expert_zeros_stride,
+            bool mul_topk_weight, int output_topk, int zero_offset, float* ws,
+            int chunks_per_block, int splits, hipStream_t stream) {
+  dim3 block(THREADS_X);
+  dim3 grid(num_token_blocks,
+            (size_n + BLOCK_KN_SIZE * 4 - 1) / (BLOCK_KN_SIZE * 4), splits);
+  moe_gemm_q4_kernel_rdna2<BLOCK_SIZE_M, OUT_MODE><<<grid, block, 0, stream>>>(
+      a, c, b_q_weight, b_scales, b_qzeros, topk_weights, sorted_token_ids,
+      expert_ids, num_tokens_post_padded, size_m, size_n, size_k, groups, top_k,
+      expert_weight_stride, expert_scales_stride, expert_zeros_stride,
+      mul_topk_weight, output_topk, zero_offset, ws, size_m * top_k,
+      chunks_per_block);
+}
+
+template <typename T>
+void launch_reduce(const T* src, half* c, int splits, int src_rows,
+                   int out_rows, int size_n, int group, hipStream_t stream) {
+  dim3 grid(out_rows, (size_n / 4 + REDUCE_QUADS - 1) / REDUCE_QUADS);
+  moe_reduce_kernel<T><<<grid, REDUCE_QUADS * REDUCE_LANES, 0, stream>>>(
+      src, c, splits, src_rows, out_rows, size_n, group);
+}
+
+// Скільки робочих груп бажано мати на запуску, щоб заповнити карту: на
+// декоді блоків токенів мало, тож K розщеплюється аж до одного шматка на
+// групу; на префілі їх тисячі, і розщеплення не потрібне.
+// Обмеження: число розщеплень залежить від num_token_blocks, тобто від
+// розміру пакета. Детермінізм означає «ті самі входи (з тим самим M) дають
+// той самий вихід»; той самий токен у пакетах різного розміру може дати інші
+// біти (інший порядок fp32-додавання).
+constexpr int kTargetGroups = 1024;
+
+}  // namespace
+
+// a                      [M, K] або [M*top_k, K]  fp16
+// c                      [M*top_k, N] fp16 (або [M, N] при output_topk > 0);
+//                        deterministic: пишеться, обнулення не потрібне
+//                        (рядки, яких не торкнувся жоден блок, лишаються як є
+//                        лише при одному розщепленні без output_topk);
+//                        інакше ОБНУЛЕНИЙ заздалегідь (атомарні додавання)
+// rows_covered           true: кожен рядок (токен, експерт) обчислює якийсь
+//                        блок (expert_map немає), робочий буфер не обнуляти
+// deterministic          true: fp32-часткові суми + зведення в фіксованому
+//                        порядку; false: атомарні fp16-додавання
+// b_q_weight             [E, K/8, N]              int32 (exllama-перемішані)
+// b_scales               [E, groups, N]           fp16
+// b_qzeros               [E, groups, N/8]         int32 (пакет 4-бітних)
+// topk_weights           [M*top_k] fp32 або порожній
+// zero_offset            0: збережено справжню zp; 1: збережено zp-1 (GPTQ v1)
+void moe_gemm_rdna2(torch::Tensor a, torch::Tensor c, torch::Tensor b_q_weight,
+                    torch::Tensor b_scales, torch::Tensor b_qzeros,
+                    torch::Tensor topk_weights, torch::Tensor sorted_token_ids,
+                    torch::Tensor expert_ids,
+                    torch::Tensor num_tokens_post_padded, int64_t top_k,
+                    int64_t block_size_m, bool mul_topk_weight,
+                    int64_t output_topk, int64_t zero_offset,
+                    bool deterministic, bool rows_covered) {
+  TORCH_CHECK(a.is_cuda() && c.is_cuda() && b_q_weight.is_cuda(),
+              "moe_gemm_rdna2: тензори мусять бути на GPU");
+  TORCH_CHECK(a.dim() == 2 && c.dim() == 2, "a і c мусять бути 2D");
+  TORCH_CHECK(b_q_weight.dim() == 3 && b_scales.dim() == 3 &&
+                  b_qzeros.dim() == 3,
+              "b_q_weight, b_scales, b_qzeros мусять бути 3D");
+  TORCH_CHECK(a.scalar_type() == torch::kHalf &&
+                  b_scales.scalar_type() == torch::kHalf &&
+                  c.scalar_type() == torch::kHalf,
+              "moe_gemm_rdna2: лише fp16 (на gfx1030 немає bf16-dot)");
+  TORCH_CHECK(a.is_contiguous() && c.is_contiguous() &&
+                  b_q_weight.is_contiguous() && b_scales.is_contiguous() &&
+                  b_qzeros.is_contiguous(),
+              "moe_gemm_rdna2: тензори мусять бути суцільними");
+  TORCH_CHECK(zero_offset == 0 || zero_offset == 1, "zero_offset: 0 або 1");
+  TORCH_CHECK(top_k >= 1, "top_k >= 1");
+
+  const int size_m = (int)a.size(0);
+  const int size_k = (int)a.size(1);
+  const int size_n = (int)b_q_weight.size(2);
+  const int groups = (int)b_scales.size(1);
+  TORCH_CHECK(b_q_weight.size(1) * 8 == size_k, "b_q_weight: K/8 не збігається");
+  TORCH_CHECK(size_n % 8 == 0, "N мусить ділитися на 8");
+  TORCH_CHECK(groups > 0 && size_k % groups == 0 && (size_k / groups) % 32 == 0,
+              "розмір групи мусить ділити K і ділитися на 32");
+  TORCH_CHECK(b_scales.size(2) == size_n && b_qzeros.size(1) == groups &&
+                  b_qzeros.size(2) * 8 == size_n,
+              "форми scales/qzeros не збігаються з b_q_weight");
+  TORCH_CHECK(c.size(1) == size_n, "c: N не збігається");
+
+  const int num_token_blocks = (int)(sorted_token_ids.size(0) / block_size_m);
+  if (num_token_blocks == 0 || size_m == 0) {
+    // Порожній пакет: нічого рахувати (і ділити на num_token_blocks нічого).
+    // Детермінований режим перезаписує c, тож лишаємо його визначеним.
+    if (c.numel() > 0) c.zero_();
+    return;
+  }
+
+  // Охоронця пристрою не береться: у збірці torch під ROCm його немає
+  // (див. gdn_fused_ext.hip); викликач вибирає пристрій сам.
+  hipStream_t stream = at::hip::getCurrentHIPStream();
+
+  const float* topk_w_ptr =
+      (topk_weights.numel() > 0) ? topk_weights.data_ptr<float>() : nullptr;
+
+  // Розщеплення K. Детермінований режим: кожна група пише свою часткову суму
+  // у власну комірку (fp32), а зводить їх окреме ядро в фіксованому порядку.
+  // Кількість розщеплень залежить лише від форм, тож однакові входи завжди
+  // дають однаковий розподіл роботи й однаковий результат.
+  const int k_chunks = (size_k + BLOCK_KN_SIZE - 1) / BLOCK_KN_SIZE;
+  const int grid_y = (size_n + BLOCK_KN_SIZE * 4 - 1) / (BLOCK_KN_SIZE * 4);
+  int splits = k_chunks;
+  int chunks_per_block = 1;
+  if (deterministic) {
+    const int want =
+        (kTargetGroups + num_token_blocks * grid_y - 1) / (num_token_blocks * grid_y);
+    splits = std::max(1, std::min(k_chunks, want));
+    chunks_per_block = (k_chunks + splits - 1) / splits;
+    splits = (k_chunks + chunks_per_block - 1) / chunks_per_block;
+  }
+  const int src_rows = size_m * (int)top_k;
+  const int out_rows = (int)c.size(0);
+  const int group = output_topk > 0 ? (int)output_topk : 1;
+  TORCH_CHECK(c.size(0) <= 0x7fffffff, "moe_gemm_rdna2: забагато рядків виводу");
+  TORCH_CHECK(src_rows == out_rows * group,
+              "moe_gemm_rdna2: рядки c не збігаються з size_m * top_k");
+
+  // Рядки, до яких не дійде жоден блок (чужі експерти при expert_map), мусять
+  // бути нулями; коли викликач ручається, що покрито всі (expert_map немає),
+  // обнулення пропускається.
+  auto make_ws = [&](at::IntArrayRef shape, c10::ScalarType type) {
+    const auto opts = a.options().dtype(type);
+    return rows_covered ? torch::empty(shape, opts) : torch::zeros(shape, opts);
+  };
+  // Один K-шматок із output_topk > 0 (префіл): внески output_topk експертів
+  // округлюються до fp16 у ws перед зведенням. Це рівень шляху Triton (fp16 на
+  // експерта + moe_sum). Пам'ять: size_m * top_k * size_n * 2 Б, напр.
+  // 8192 * 8 * 2816 * 2 = 369 МБ для Gemma 4. Розмір залежить лише від форм,
+  // тож профілювальний прогін (max_num_batched_tokens) проходить цим самим
+  // шляхом, і пік потрапляє в бюджет KV.
+  torch::Tensor ws;
+  if (deterministic && splits > 1) {
+    ws = make_ws({splits, src_rows, size_n}, torch::kFloat32);
+  } else if (deterministic && output_topk > 0) {
+    ws = make_ws({src_rows, size_n}, torch::kHalf);
+  }
+  float* ws32 = (deterministic && splits > 1) ? ws.data_ptr<float>() : nullptr;
+  half* gemm_out = (deterministic && splits == 1 && output_topk > 0)
+                       ? (half*)ws.data_ptr()
+                       : (half*)c.data_ptr();
+
+#define LAUNCH(BM, MODE)                                                      \
+  launch<BM, MODE>((const half*)a.data_ptr(), gemm_out,                       \
+             (const uint32_t*)b_q_weight.data_ptr<int32_t>(),                 \
+             (const half*)b_scales.data_ptr(),                                \
+             (const uint32_t*)b_qzeros.data_ptr<int32_t>(), topk_w_ptr,       \
+             sorted_token_ids.data_ptr<int32_t>(),                            \
+             expert_ids.data_ptr<int32_t>(),                                  \
+             num_tokens_post_padded.data_ptr<int32_t>(), num_token_blocks,    \
+             size_m, size_n, size_k, groups, (int)top_k,                      \
+             (int)(b_q_weight.size(1) * b_q_weight.size(2)),                  \
+             (int)(b_scales.size(1) * b_scales.size(2)),                      \
+             (int)(b_qzeros.size(1) * b_qzeros.size(2)), mul_topk_weight,     \
+             (int)output_topk, (int)zero_offset, ws32, chunks_per_block,      \
+             splits, stream)
+#define DISPATCH_BM(MODE)                                                     \
+  switch (block_size_m) {                                                     \
+    case 1: LAUNCH(1, MODE); break;                                           \
+    case 2: LAUNCH(2, MODE); break;                                           \
+    case 4: LAUNCH(4, MODE); break;                                           \
+    case 8: LAUNCH(8, MODE); break;                                           \
+    default:                                                                  \
+      TORCH_CHECK(false, "moe_gemm_rdna2: block_size_m мусить бути 1, 2, 4 або 8, ", \
+                  "отримано ", block_size_m);                                 \
+  }
+
+  if (!deterministic) {
+    DISPATCH_BM(OUT_ATOMIC)
+  } else if (splits > 1) {
+    DISPATCH_BM(OUT_WS32)
+    launch_reduce<float>(ws32, (half*)c.data_ptr(), splits, src_rows, out_rows,
+                         size_n, group, stream);
+  } else {
+    DISPATCH_BM(OUT_PLAIN)
+    if (output_topk > 0) {
+      launch_reduce<half>((const half*)ws.data_ptr(), (half*)c.data_ptr(), 1,
+                          src_rows, out_rows, size_n, group, stream);
+    }
+  }
+#undef DISPATCH_BM
+#undef LAUNCH
+  const hipError_t err = hipGetLastError();
+  TORCH_CHECK(err == hipSuccess,
+              "moe_gemm_rdna2: запуск не вдався: ", hipGetErrorString(err));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("moe_gemm", &moe_gemm_rdna2,
+        "Злите MoE W4A16 fp16 ядро для gfx1030 (маршрутизація + деквант + dot)",
+        py::arg("a"), py::arg("c"), py::arg("b_q_weight"), py::arg("b_scales"),
+        py::arg("b_qzeros"), py::arg("topk_weights"),
+        py::arg("sorted_token_ids"), py::arg("expert_ids"),
+        py::arg("num_tokens_post_padded"), py::arg("top_k"),
+        py::arg("block_size_m"), py::arg("mul_topk_weight"),
+        py::arg("output_topk"), py::arg("zero_offset"),
+        py::arg("deterministic") = true, py::arg("rows_covered") = false);
+}
