+# ----------------------------------------------------------------------
+# 5b. Direct HIP Kernel Batch Independence (isolating RHT wrapper GEMM)
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "config",
+    ALL_CONFIGS,
+    ids=[c[0] for c in ALL_CONFIGS],
+)
+@pytest.mark.parametrize("block_size", [16, 32])
+def test_direct_hip_kernel_batch_independence(config, block_size):
+    """Specification 5 (direct HIP kernel): Tests the underlying int4_prefill_attn HIP
+    kernel directly to verify that the kernel's attention computation is strictly bitwise batch-invariant.
+    """
+    _, head_size, num_qh, num_kvh, window_size = config
+    seq_len_A, q_len_A = 73, 17
+    seq_len_B, q_len_B = 125, 8
+    num_blocks_A = (seq_len_A + block_size - 1) // block_size
+    num_blocks_B = (seq_len_B + block_size - 1) // block_size
+    total_blocks = num_blocks_A + num_blocks_B
+
+    torch.manual_seed(42)
+    k_A = torch.randn(seq_len_A, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v_A = torch.randn(seq_len_A, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q_A = torch.randn(q_len_A, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_B = torch.randn(seq_len_B, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v_B = torch.randn(seq_len_B, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q_B = torch.randn(q_len_B, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        total_blocks, block_size, num_kvh, head_size
+    )
+
+    slot_mapping_A = torch.arange(seq_len_A, dtype=torch.int64, device=DEVICE)
+    slot_mapping_B = torch.arange(seq_len_B, dtype=torch.int64, device=DEVICE) + num_blocks_A * block_size
+
+    reshape_and_cache_int4(
+        k_A, v_A, k_cache, v_cache, slot_mapping_A,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+    reshape_and_cache_int4(
+        k_B, v_B, k_cache, v_cache, slot_mapping_B,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = (1.0 / math.sqrt(head_size)) / head_size
+
+    # Prepare Q_i8 and Q_scale for A
+    q_rht_A = single_rht(q_A)
+    bits = 8
+    levels = (1 << (bits - 1)) - 1
+    amax_A = q_rht_A.abs().amax(dim=-1, keepdim=True)
+    q_scale_A = (amax_A.float() / float(levels)).clamp(min=1e-20)
+    q_div_A = q_scale_A.clamp(min=6.104e-5).to(q_rht_A.dtype)
+    q_i8_A = torch.clamp(torch.round(q_rht_A / q_div_A), -levels - 1, levels).to(torch.int8)
+    q_scale_A = q_div_A.float().squeeze(-1).contiguous()
+
+    # Prepare Q_i8 and Q_scale for B
+    q_rht_B = single_rht(q_B)
+    amax_B = q_rht_B.abs().amax(dim=-1, keepdim=True)
+    q_scale_B = (amax_B.float() / float(levels)).clamp(min=1e-20)
+    q_div_B = q_scale_B.clamp(min=6.104e-5).to(q_rht_B.dtype)
+    q_i8_B = torch.clamp(torch.round(q_rht_B / q_div_B), -levels - 1, levels).to(torch.int8)
+    q_scale_B = q_div_B.float().squeeze(-1).contiguous()
+
+    out_A_alone = torch.empty(q_len_A, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+    cu_seqlens_q_A = torch.tensor([0, q_len_A], dtype=torch.int32, device=DEVICE)
+    seqused_k_A = torch.tensor([seq_len_A], dtype=torch.int32, device=DEVICE)
+    block_table_A = torch.arange(num_blocks_A, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+
+    launched_A = hip_prefill_mod.try_launch_int4_prefill_attn(
+        q=q_rht_A,
+        k_cache=k_cache,
+        v_cache=v_cache,
+        out=out_A_alone,
+        cu_seqlens_q=cu_seqlens_q_A,
+        seqused_k=seqused_k_A,
+        softmax_scale=softmax_scale,
+        window_size=window_size,
+        block_table=block_table_A,
+        softcap=None,
+        sinks=None,
+        alibi_slopes=None,
+        qq_bias=None,
+        output_scale=None,
+        mm_prefix_range=None,
+        k_scale_cache=k_scale_cache,
+        v_scale_cache=v_scale_cache,
+        packing_factor=2,
+        q_i8=q_i8_A,
+        q_scale=q_scale_A,
+        w4a8=True,
+        num_query_heads=num_qh,
+        num_kv_heads=num_kvh,
+        num_queries_per_kv=num_qh // num_kvh,
+        head_size=head_size,
+        block_size=block_size,
+        num_seqs=1,
+    )
+    assert launched_A, "Direct HIP kernel launch failed for Seq A alone"
+
+    # Batch [A, B]
+    max_blocks = max(num_blocks_A, num_blocks_B)
+    block_table_AB = torch.zeros(2, max_blocks, dtype=torch.int32, device=DEVICE)
+    block_table_AB[0, :num_blocks_A] = torch.arange(num_blocks_A, dtype=torch.int32, device=DEVICE)
+    block_table_AB[1, :num_blocks_B] = torch.arange(num_blocks_A, total_blocks, dtype=torch.int32, device=DEVICE)
+
+    q_i8_AB = torch.cat([q_i8_A, q_i8_B], dim=0)
+    q_scale_AB = torch.cat([q_scale_A, q_scale_B], dim=0)
+    q_rht_AB = torch.cat([q_rht_A, q_rht_B], dim=0)
+    out_AB = torch.empty(q_len_A + q_len_B, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+    cu_seqlens_q_AB = torch.tensor([0, q_len_A, q_len_A + q_len_B], dtype=torch.int32, device=DEVICE)
+    seqused_k_AB = torch.tensor([seq_len_A, seq_len_B], dtype=torch.int32, device=DEVICE)
+
+    launched_AB = hip_prefill_mod.try_launch_int4_prefill_attn(
+        q=q_rht_AB,
+        k_cache=k_cache,
+        v_cache=v_cache,
+        out=out_AB,
+        cu_seqlens_q=cu_seqlens_q_AB,
+        seqused_k=seqused_k_AB,
+        softmax_scale=softmax_scale,
+        window_size=window_size,
+        block_table=block_table_AB,
+        softcap=None,
+        sinks=None,
+        alibi_slopes=None,
+        qq_bias=None,
+        output_scale=None,
+        mm_prefix_range=None,
+        k_scale_cache=k_scale_cache,
+        v_scale_cache=v_scale_cache,
+        packing_factor=2,
+        q_i8=q_i8_AB,
+        q_scale=q_scale_AB,
+        w4a8=True,
+        num_query_heads=num_qh,
+        num_kv_heads=num_kvh,
+        num_queries_per_kv=num_qh // num_kvh,
+        head_size=head_size,
+        block_size=block_size,
+        num_seqs=2,
+    )
+    assert launched_AB, "Direct HIP kernel launch failed for Batch [A, B]"
+
+    assert torch.equal(out_AB[:q_len_A], out_A_alone), (
+        f"Direct HIP prefill attention kernel failed bitwise batch independence: "
+        f"max diff = {(out_AB[:q_len_A] - out_A_alone).abs().max().item()}"
+    )
