+        [(1, 1500)],  # decode, window cuts part of the context
+        [(1, 1024)],  # decode, context exactly equals the window
+        [(1, 2500), (1, 3000)],  # batched decode
+        [(256, 2200)],  # prefill with a long cached prefix
+        [(1, 2200), (64, 1800)],  # mixed decode + prefill
+    ],
+    ids=["dec1500", "dec1024", "dec2x", "prefill", "mixed"],
+)
+@pytest.mark.parametrize("window", [1024])
+@torch.inference_mode()
+def test_int4_unified_attention_sliding_window(
+    monkeypatch,
+    seq_lens: list[tuple[int, int]],
+    window: int,
+    use_3d: bool,
+    pv_int8: str,
+):
+    """INT4 KV attention with window_size=(W-1, 0): compiles, matches the
+    dequantized fp16 reference with the same window, and really applies the
+    window (differs from the unwindowed result)."""
+    from vllm.utils.math_utils import next_power_of_2
+    from vllm.v1.attention.ops.triton_unified_attention import unified_attention
+
+    monkeypatch.setenv("VLLM_ROCM_INT4_PV_INT8", pv_int8)
+
+    head_size = 256
+    num_query_heads, num_kv_heads = 8, 2
+    block_size = 16
+    num_seqs = len(seq_lens)
+    query_lens = [s[0] for s in seq_lens]
+    kv_lens = [s[1] for s in seq_lens]
+    max_query_len, max_kv_len = max(query_lens), max(kv_lens)
+    scale = head_size**-0.5
+    dtype = torch.float16  # bf16 is unsupported on RDNA2; W4A8 needs fp16
+
+    torch.set_default_device(DEVICE_TYPE)
+    set_random_seed(0)
+
+    max_blocks = (max_kv_len + block_size - 1) // block_size
+    num_blocks = num_seqs * max_blocks + 3
+    block_tables = torch.randperm(num_blocks, dtype=torch.int32)[
+        : num_seqs * max_blocks
+    ].reshape(num_seqs, max_blocks)
+
+    # Logical K/V per sequence. V carries a ramp over the position so that the
+    # window (which drops the oldest tokens) shifts the output noticeably.
+    k_cache_q = torch.zeros(
+        num_blocks, block_size, num_kv_heads, head_size // 2, dtype=torch.uint8
+    )
+    v_cache_q = torch.zeros_like(k_cache_q)
+    k_sc = torch.ones(num_blocks, block_size, num_kv_heads, dtype=torch.float32)
+    v_sc = torch.ones_like(k_sc)
+    k_deq = torch.zeros(
+        num_blocks, block_size, num_kv_heads, head_size, dtype=torch.float32
+    )
+    v_deq = torch.zeros_like(k_deq)
+    for s, kv_len in enumerate(kv_lens):
+        k_log = torch.randn(kv_len, num_kv_heads, head_size)
+        v_log = torch.randn(kv_len, num_kv_heads, head_size)
+        v_log = v_log + 3.0 * torch.arange(kv_len)[:, None, None] / max_kv_len
+        kp, ks, kd = _int4_quantize_rht_cache(k_log, head_size)
+        vp, vs, vd = _int4_quantize_rht_cache(v_log, head_size)
+        pos = torch.arange(kv_len)
+        blk = block_tables[s].long()[pos // block_size]
+        off = pos % block_size
+        k_cache_q[blk, off] = kp
+        v_cache_q[blk, off] = vp
+        k_sc[blk, off] = ks
+        v_sc[blk, off] = vs
+        k_deq[blk, off] = kd
+        v_deq[blk, off] = vd
+
+    query = (1.0 * torch.randn(sum(query_lens), num_query_heads, head_size)).to(dtype)
+    cu_query_lens = torch.tensor([0] + query_lens, dtype=torch.int32).cumsum(
+        dim=0, dtype=torch.int32
+    )
+    kv_lens_t = torch.tensor(kv_lens, dtype=torch.int32)
+
+    seq_threshold_3D = max(num_seqs, sum(query_lens)) if use_3d else 0
+    nseg = 16
+    hp = next_power_of_2(head_size)
+    segm_out = torch.empty(
+        (seq_threshold_3D, num_query_heads, nseg, hp), dtype=torch.float32
+    )
+    segm_max = torch.empty((seq_threshold_3D, num_query_heads, nseg), dtype=torch.float32)
+    segm_sum = torch.empty_like(segm_max)
+
+    def run(win, quantized):
+        out = torch.empty_like(query)
+        kw = dict(
+            q=query,
+            k=k_cache_q if quantized else k_deq.to(dtype),
+            v=v_cache_q if quantized else v_deq.to(dtype),
+            out=out,
+            cu_seqlens_q=cu_query_lens,
+            seqused_k=kv_lens_t,
+            max_seqlen_q=max_query_len,
+            max_seqlen_k=max_kv_len,
+            softmax_scale=scale,
+            causal=True,
+            window_size=win,
+            block_table=block_tables,
+            softcap=0,
+            q_descale=None,
+            k_descale=None,
+            v_descale=None,
+            seq_threshold_3D=seq_threshold_3D,
+            num_par_softmax_segments=nseg,
+            softmax_segm_output=segm_out,
+            softmax_segm_max=segm_max,
+            softmax_segm_expsum=segm_sum,
+        )
+        if quantized:
+            kw.update(
+                kv_quant_mode=KVQuantMode.INT4_PER_TOKEN_HEAD,
+                k_scale_cache=k_sc,
+                v_scale_cache=v_sc,
+            )
+        unified_attention(**kw)
+        return out.float()
+
+    win = (window - 1, 0)
+    out_q = run(win, True)
+    torch.cuda.synchronize()
+    out_ref = run(win, False)
+    out_q_nowin = run((-1, -1), True)
+    out_ref_nowin = run((-1, -1), False)
+
+    assert torch.isfinite(out_q).all(), "non-finite output with sliding window"
+
+    err = (out_q - out_ref).abs().max().item()
+    window_effect = (out_ref - out_ref_nowin).abs().max().item()
+    window_effect_q = (out_q - out_q_nowin).abs().max().item()
+    err_nowin = (out_q_nowin - out_ref_nowin).abs().max().item()
+    print(
+        f"[swa int4] seqs={seq_lens} 3d={use_3d} pv_int8={pv_int8} "
+        f"max|q-ref|={err:.4f} max|q-ref|(no window)={err_nowin:.4f} window_effect(ref)={window_effect:.4f} "
+        f"window_effect(int4)={window_effect_q:.4f}"
+    )
+
+    # Spec 2: the same tolerance as the existing INT4 test.
+    torch.testing.assert_close(out_q, out_ref, atol=0.5, rtol=0.5)
+    if pv_int8 == "0":
+        # The fp16 P.V path is accurate to ~0.01 on this data; a tight bound
+        # catches an off-by-a-few-tokens window that the 0.5 tolerance misses.
+        assert err < 0.03, f"fp16 P.V path off by {err} (window edge?)"
+    # Spec 3: the window must really be applied (unless the context fits it).
+    if max(kv_lens) > window:
+        assert window_effect > 0.2, "reference barely changes: test is vacuous"
+        assert window_effect_q > 0.2, "INT4 kernel ignores the sliding window"
+        # The windowed error must stay at the level of plain INT4 noise
+        # (the unwindowed error on the same data) and be well below the
+        # effect of the window itself.
+        assert err < 1.5 * err_nowin + 0.1
+        assert err < window_effect
