+    _SPEC_N_STEPS += 1
+    n = _envs.VLLM_ROCM_TIME_SPEC
+    if _SPEC_N_STEPS % n:
+        return
+    total = sum(_SPEC_T.values())
+    parts = " ".join(
+        f"{k}={v / n * 1e3:.2f}"
+        for k, v in sorted(_SPEC_T.items(), key=lambda kv: -kv[1])
+    )
+    logger.info(
+        "[TIME_SPEC] вікно=%d (виклики %d..%d) усього=%.2f мс/виклик | %s",
+        n,
+        _SPEC_N_STEPS - n + 1,
+        _SPEC_N_STEPS,
+        total / n * 1e3,
+        parts,
+    )
+    _SPEC_T.clear()
