diff --git a/vllm/v1/sample/logits_processor/anti_stutter.py b/vllm/v1/sample/logits_processor/anti_stutter.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a9fba080a6dcf36ce4b463a911689ce2fbbe69c
--- /dev/null
+++ b/vllm/v1/sample/logits_processor/anti_stutter.py
@@ -0,0 +1,182 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Заборона негайного повтору того самого підслова («анти-заїкання»).
+
+Навіщо. На gfx1030 з 4-бітною Qwen3.8-27B українська псується здвоєними
+шматками слів: «' кро'+' кро'», «' Без'+' без'», «' еле'+'еле'». Механізм —
+шум квантизації в РІДКІСНОМУ хвості розподілу (частота злипання росте з ID
+токена майже стократно). Цей процесор не лікує причину, а забороняє саме той
+хід, яким шкода проявляється: після токена X заборонити токен Y, у якого
+однакова з X нормальна форма (без початкового пробілу, без регістру).
+
+⚠️ ЧЕСНО ПРО МЕЖУ ЦЬОГО ЗАСОБУ. Метрика «злипань» ловить рівно ті пари, які
+це правило й вирізає, тож вона впаде до нуля майже за визначенням. Це НЕ
+доказ, що текст став кращий: модель просто візьме другий за ймовірністю
+токен, а він може бути так само зіпсутий (у журналі є «Приоб» замість
+«Приклад: щоб» — таке правило не чіпає). Оцінювати ТІЛЬКИ незалежною мірою
+`~/vllm-bench/неканон.py`, ніколи — лічильником злипань. На цю пастку я вже
+попадався зі штрафом за повтор: метрика впала в 3,6 раза, а частка зривів
+не змінилася зовсім.
+
+⚠️ ЦИФРИ Й РОЗМІТКУ НЕ ЧІПАЄМО. Замір на чистому тексті-еталоні (GGUF)
+показав, що правило спрацювало б 15 разів на 14 362 позиції, і 10 із них —
+це «'0'+'0'» у «1,000,000», «'5'+'5'» у «100+» і «'|'+' |'» у таблицях
+Markdown. Тобто без цього обмеження засіб ламав би числа й таблиці. Тому в
+групу потрапляють лише токени, що містять літеру.
+
+Вмикається так:
+    vllm serve ... --logits-processors \
+        vllm.v1.sample.logits_processor.anti_stutter:AntiStutter
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm import SamplingParams
+from vllm.logger import init_logger
+from vllm.v1.sample.logits_processor.interface import (
+    BatchUpdate,
+    LogitsProcessor,
+    MoveDirectionality,
+)
+
+logger = init_logger(__name__)
+
+# Позначки початку слова в різних токенізаторах: GPT-2 байтовий рівень,
+# SentencePiece, звичайний пробіл.
+_ПРЕФІКСИ = ("Ġ", "▁", " ")
+
+_SAMPLING_EPS = 1e-5
+
+
+def _нормальна_форма(токен: str) -> str | None:
+    """Спільний ключ для токенів, які є тим самим підсловом.
+
+    Повертає None, якщо токен НЕ належить чіпати: без літер (цифри,
+    розділові знаки, розмітка) або порожній після зняття префікса.
+    """
+    т = токен
+    for п in _ПРЕФІКСИ:
+        if т.startswith(п):
+            т = т[len(п) :]
+            break
+    т = т.strip()
+    if not т or not any(c.isalpha() for c in т):
+        return None
+    return т.lower()
+
+
+class AntiStutter(LogitsProcessor):
+    def __init__(
+        self, vllm_config, device: torch.device, is_pin_memory: bool
+    ) -> None:
+        self.device = device
+        self._зсуви: list[int] = []
+        self._члени: torch.Tensor | None = None
+        self._група_токена: list[int] = []
+        # індекс у пакеті -> (живий список вихідних токенів, чи жадібний)
+        self._запити: dict[int, tuple[list[int], bool]] = {}
+
+        from vllm.tokenizers.registry import get_tokenizer
+
+        mc = vllm_config.model_config
+        токенізатор = get_tokenizer(
+            mc.tokenizer,
+            trust_remote_code=mc.trust_remote_code,
+            revision=mc.tokenizer_revision,
+        )
+        розмір = mc.get_vocab_size()
+
+        ключ_до_групи: dict[str, int] = {}
+        члени: list[list[int]] = []
+        група_токена = torch.full((розмір,), -1, dtype=torch.int32)
+        # ⚠️ НЕ convert_ids_to_tokens: Qwen — байтовий BPE, і той повертає
+        # мохіто на кшталт 'ðºñģð¾' замість ' кро'. На такому рядку
+        # `.lower()` нічого не робить, і пара «' Без'+' без'» перестає
+        # збігатися, хоча саме заради неї все й затівалося. Декодуємо в
+        # СПРАВЖНІЙ текст.
+        рядки = токенізатор.batch_decode(
+            [[і] for і in range(розмір)], clean_up_tokenization_spaces=False
+        )
+        for ід, рядок in enumerate(рядки):
+            if not isinstance(рядок, str):
+                continue
+            ключ = _нормальна_форма(рядок)
+            if ключ is None:
+                continue
+            г = ключ_до_групи.get(ключ)
+            if г is None:
+                г = len(члени)
+                ключ_до_групи[ключ] = г
+                члени.append([])
+            члени[г].append(ід)
+            група_токена[ід] = г
+
+        зсуви = torch.zeros(len(члени) + 1, dtype=torch.int64)
+        плоско: list[int] = []
+        for г, сп in enumerate(члени):
+            плоско.extend(сп)
+            зсуви[г + 1] = len(плоско)
+
+        # ⚠️ Зсуви й мапу токен->група тримаємо НА ПРОЦЕСОРІ, а не на GPU.
+        # Індексуються вони пітонівським цілим (`вихід[-1]`), і якби лежали
+        # на карті, кожен крок генерації робив би зайву синхронізацію
+        # GPU->CPU, а зрізом `члени[зсуви[г]:зсуви[г+1]]` межі взагалі мають
+        # бути звичайними числами. На карті лишається тільки плоский список
+        # членів — саме він потрібен для запису -inf у логіти.
+        self._група_токена = група_токена.tolist()
+        self._зсуви = зсуви.tolist()
+        self._члени = torch.tensor(плоско, dtype=torch.int64, device=device)
+        logger.info(
+            "Анти-заїкання: %d груп, %d токенів у групах із %d словника",
+            len(члени),
+            len(плоско),
+            розмір,
+        )
+
+    def is_argmax_invariant(self) -> bool:
+        # Правило змінює вибір, тож на argmax впливає. Але жадібні запити ми
+        # свідомо НЕ чіпаємо (див. apply): при t=0 текст і так бездоганний.
+        return False
+
+    def update_state(self, batch_update: BatchUpdate | None) -> None:
+        if batch_update is None:
+            return
+        for і in batch_update.removed:
+            self._запити.pop(і, None)
+        for і, параметри, _промпт, вихід in batch_update.added:
+            жадібний = параметри.temperature < _SAMPLING_EPS
+            self._запити[і] = (вихід, жадібний)
+        for і1, і2, напрям in batch_update.moved:
+            а = self._запити.pop(і1, None)
+            б = self._запити.pop(і2, None)
+            if напрям is MoveDirectionality.SWAP:
+                if а is not None:
+                    self._запити[і2] = а
+                if б is not None:
+                    self._запити[і1] = б
+            else:
+                if а is not None:
+                    self._запити[і2] = а
+
+    def apply(self, logits: torch.Tensor) -> torch.Tensor:
+        if not self._запити:
+            return logits
+        група_токена = self._група_токена
+        зсуви = self._зсуви
+        члени = self._члени
+        пакет = logits.shape[0]
+        словник = len(група_токена)
+        for і, (вихід, жадібний) in self._запити.items():
+            if жадібний or not вихід or і >= пакет:
+                continue
+            попередній = вихід[-1]
+            if not 0 <= попередній < словник:
+                # Токен поза словником моделі (службовий чи доданий) — не наш
+                # клопіт, і індексувати ним мапу не можна.
+                continue
+            г = група_токена[попередній]
+            if г < 0:
+                continue
+            logits[і, члени[зсуви[г] : зсуви[г + 1]]] = float("-inf")
+        return logits
