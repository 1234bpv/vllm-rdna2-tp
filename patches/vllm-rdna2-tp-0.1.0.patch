+"""Шлях W4A4 для gfx1030: 4-бітні ваги й 4-бітні активації.
+
+Розширення збирається на першому виклику (`load_rdna_ext`),
+щоб не перезбирати весь vLLM заради правки в ядрі. Результат кешується.
+"""
+
+import os
+from functools import lru_cache
+
+from vllm.logger import init_logger
+
+logger = init_logger("vllm.w4a4")
+
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+@lru_cache(maxsize=1)
+def w4a4_ext():
+    """Зібрати (за потреби) і повернути розширення; None, якщо не вдалося."""
+    try:
+        from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+        ext = load_rdna_ext(
+            "vllm_w4a4_rdna",
+            # Джерело — w4a4_ext.hip. Якщо hipify щось замінить, він пише
+            # поруч w4a4_ext_hip.hip (лише коли вміст змінився): той файл
+            # згенерований (у .gitignore), правити його марно.
+            os.path.join(_DIR, "w4a4_ext.hip"),
+            ["-O3", "--offload-arch=gfx1030"],
+        )
+        logger.info("Розширення W4A4 зібрано й завантажено")
+        return ext
+    except Exception as e:  # збірка може не вдатися на іншій машині
+        logger.warning("W4A4 недоступний: %s", e)
+        return None
diff --git a/vllm/model_executor/kernels/linear/mixed_precision/w4a4/w4a4_ext.hip b/vllm/model_executor/kernels/linear/mixed_precision/w4a4/w4a4_ext.hip
new file mode 100644
index 0000000000000000000000000000000000000000..d9a97921dd59dc54b4dfda850a8d1629de4119a2
--- /dev/null
+++ b/vllm/model_executor/kernels/linear/mixed_precision/w4a4/w4a4_ext.hip
@@ -0,0 +1,809 @@
+// Розширення W4A4 для gfx1030: 4-бітні ваги (бойовий формат vLLM,
+// asymmetric pack-quantized) і 4-бітні активації, добуток через
+// v_dot8_u32_u4. Підвантажується з Python без перезбирання vLLM.
+//
+// Джерела прототипів і повний розбір — у ~/vllm-gfx1030/kernels/ та
+// docs/int4-gemm-hypotheses.md.
+#include <torch/extension.h>
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <hip/hip_fp16.h>
+#include <cstdlib>
+#include <cstring>
+
+#define GS 128
+#define WORDS (GS / 8)
+typedef int int2v __attribute__((ext_vector_type(2)));
+typedef int int4v __attribute__((ext_vector_type(4)));
+
+// Квантування активацій у 4 біти з масштабом НА ГРУПУ зі 128 значень.
+//
+// ⚠️ Раніше масштаб брався на весь рядок, і це руйнувало модель: заміряно
+// 01.09 на стенді 9B-AWQ — перплексія 168,7 проти 6,66. Причина в канальних
+// викидах: одне велике значення серед 5 120 піднімає sa = max|x|/7 так, що
+// решта падає у перший-другий рівень із шістнадцяти. Масштаб на групу (та
+// сама одиниця, що й у ваг) дає 8,15.
+//
+// Розкладка роботи: ОДНА ХВИЛЯ на пару (рядок, група). Смуга читає чотири
+// сусідні значення, тож хвиля покриває рівно 128 значень = 256 суцільних
+// байтів, і читання лишаються злитими. Максимум зводиться обміном між
+// смугами, без спільної пам'яті. Пакує перша половина хвилі: шістнадцять
+// смуг по одному слову з восьми напівбайтів.
+__global__ __launch_bounds__(256) void quant_groups(
+    const __half* __restrict__ X, int* __restrict__ Aq,
+    float* __restrict__ SAp, float* __restrict__ Sa, int M, int K) {
+  const int NG = K / GS, K8 = K / 8;
+  const long wv = ((long)blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+  const int lane = threadIdx.x & 31;
+  if (wv >= (long)M * NG) return;
+  const int m = (int)(wv / NG), g = (int)(wv - (long)m * NG);
+  const __half* base = X + (long)m * K + (long)g * GS;
+
+  // 1. Максимум за модулем по групі.
+  const __half2* b2 = (const __half2*)base;
+  __half2 v0 = b2[lane * 2], v1 = b2[lane * 2 + 1];
+  float mx = fmaxf(fmaxf(fabsf(__low2float(v0)), fabsf(__high2float(v0))),
+                   fmaxf(fabsf(__low2float(v1)), fabsf(__high2float(v1))));
+#pragma unroll
+  for (int sft = 16; sft; sft >>= 1)
+    mx = fmaxf(mx, __shfl_xor(mx, sft, 32));
+  const float sa = fmaxf(mx, 1e-8f) / 7.0f;
+  const float inv = 1.0f / sa;
+  if (lane == 0) Sa[(long)m * NG + g] = sa;
+
+  // 2. Пакування. Порядок напівбайтів exllama: позиція p слова несе shuf[p].
+  const int shuf[8] = {0, 2, 4, 6, 1, 3, 5, 7};
+  int gs = 0;
+  if (lane < WORDS) {
+    int word = 0;
+#pragma unroll
+    for (int p = 0; p < 8; ++p) {
+      float v = __half2float(base[lane * 8 + shuf[p]]) * inv;
+      int q = (int)rintf(v) + 8;
+      q = q < 0 ? 0 : (q > 15 ? 15 : q);
+      word |= q << (4 * p);
+      gs += q;
+    }
+    Aq[(long)m * K8 + (long)g * WORDS + lane] = word;
+  }
+#pragma unroll
+  for (int sft = 16; sft; sft >>= 1) gs += __shfl_xor(gs, sft, 32);
+  if (lane == 0) SAp[(long)m * NG + g] = (float)gs;
+}
+
+
+template <int BM, int BN, int TM, int TN>
+__global__ __launch_bounds__(256) void gemm_prod(
+    const int* __restrict__ A,     // [M, K/8] беззнакові напівбайти a'
+    const int* __restrict__ B,     // [N, K/8] беззнакові напівбайти q
+    const float* __restrict__ SAp, // [M, NG] суми a' по групі
+    const __half* __restrict__ Sw, // [N, NG] масштаби ваг (fp16, як у vLLM)
+    const __half* __restrict__ Zp, // [N, NG] нульові точки (fp16)
+    const short* __restrict__ E,   // [N, NG] поправка 8*(G*zp - Sq), ціла
+    const float* __restrict__ Sa,  // [M, NG] масштаб активацій на групу
+    __half* __restrict__ C, int M, int N, int K) {
+  const int K8 = K / 8, NG = K / GS;
+  const int tid = threadIdx.x;
+  const int nthr = BM * BN / (TM * TN);
+  const int STM = BM / TM, STN = BN / TN;
+  const int tm = tid / STN, tn = tid % STN;
+  const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+  const int PA = BM * 2 * WORDS / nthr, PB = BN * 2 * WORDS / nthr;
+  const int W4 = 2 * WORDS / 4, rowsA = nthr / W4;
+
+  // ⚠️ sA і суми активацій — ОДИНАРНІ буфери, sB і масштаби ваг — подвійні.
+  // Заміряно 01.09: одинарний sA дає 54,8 ТОпс проти 52,1 у прототипі
+  // (+5,2% при розкиді 0,15%), причому зайнятість НЕ змінюється — вона й далі
+  // один блок на CU. Виграш не від зайнятості, а від простішої адресації:
+  // зникає доданок cur*BM*34 у кожному читанні sA.
+  // ⚠️ Одинарними ОБИДВА робити не можна (32,8 ТОпс), і доповнення рядків
+  // прибирати не можна (11,2 ТОпс) — обидва заміряно.
+  __shared__ __align__(8) int sA[BM][2 * WORDS + 2];
+  __shared__ __align__(8) int sB[2][BN][2 * WORDS + 2];
+  __shared__ float sSA[2][BM], sSa[2][BM];
+  __shared__ float sSw[2][2][BN], sZp[2][2][BN], sE[2][2][BN];
+
+  float fout[TM][TN];
+#pragma unroll
+  for (int i = 0; i < TM; ++i)
+#pragma unroll
+    for (int j = 0; j < TN; ++j) fout[i][j] = 0.f;
+
+  int4v ra[(PA / 4) > 0 ? (PA / 4) : 1], rb[(PB / 4) > 0 ? (PB / 4) : 1];
+
+#pragma unroll
+  for (int k = 0; k < PA / 4; ++k) {
+    int r = tid / W4 + k * rowsA, w = (tid % W4) * 4, m = m0 + r;
+    int4v v = (m < M) ? *(const int4v*)(&A[(long)m * K8 + w]) : (int4v)(0);
+#pragma unroll
+    for (int e = 0; e < 4; ++e) sA[r][w + e] = v[e];
+  }
+#pragma unroll
+  for (int k = 0; k < PB / 4; ++k) {
+    int r = tid / W4 + k * rowsA, w = (tid % W4) * 4, n = n0 + r;
+    int4v v = (n < N) ? *(const int4v*)(&B[(long)n * K8 + w]) : (int4v)(0);
+#pragma unroll
+    for (int e = 0; e < 4; ++e) sB[0][r][w + e] = v[e];
+  }
+  for (int t = tid; t < 2 * BM; t += nthr) {
+    int gg = t / BM, r = t % BM, m = m0 + r;
+    sSA[gg][r] = (m < M) ? SAp[(long)m * NG + gg] : 0.f;
+    sSa[gg][r] = (m < M) ? Sa[(long)m * NG + gg] : 0.f;
+  }
+  for (int t = tid; t < 2 * BN; t += nthr) {
+    int gg = t / BN, r = t % BN, n = n0 + r;
+    sSw[0][gg][r] = (n < N) ? __half2float(Sw[(long)n * NG + gg]) : 0.f;
+    sZp[0][gg][r] = (n < N) ? __half2float(Zp[(long)n * NG + gg]) : 0.f;
+    sE[0][gg][r] = (n < N) ? (float)E[(long)n * NG + gg] : 0.f;
+  }
+  __syncthreads();
+
+  for (int g = 0; g < NG; g += 2) {
+    const int cur = (g >> 1) & 1, nxt = cur ^ 1;
+    if (g + 2 < NG) {
+      __builtin_amdgcn_s_setprio(1);
+#pragma unroll
+      for (int k = 0; k < PA / 4; ++k) {
+        int r = tid / W4 + k * rowsA, w = (tid % W4) * 4, m = m0 + r;
+        ra[k] = (m < M) ? *(const int4v*)(&A[(long)m * K8 + (g + 2) * WORDS + w])
+                        : (int4v)(0);
+      }
+#pragma unroll
+      for (int k = 0; k < PB / 4; ++k) {
+        int r = tid / W4 + k * rowsA, w = (tid % W4) * 4, n = n0 + r;
+        rb[k] = (n < N) ? *(const int4v*)(&B[(long)n * K8 + (g + 2) * WORDS + w])
+                        : (int4v)(0);
+      }
+      __builtin_amdgcn_s_setprio(0);
+    }
+
+#pragma unroll 1
+    for (int gg = 0; gg < 2 && g + gg < NG; ++gg) {
+      int acc[TM][TN];
+#pragma unroll
+      for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j) acc[i][j] = 0;
+#pragma unroll 1
+      for (int w = gg * WORDS; w < (gg + 1) * WORDS; w += 2) {
+        int2v av[TM], bv[TN];
+#pragma unroll
+        for (int i = 0; i < TM; ++i) av[i] = *(const int2v*)(&sA[tm + i * STM][w]);
+#pragma unroll
+        for (int j = 0; j < TN; ++j) bv[j] = *(const int2v*)(&sB[cur][tn + j * STN][w]);
+#pragma unroll
+        for (int i = 0; i < TM; ++i)
+#pragma unroll
+          for (int j = 0; j < TN; ++j) {
+            acc[i][j] = __builtin_amdgcn_udot8(av[i][0], bv[j][0], acc[i][j], false);
+            acc[i][j] = __builtin_amdgcn_udot8(av[i][1], bv[j][1], acc[i][j], false);
+          }
+      }
+#pragma unroll
+      for (int i = 0; i < TM; ++i) {
+        float sap = sSA[gg][tm + i * STM];
+        float sag = sSa[gg][tm + i * STM];
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+          int c = tn + j * STN;
+          float v = (float)acc[i][j] - sZp[cur][gg][c] * sap + sE[cur][gg][c];
+          fout[i][j] += (sSw[cur][gg][c] * sag) * v;
+        }
+      }
+    }
+
+    if (g + 2 < NG) {
+      // Одинарний sA дає конфлікт «запис після читання»: швидші хвилі затерли
+      // б плитку, поки повільніші її ще читають. Цей бар'єр — уся плата за
+      // відмову від подвійного буфера.
+      __syncthreads();
+#pragma unroll
+      for (int k = 0; k < PA / 4; ++k) {
+        int r = tid / W4 + k * rowsA, w = (tid % W4) * 4;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) sA[r][w + e] = ra[k][e];
+      }
+#pragma unroll
+      for (int k = 0; k < PB / 4; ++k) {
+        int r = tid / W4 + k * rowsA, w = (tid % W4) * 4;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) sB[nxt][r][w + e] = rb[k][e];
+      }
+      for (int t = tid; t < 2 * BM; t += nthr) {
+        int gg2 = t / BM, r = t % BM, m = m0 + r;
+        sSA[gg2][r] = (m < M) ? SAp[(long)m * NG + g + 2 + gg2] : 0.f;
+        sSa[gg2][r] = (m < M) ? Sa[(long)m * NG + g + 2 + gg2] : 0.f;
+      }
+      for (int t = tid; t < 2 * BN; t += nthr) {
+        int gg2 = t / BN, r = t % BN, n = n0 + r;
+        sSw[nxt][gg2][r] = (n < N) ? __half2float(Sw[(long)n * NG + g + 2 + gg2]) : 0.f;
+        sZp[nxt][gg2][r] = (n < N) ? __half2float(Zp[(long)n * NG + g + 2 + gg2]) : 0.f;
+        sE[nxt][gg2][r] = (n < N) ? (float)E[(long)n * NG + g + 2 + gg2] : 0.f;
+      }
+      __syncthreads();
+    }
+  }
+
+#pragma unroll
+  for (int i = 0; i < TM; ++i) {
+    int m = m0 + tm + i * STM;
+#pragma unroll
+    for (int j = 0; j < TN; ++j) {
+      int n = n0 + tn + j * STN;
+      if (m < M && n < N) C[(long)m * N + n] = __float2half(fout[i][j]);
+    }
+  }
+}
+
+
+
+
+// ⚠️ Власні сталі для восьмибітного шляху: у чотирибітному WORDS = GS/8,
+// а тут активації займають байт, тож слів на групу вдвічі більше.
+#define WORDS8 (GS / 4)      // слів int32 у LDS на групу (128 байтів)
+#define WORDS8_RAW (GS / 8)  // слів упакованої ваги на групу
+
+// ── W4A8: квантування активацій у 8 бітів ЗНАКОВО ──────────────────────────
+//
+// Знакові активації, а не беззнакові зі зсувом +128, — свідомо. При
+// беззнакових у розкладі з'являється доданок 128·(G·zp − Sq), який доводилося
+// б зберігати на кожну пару (стовпець, група): близько 195 МіБ на карту для
+// 27B, плюс окремий масив у LDS. Зсунувши натомість ВАГИ (q_s = q − 8,
+// zp_s = zp − 8), отримуємо
+//     Σ x·W = sa_g·sw_g·[ sdot4(a, q_s) − zp_s,g·Sa_g ]
+// без жодної поправки з боку ваг.
+//
+// Розкладка роботи: одна хвиля на пару (рядок, група). Смуга читає чотири
+// сусідні значення (два звертання по __half2), тож хвиля покриває рівно 128
+// значень = 256 суцільних байтів. Максимум і суму зводить обмін між смугами.
+// Пакує ВСЯ хвиля: 32 слова по чотири байти на 32 смуги.
+//
+// ⚠️ Порядок байтів мусить збігатися з порядком півбайтів у вагах. Вага лежить
+// у перемішуванні exllama: позиція p слова w несе природний індекс
+// k = w*8 + shuf[p]. Розпаковуючи вагу в байти, ми з одного слова робимо два:
+// перше несе p = 0..3, друге p = 4..7. Отже слово активацій ww = 2w + half,
+// байт b, мусить несети k = w*8 + shuf[half*4 + b].
+__global__ __launch_bounds__(256) void quant_groups8(
+    const __half* __restrict__ X, int* __restrict__ Aq,
+    float* __restrict__ SaSum, float* __restrict__ Sa, int M, int K) {
+  const int NG = K / GS, K4 = K / 4;
+  const long wv = ((long)blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+  const int lane = threadIdx.x & 31;
+  if (wv >= (long)M * NG) return;
+  const int m = (int)(wv / NG), g = (int)(wv - (long)m * NG);
+  const __half* base = X + (long)m * K + (long)g * GS;
+
+  // 1. Максимум за модулем по групі.
+  const __half2* b2 = (const __half2*)base;
+  __half2 v0 = b2[lane * 2], v1 = b2[lane * 2 + 1];
+  float mx = fmaxf(fmaxf(fabsf(__low2float(v0)), fabsf(__high2float(v0))),
+                   fmaxf(fabsf(__low2float(v1)), fabsf(__high2float(v1))));
+#pragma unroll
+  for (int sft = 16; sft; sft >>= 1) mx = fmaxf(mx, __shfl_xor(mx, sft, 32));
+  const float sa = fmaxf(mx, 1e-8f) / 127.0f;
+  const float inv = 1.0f / sa;
+  if (lane == 0) Sa[(long)m * NG + g] = sa;
+
+  // 2. Пакування: слово ww = lane, тобто w = lane/2, half = lane%2.
+  const int shuf[8] = {0, 2, 4, 6, 1, 3, 5, 7};
+  const int w = lane >> 1, half = lane & 1;
+  int word = 0, s = 0;
+#pragma unroll
+  for (int b = 0; b < 4; ++b) {
+    float fv = __half2float(base[w * 8 + shuf[half * 4 + b]]) * inv;
+    int q = (int)rintf(fv);
+    q = q < -127 ? -127 : (q > 127 ? 127 : q);
+    word |= (q & 0xFF) << (8 * b);
+    s += q;
+  }
+  Aq[(long)m * K4 + (long)g * (GS / 4) + lane] = word;
+#pragma unroll
+  for (int sft = 16; sft; sft >>= 1) s += __shfl_xor(s, sft, 32);
+  if (lane == 0) SaSum[(long)m * NG + g] = (float)s;
+}
+
+static inline __device__ void unpack_nibbles(int v, int& lo, int& hi) {
+  int b0 = (v & 0xF) - 8;
+  int b1 = ((v >> 4) & 0xF) - 8;
+  int b2 = ((v >> 8) & 0xF) - 8;
+  int b3 = ((v >> 12) & 0xF) - 8;
+  lo = (b0 & 0xFF) | ((b1 & 0xFF) << 8) | ((b2 & 0xFF) << 16) | ((b3 & 0xFF) << 24);
+
+  unsigned int vh = (unsigned int)v >> 16;
+  int b4 = (vh & 0xF) - 8;
+  int b5 = ((vh >> 4) & 0xF) - 8;
+  int b6 = ((vh >> 8) & 0xF) - 8;
+  int b7 = ((vh >> 12) & 0xF) - 8;
+  hi = (b4 & 0xFF) | ((b5 & 0xFF) << 8) | ((b6 & 0xFF) << 16) | ((b7 & 0xFF) << 24);
+}
+
+// ── Стара версія ядра: плитка 8 x 4, блок 128 x 64, 256 ниток ──────────────
+template <int BM = 128, int BN = 64, int TM = 8, int TN = 4>
+__global__ __launch_bounds__(256) void gemm_w4a8_k_tile8x4(
+    const int* __restrict__ A,        // [M, K/4] знакові байти a (4 на int32)
+    const int* __restrict__ B,        // [N, K/8] беззнакові напівбайти q (8 на int32)
+    const float* __restrict__ Sa_sum, // [M, NG] знакові суми a по групі
+    const __half* __restrict__ Sw,    // [N, NG] масштаби ваг (fp16, як у vLLM)
+    const __half* __restrict__ Zp,    // [N, NG] нульові точки (fp16)
+    const float* __restrict__ Sa,     // [M, NG] масштаб активацій на групу
+    __half* __restrict__ C, int M, int N, int K) {
+  const int K4 = K / 4, K8 = K / 8, NG = K / GS;
+  const int tid = threadIdx.x;
+  const int nthr = BM * BN / (TM * TN); // 256
+  const int STM = BM / TM, STN = BN / TN; // 16, 16
+  const int tm = tid / STN, tn = tid % STN;
+  const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+
+  const int W4_A = WORDS8 / 4;        // 32 / 4 = 8
+  const int rowsA = nthr / W4_A;     // 256 / 8 = 32
+  const int PA_4 = (BM * WORDS8 / nthr) / 4; // (128 * 32 / 256) / 4 = 4
+
+  const int W4_B = WORDS8_RAW / 4;    // 16 / 4 = 4
+  const int rowsB = nthr / W4_B;     // 256 / 4 = 64
+  const int PB_4 = (BN * WORDS8_RAW / nthr) / 4; // (64 * 16 / 256) / 4 = 1
+
+  // Буфери LDS:
+  // sA: одинарний буфер активацій [128][34] * 4 Б = 17 408 Б
+  // sB: подвійний буфер розпакованих ваг 2 * [64][34] * 4 Б = 17 408 Б
+  // Масштаби та суми: sSa_sum (512 Б), sSa (512 Б), sSw (512 Б), sZps (512 Б) = 2 048 Б
+  // Загальний бюджет LDS: 17408 + 17408 + 2048 = 36 864 Б (36.0 КБ)
+  __shared__ __align__(8) int sA[BM][WORDS8 + 2];
+  __shared__ __align__(8) int sB[2][BN][WORDS8 + 2];
+  __shared__ float sSa_sum[BM], sSa[BM];
+  __shared__ float sSw[2][BN], sZps[2][BN];
+
+  float fout[TM][TN];
+#pragma unroll
+  for (int i = 0; i < TM; ++i)
+#pragma unroll
+    for (int j = 0; j < TN; ++j) fout[i][j] = 0.f;
+
+  int4v ra[PA_4 > 0 ? PA_4 : 1], rb[PB_4 > 0 ? PB_4 : 1];
+
+  // Початкове завантаження групи 0 в LDS
+#pragma unroll
+  for (int k = 0; k < PA_4; ++k) {
+    int r = tid / W4_A + k * rowsA, w = (tid % W4_A) * 4, m = m0 + r;
+    int4v v = (m < M) ? *(const int4v*)(&A[(long)m * K4 + w]) : (int4v)(0);
+#pragma unroll
+    for (int e = 0; e < 4; ++e) sA[r][w + e] = v[e];
+  }
+
+#pragma unroll
+  for (int k = 0; k < PB_4; ++k) {
+    int r = tid / W4_B + k * rowsB, w_raw = (tid % W4_B) * 4, n = n0 + r;
+    int4v v = (n < N) ? *(const int4v*)(&B[(long)n * K8 + w_raw]) : (int4v)(0);
+    int w_lds = w_raw * 2;
+#pragma unroll
+    for (int e = 0; e < 4; ++e) {
+      int lo, hi;
+      unpack_nibbles(v[e], lo, hi);
+      sB[0][r][w_lds + 2 * e] = lo;
+      sB[0][r][w_lds + 2 * e + 1] = hi;
+    }
+  }
+
+  if (tid < BM) {
+    int m = m0 + tid;
+    sSa_sum[tid] = (m < M) ? Sa_sum[(long)m * NG] : 0.f;
+    sSa[tid] = (m < M) ? Sa[(long)m * NG] : 0.f;
+  }
+  if (tid < BN) {
+    int n = n0 + tid;
+    sSw[0][tid] = (n < N) ? __half2float(Sw[(long)n * NG]) : 0.f;
+    sZps[0][tid] = (n < N) ? (__half2float(Zp[(long)n * NG]) - 8.f) : 0.f;
+  }
+  __syncthreads();
+
+  for (int g = 0; g < NG; ++g) {
+    const int cur = g & 1, nxt = cur ^ 1;
+
+    // Випереджальне читання (prefetch) наступної групи g + 1 у регістри
+    if (g + 1 < NG) {
+      __builtin_amdgcn_s_setprio(1);
+#pragma unroll
+      for (int k = 0; k < PA_4; ++k) {
+        int r = tid / W4_A + k * rowsA, w = (tid % W4_A) * 4, m = m0 + r;
+        ra[k] = (m < M) ? *(const int4v*)(&A[(long)m * K4 + (g + 1) * WORDS8 + w])
+                        : (int4v)(0);
+      }
+#pragma unroll
+      for (int k = 0; k < PB_4; ++k) {
+        int r = tid / W4_B + k * rowsB, w_raw = (tid % W4_B) * 4, n = n0 + r;
+        rb[k] = (n < N) ? *(const int4v*)(&B[(long)n * K8 + (g + 1) * WORDS8_RAW + w_raw])
+                        : (int4v)(0);
+      }
+      __builtin_amdgcn_s_setprio(0);
+    }
+
+    // Обчислення dot product для поточної групи g
+    int acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+      for (int j = 0; j < TN; ++j) acc[i][j] = 0;
+
+#pragma unroll 1
+    for (int w = 0; w < WORDS8; w += 2) {
+      int2v av[TM], bv[TN];
+#pragma unroll
+      for (int i = 0; i < TM; ++i) av[i] = *(const int2v*)(&sA[tm + i * STM][w]);
+#pragma unroll
+      for (int j = 0; j < TN; ++j) bv[j] = *(const int2v*)(&sB[cur][tn + j * STN][w]);
+#pragma unroll
+      for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+          acc[i][j] = __builtin_amdgcn_sdot4(av[i][0], bv[j][0], acc[i][j], false);
+          acc[i][j] = __builtin_amdgcn_sdot4(av[i][1], bv[j][1], acc[i][j], false);
+        }
+    }
+
+#pragma unroll
+    for (int i = 0; i < TM; ++i) {
+      float sa_sum = sSa_sum[tm + i * STM];
+      float sag = sSa[tm + i * STM];
+#pragma unroll
+      for (int j = 0; j < TN; ++j) {
+        int c = tn + j * STN;
+        float v = (float)acc[i][j] - sZps[cur][c] * sa_sum;
+        fout[i][j] += (sSw[cur][c] * sag) * v;
+      }
+    }
+
+    // Запис випереджально зчитаних даних наступної групи g + 1 в LDS
+    if (g + 1 < NG) {
+      __syncthreads();
+#pragma unroll
+      for (int k = 0; k < PA_4; ++k) {
+        int r = tid / W4_A + k * rowsA, w = (tid % W4_A) * 4;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) sA[r][w + e] = ra[k][e];
+      }
+#pragma unroll
+      for (int k = 0; k < PB_4; ++k) {
+        int r = tid / W4_B + k * rowsB, w_raw = (tid % W4_B) * 4;
+        int w_lds = w_raw * 2;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+          int lo, hi;
+          unpack_nibbles(rb[k][e], lo, hi);
+          sB[nxt][r][w_lds + 2 * e] = lo;
+          sB[nxt][r][w_lds + 2 * e + 1] = hi;
+        }
+      }
+      if (tid < BM) {
+        int m = m0 + tid;
+        sSa_sum[tid] = (m < M) ? Sa_sum[(long)m * NG + g + 1] : 0.f;
+        sSa[tid] = (m < M) ? Sa[(long)m * NG + g + 1] : 0.f;
+      }
+      if (tid < BN) {
+        int n = n0 + tid;
+        sSw[nxt][tid] = (n < N) ? __half2float(Sw[(long)n * NG + g + 1]) : 0.f;
+        sZps[nxt][tid] = (n < N) ? (__half2float(Zp[(long)n * NG + g + 1]) - 8.f) : 0.f;
+      }
+      __syncthreads();
+    }
+  }
+
+#pragma unroll
+  for (int i = 0; i < TM; ++i) {
+    int m = m0 + tm + i * STM;
+#pragma unroll
+    for (int j = 0; j < TN; ++j) {
+      int n = n0 + tn + j * STN;
+      if (m < M && n < N) C[(long)m * N + n] = __float2half(fout[i][j]);
+    }
+  }
+}
+
+// ── Нова версія ядра: плитка 8 x 8, блок 128 x 128, 256 ниток ──────────────
+template <int BM = 128, int BN = 128, int TM = 8, int TN = 8>
+__global__ __launch_bounds__(256) void gemm_w4a8_k(
+    const int* __restrict__ A,        // [M, K/4] знакові байти a (4 на int32)
+    const int* __restrict__ B,        // [N, K/8] беззнакові напівбайти q (8 на int32)
+    const float* __restrict__ Sa_sum, // [M, NG] знакові суми a по групі
+    const __half* __restrict__ Sw,    // [N, NG] масштаби ваг (fp16, як у vLLM)
+    const __half* __restrict__ Zp,    // [N, NG] нульові точки (fp16)
+    const float* __restrict__ Sa,     // [M, NG] масштаб активацій на групу
+    __half* __restrict__ C, int M, int N, int K) {
+  const int K4 = K / 4, K8 = K / 8, NG = K / GS;
+  const int tid = threadIdx.x;
+  const int nthr = BM * BN / (TM * TN); // 256
+  const int STM = BM / TM, STN = BN / TN; // 16, 16
+  const int tm = tid / STN, tn = tid % STN;
+  const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+
+  const int W4_A = WORDS8 / 4;        // 32 / 4 = 8
+  const int rowsA = nthr / W4_A;     // 256 / 8 = 32
+  const int PA_4 = (BM * WORDS8 / nthr) / 4; // (128 * 32 / 256) / 4 = 4
+
+  const int W4_B = WORDS8_RAW / 4;    // 16 / 4 = 4
+  const int rowsB = nthr / W4_B;     // 256 / 4 = 64
+  const int PB_4 = (BN * WORDS8_RAW / nthr) / 4; // (128 * 16 / 256) / 4 = 2
+
+  // Буфери LDS:
+  // sA: одинарний буфер активацій [128][34] * 4 Б = 17 408 Б
+  // sB: подвійний буфер розпакованих ваг 2 * [128][34] * 4 Б = 34 816 Б
+  // Масштаби та суми: sSa_sum (512 Б), sSa (512 Б), sSw (1024 Б), sZps (1024 Б) = 3 072 Б
+  // Загальний бюджет LDS: 17408 + 34816 + 3072 = 55 296 Б (54.0 КБ <= 64 КБ на CU)
+  __shared__ __align__(8) int sA[BM][WORDS8 + 2];
+  __shared__ __align__(8) int sB[2][BN][WORDS8 + 2];
+  __shared__ float sSa_sum[BM], sSa[BM];
+  __shared__ float sSw[2][BN], sZps[2][BN];
+
+  float fout[TM][TN];
+#pragma unroll
+  for (int i = 0; i < TM; ++i)
+#pragma unroll
+    for (int j = 0; j < TN; ++j) fout[i][j] = 0.f;
+
+  int4v ra[PA_4 > 0 ? PA_4 : 1], rb[PB_4 > 0 ? PB_4 : 1];
+
+  // Початкове завантаження групи 0 в LDS
+#pragma unroll
+  for (int k = 0; k < PA_4; ++k) {
+    int r = tid / W4_A + k * rowsA, w = (tid % W4_A) * 4, m = m0 + r;
+    int4v v = (m < M) ? *(const int4v*)(&A[(long)m * K4 + w]) : (int4v)(0);
+#pragma unroll
+    for (int e = 0; e < 4; ++e) sA[r][w + e] = v[e];
+  }
+
+#pragma unroll
+  for (int k = 0; k < PB_4; ++k) {
+    int r = tid / W4_B + k * rowsB, w_raw = (tid % W4_B) * 4, n = n0 + r;
+    int4v v = (n < N) ? *(const int4v*)(&B[(long)n * K8 + w_raw]) : (int4v)(0);
+    int w_lds = w_raw * 2;
+#pragma unroll
+    for (int e = 0; e < 4; ++e) {
+      int lo, hi;
+      unpack_nibbles(v[e], lo, hi);
+      sB[0][r][w_lds + 2 * e] = lo;
+      sB[0][r][w_lds + 2 * e + 1] = hi;
+    }
+  }
+
+  if (tid < BM) {
+    int m = m0 + tid;
+    sSa_sum[tid] = (m < M) ? Sa_sum[(long)m * NG] : 0.f;
+    sSa[tid] = (m < M) ? Sa[(long)m * NG] : 0.f;
+  }
+  if (tid < BN) {
+    int n = n0 + tid;
+    sSw[0][tid] = (n < N) ? __half2float(Sw[(long)n * NG]) : 0.f;
+    sZps[0][tid] = (n < N) ? (__half2float(Zp[(long)n * NG]) - 8.f) : 0.f;
+  }
+  __syncthreads();
+
+  for (int g = 0; g < NG; ++g) {
+    const int cur = g & 1, nxt = cur ^ 1;
+
+    // Випереджальне читання (prefetch) наступної групи g + 1 у регістри
+    if (g + 1 < NG) {
+      __builtin_amdgcn_s_setprio(1);
+#pragma unroll
+      for (int k = 0; k < PA_4; ++k) {
+        int r = tid / W4_A + k * rowsA, w = (tid % W4_A) * 4, m = m0 + r;
+        ra[k] = (m < M) ? *(const int4v*)(&A[(long)m * K4 + (g + 1) * WORDS8 + w])
+                        : (int4v)(0);
+      }
+#pragma unroll
+      for (int k = 0; k < PB_4; ++k) {
+        int r = tid / W4_B + k * rowsB, w_raw = (tid % W4_B) * 4, n = n0 + r;
+        rb[k] = (n < N) ? *(const int4v*)(&B[(long)n * K8 + (g + 1) * WORDS8_RAW + w_raw])
+                        : (int4v)(0);
+      }
+      __builtin_amdgcn_s_setprio(0);
+    }
+
+    // Обчислення dot product для поточної групи g
+    int acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i)
+#pragma unroll
+      for (int j = 0; j < TN; ++j) acc[i][j] = 0;
+
+#pragma unroll 1
+    for (int w = 0; w < WORDS8; w += 2) {
+      int2v av[TM], bv[TN];
+#pragma unroll
+      for (int i = 0; i < TM; ++i) av[i] = *(const int2v*)(&sA[tm + i * STM][w]);
+#pragma unroll
+      for (int j = 0; j < TN; ++j) bv[j] = *(const int2v*)(&sB[cur][tn + j * STN][w]);
+#pragma unroll
+      for (int i = 0; i < TM; ++i)
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+          acc[i][j] = __builtin_amdgcn_sdot4(av[i][0], bv[j][0], acc[i][j], false);
+          acc[i][j] = __builtin_amdgcn_sdot4(av[i][1], bv[j][1], acc[i][j], false);
+        }
+    }
+
+#pragma unroll
+    for (int i = 0; i < TM; ++i) {
+      float sa_sum = sSa_sum[tm + i * STM];
+      float sag = sSa[tm + i * STM];
+#pragma unroll
+      for (int j = 0; j < TN; ++j) {
+        int c = tn + j * STN;
+        float v = (float)acc[i][j] - sZps[cur][c] * sa_sum;
+        fout[i][j] += (sSw[cur][c] * sag) * v;
+      }
+    }
+
+    // Запис випереджально зчитаних даних наступної групи g + 1 в LDS
+    if (g + 1 < NG) {
+      __syncthreads();
+#pragma unroll
+      for (int k = 0; k < PA_4; ++k) {
+        int r = tid / W4_A + k * rowsA, w = (tid % W4_A) * 4;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) sA[r][w + e] = ra[k][e];
+      }
+#pragma unroll
+      for (int k = 0; k < PB_4; ++k) {
+        int r = tid / W4_B + k * rowsB, w_raw = (tid % W4_B) * 4;
+        int w_lds = w_raw * 2;
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+          int lo, hi;
+          unpack_nibbles(rb[k][e], lo, hi);
+          sB[nxt][r][w_lds + 2 * e] = lo;
+          sB[nxt][r][w_lds + 2 * e + 1] = hi;
+        }
+      }
+      if (tid < BM) {
+        int m = m0 + tid;
+        sSa_sum[tid] = (m < M) ? Sa_sum[(long)m * NG + g + 1] : 0.f;
+        sSa[tid] = (m < M) ? Sa[(long)m * NG + g + 1] : 0.f;
+      }
+      if (tid < BN) {
+        int n = n0 + tid;
+        sSw[nxt][tid] = (n < N) ? __half2float(Sw[(long)n * NG + g + 1]) : 0.f;
+        sZps[nxt][tid] = (n < N) ? (__half2float(Zp[(long)n * NG + g + 1]) - 8.f) : 0.f;
+      }
+      __syncthreads();
+    }
+  }
+
+#pragma unroll
+  for (int i = 0; i < TM; ++i) {
+    int m = m0 + tm + i * STM;
+#pragma unroll
+    for (int j = 0; j < TN; ++j) {
+      int n = n0 + tn + j * STN;
+      if (m < M && n < N) C[(long)m * N + n] = __float2half(fout[i][j]);
+    }
+  }
+}
+
+static inline int sbyte(int word, int k) { return (signed char)((word >> (8 * k)) & 0xFF); }
+static inline int nib(int word, int k) { return (word >> (4 * k)) & 0xF; }
