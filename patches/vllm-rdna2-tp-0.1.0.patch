+// W4A16 skinny GEMM for decode / MTP verification steps on RDNA2 (gfx1030).
+//
+// Derived from wvSplitK_int4_hf_sml_ (csrc/rocm/skinny_gemms_int4.cu), fp16,
+// group size 128, with and without zero points. Differences:
+//   * int4 -> fp16 dequantisation is done once per weight chunk and reused
+//     for all N activation rows (the original redid it per row);
+//   * the zero point is folded into the fp16 magic-number constants
+//     (lo: (nib | 0x6400) - (1024 + zp); hi: fma(hi, 1/16, -(64 + zp))),
+//     both exact for integer zp in 0..15, so no per-element subtraction;
+//   * N up to 8 rows in one launch; when N*K exceeds LDS the activations are
+//     staged in K chunks, so the weights are still read from memory once;
+//   * a wave may own TM row tiles at once, so that the chunk loop can be the
+//     outer loop without reloading LDS.
+//
+// Weight layout is the one wvSplitK_int4_g expects: [M, K/2] bytes, eight
+// nibbles per uint32 in the order n0 n4 n1 n5 n2 n6 n3 n7 (exllama).
+
+#include <torch/extension.h>
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <cstdint>
+#include <algorithm>
+
+namespace {
+
+typedef _Float16 f16x2 __attribute__((ext_vector_type(2)));
+typedef unsigned int u32x2 __attribute__((ext_vector_type(2)));
+typedef unsigned int u32x4 __attribute__((ext_vector_type(4)));
+
+constexpr int kThrds = 32;             // wave32
+constexpr int kWaves = 16;             // waves per block
+constexpr int kChunk = 16;             // K elements per lane per step
+constexpr int kStepK = kThrds * kChunk;  // K elements per wave per step
+constexpr int kLdsElems = 32768;       // 64 KiB of fp16
+constexpr int kGroup = 128;
+constexpr int kMaxN = 8;
+
+__device__ __forceinline__ float dot2(uint32_t a, uint32_t b, float c) {
+  return __builtin_amdgcn_fdot2(__builtin_bit_cast(f16x2, a),
+                                __builtin_bit_cast(f16x2, b), c, false);
+}
+
+#define REDUCE_SUM_DPP_WAVE32(val)                                        \
+  do {                                                                    \
+    val += __builtin_amdgcn_mov_dpp(val, 0x118, 0xf, 0xf, 1);             \
+    val += __builtin_amdgcn_mov_dpp(val, 0x114, 0xf, 0xf, 1);             \
+    val += __builtin_amdgcn_mov_dpp(val, 0x112, 0xf, 0xf, 1);             \
+    val += __builtin_amdgcn_mov_dpp(val, 0x111, 0xf, 0xf, 1);             \
+    val += __shfl_xor(val, 16);                                           \
+  } while (0)
+
+// 16 nibbles (two uint32) -> 8 fp16x2 words holding (nib - zp), exactly.
+__device__ __forceinline__ void dequant16(u32x2 q, f16x2 blo, f16x2 bhi,
+                                          uint32_t (&o)[8]) {
+  constexpr uint32_t kMagic = 0x64006400u;
+  const f16x2 inv16 = __builtin_bit_cast(f16x2, 0x2C002C00u);
+#pragma unroll
+  for (int w = 0; w < 2; w++) {
+    uint32_t qa = q[w];
+    uint32_t lo0 = (qa & 0x000F000Fu) | kMagic;
+    uint32_t hi0 = (qa & 0x00F000F0u) | kMagic;
+    qa >>= 8;
+    uint32_t lo1 = (qa & 0x000F000Fu) | kMagic;
+    uint32_t hi1 = (qa & 0x00F000F0u) | kMagic;
+    o[w * 4 + 0] = __builtin_bit_cast(uint32_t,
+                                      __builtin_bit_cast(f16x2, lo0) - blo);
+    o[w * 4 + 1] = __builtin_bit_cast(
+        uint32_t,
+        __builtin_elementwise_fma(__builtin_bit_cast(f16x2, hi0), inv16, bhi));
+    o[w * 4 + 2] = __builtin_bit_cast(uint32_t,
+                                      __builtin_bit_cast(f16x2, lo1) - blo);
+    o[w * 4 + 3] = __builtin_bit_cast(
+        uint32_t,
+        __builtin_elementwise_fma(__builtin_bit_cast(f16x2, hi1), inv16, bhi));
+  }
+}
+
+// One row tile (YTILE weight rows starting at Wm) against one K range that
+// is resident in LDS at s[n * KC + (k - kb)].
+template <int YTILE, int UNRL, int N, bool ZP>
+__device__ __forceinline__ void process(float (&sum)[N][YTILE],
+                                        const uint8_t* Wm, int K_packed,
+                                        const _Float16* sc, const _Float16* zp,
+                                        int num_groups, const _Float16* s,
+                                        int KC, int kb, int ke, int lane) {
+  for (int k1 = kb; k1 < ke; k1 += kStepK * UNRL) {
+    u32x2 bw[UNRL][YTILE];
+    _Float16 scv[UNRL][YTILE];
+    _Float16 zpv[UNRL][YTILE];
+#pragma unroll
+    for (int k2 = 0; k2 < UNRL; k2++) {
+      const int k_ = k1 + k2 * kStepK + lane * kChunk;
+      if (k_ >= ke) break;
+      const int g = k_ / kGroup;
+#pragma unroll
+      for (int y = 0; y < YTILE; y++) {
+        bw[k2][y] = __builtin_nontemporal_load(
+            (const u32x2*)(Wm + (size_t)y * K_packed + k_ / 2));
+        scv[k2][y] = sc[y * num_groups + g];
+        if constexpr (ZP) zpv[k2][y] = zp[y * num_groups + g];
+      }
+    }
+#pragma unroll
+    for (int k2 = 0; k2 < UNRL; k2++) {
+      const int k_ = k1 + k2 * kStepK + lane * kChunk;
+      if (k_ >= ke) break;
+      uint32_t cvt[YTILE][8];
+      float sf[YTILE];
+#pragma unroll
+      for (int y = 0; y < YTILE; y++) {
+        _Float16 z = (_Float16)8.0f;
+        if constexpr (ZP) z = zpv[k2][y];
+        const _Float16 lo = (_Float16)1024.0f + z;
+        const _Float16 hi = -((_Float16)64.0f + z);
+        f16x2 blo = {lo, lo};
+        f16x2 bhi = {hi, hi};
+        dequant16(bw[k2][y], blo, bhi, cvt[y]);
+        sf[y] = (float)scv[k2][y];
+      }
+#pragma unroll
+      for (int n = 0; n < N; n++) {
+        const _Float16* ap = &s[n * KC + (k_ - kb)];
+        const u32x4 a0 = *(const u32x4*)ap;
+        const u32x4 a1 = *(const u32x4*)(ap + 8);
+#pragma unroll
+        for (int y = 0; y < YTILE; y++) {
+          float p = 0.f;
+#pragma unroll
+          for (int b = 0; b < 4; b++) p = dot2(a0[b], cvt[y][b], p);
+#pragma unroll
+          for (int b = 0; b < 4; b++) p = dot2(a1[b], cvt[y][4 + b], p);
+          sum[n][y] += p * sf[y];
+        }
+      }
+    }
+  }
+}
+
+template <int YTILE, int UNRL, int N, int TM, bool ZP>
+__global__ void __launch_bounds__(kWaves* kThrds) skinny_int4_kernel(
+    const int K, const int M, const int Bx, const int By,
+    const uint8_t* __restrict__ Wp, const _Float16* __restrict__ A,
+    const _Float16* __restrict__ scale, const _Float16* __restrict__ zps,
+    const _Float16* __restrict__ BIAS, _Float16* C, const int wvPrGrp,
+    const int CuCount, const int KC) {
+  __shared__ __attribute__((aligned(16))) _Float16 s[kLdsElems];
+
+  const int lane = threadIdx.x;
+  const int wave = threadIdx.y;
+  const int tid = wave * kThrds + lane;
+  const int K_packed = K / 2;
+  const int num_groups = K / kGroup;
+  const int nchunks = (K + KC - 1) / KC;
+
+  // Whole block calls this: barriers must stay uniform, so waves beyond
+  // wvPrGrp only help with loading.
+  auto load_chunk = [&](int kb) {
+    const int kcl = min(KC, K - kb);
+    const int vecs = kcl / 8;
+    const int total = N * vecs;
+    for (int i = tid; i < total; i += kWaves * kThrds) {
+      const int n = i / vecs;
+      const int v = i - n * vecs;
+      *(u32x4*)&s[n * KC + v * 8] =
+          *(const u32x4*)&A[(size_t)n * K + kb + v * 8];
+    }
+  };
+
+  if (nchunks == 1) {
+    load_chunk(0);
+    __syncthreads();
+  }
+
+  const bool active = wave < wvPrGrp;
+  const uint32_t m0 = (blockIdx.x * wvPrGrp + wave) * YTILE;
+  const uint32_t stride = (uint32_t)CuCount * wvPrGrp * YTILE;
+  const int slots = (M + stride - 1) / stride;
+  const int rounds = (slots + TM - 1) / TM;
+
+  for (int r = 0; r < rounds; r++) {
+    float sum[TM][N][YTILE];
+#pragma unroll
+    for (int t = 0; t < TM; t++)
+#pragma unroll
+      for (int n = 0; n < N; n++)
+#pragma unroll
+        for (int y = 0; y < YTILE; y++) sum[t][n][y] = 0.f;
+
+    for (int c = 0; c < nchunks; c++) {
+      const int kb = c * KC;
+      const int ke = min(K, kb + KC);
+      if (nchunks > 1) {
+        __syncthreads();
+        load_chunk(kb);
+        __syncthreads();
+      }
+#pragma unroll
+      for (int t = 0; t < TM; t++) {
+        const uint32_t m = m0 + (uint32_t)(r * TM + t) * stride;
+        if (!active || m >= (uint32_t)M) continue;
+        process<YTILE, UNRL, N, ZP>(
+            sum[t], Wp + (size_t)m * K_packed, K_packed,
+            scale + (size_t)m * num_groups,
+            ZP ? zps + (size_t)m * num_groups : nullptr, num_groups, s, KC, kb,
+            ke, lane);
+      }
+    }
+
+#pragma unroll
+    for (int t = 0; t < TM; t++) {
+      const uint32_t m = m0 + (uint32_t)(r * TM + t) * stride;
+      if (!active || m >= (uint32_t)M) continue;
+#pragma unroll
+      for (int n = 0; n < N; n++)
+#pragma unroll
+        for (int y = 0; y < YTILE; y++) REDUCE_SUM_DPP_WAVE32(sum[t][n][y]);
+      if (lane == kThrds - 1) {
+#pragma unroll
+        for (int n = 0; n < N; n++)
+#pragma unroll
+          for (int i = 0; i < YTILE; i++) {
+            float v = sum[t][n][i];
+            if (BIAS) v += (float)BIAS[(m + i) % Bx + (n % By) * M];
+            C[m + i + (size_t)n * M] = (_Float16)v;
+          }
+      }
+    }
+  }
+}
+
+struct Params {
+  int K, M, N, Bx, By, wvPrGrp, CuCount, KC;
+  const uint8_t* w;
+  const _Float16* a;
+  const _Float16* scale;
+  const _Float16* zp;
+  const _Float16* bias;
+  _Float16* c;
+  hipStream_t stream;
+  int ytile, unrl, tm;
+};
+
+template <int N, int Y, int U, int T, bool ZP>
+void launch_one(const Params& p) {
+  skinny_int4_kernel<Y, U, N, T, ZP>
+      <<<dim3(p.CuCount), dim3(kThrds, kWaves), 0, p.stream>>>(
+          p.K, p.M, p.Bx, p.By, p.w, p.a, p.scale, p.zp, p.bias, p.c,
+          p.wvPrGrp, p.CuCount, p.KC);
+}
+
+template <int N, int Y, int U, int T>
+bool try_cfg(const Params& p) {
+  if (p.ytile != Y || p.unrl != U || p.tm != T) return false;
+  if (p.zp) {
+    launch_one<N, Y, U, T, true>(p);
+  } else {
+#ifndef SKINNY_TUNE
+    launch_one<N, Y, U, T, false>(p);
+#else
+    TORCH_CHECK(false, "SKINNY_TUNE build has only the zero-point variant");
+#endif
+  }
+  return true;
+}
+
+int mindiv(int N, int div1, int div2) {
+  int nPrRnd = div1 * div2;
+  int limit = div2 < 13 ? div2 : 13;
+  int rnds[16];
+  for (int i = 0; i < limit; i++) {
+    rnds[i] = (N + nPrRnd - 1) / nPrRnd;
+    nPrRnd -= div1;
+  }
+  for (int i = limit - 1; i >= 0; i--)
+    if (rnds[0] == rnds[i]) return (div2 - i);
+  return 0;
+}
+
+// Measured on RX 6800 (skinny-int4-tune.py, gfx1030, graph, 29.09.2026):
+// YTILE 4 wins everywhere; UNRL 2 and one tile per wave up to N=5, then the
+// register pressure of the N x YTILE accumulators favours UNRL 1 (N=6) and,
+// once the K chunks are reloaded (chunked), two tiles per wave (TM=2), which
+// avoids re-staging the activations. M not divisible by 4 is not tuned.
+void auto_cfg(int N, int M, int K, int cu, bool chunked, int& y, int& u,
+              int& t) {
+  y = 4;
+  u = 2;
+  t = 1;
+  if (N == 4 && chunked) {
+    u = 1;
+    t = 2;
+  } else if (N == 6) {
+    u = 1;
+    t = chunked ? 2 : 1;
+  } else if (N == 7 || (N == 8 && chunked)) {
+    t = 2;
+  }
+  if (M % 4 != 0) {
+    y = (M % 2 == 0) ? 2 : 1;
+    u = 2;
+    t = 1;
+  }
+}
+
+template <int N>
+bool dispatch_cfg(const Params& p) {
+  return try_cfg<N, 4, 2, 1>(p) || try_cfg<N, 4, 1, 2>(p) ||
+         try_cfg<N, 4, 1, 1>(p) || try_cfg<N, 4, 2, 2>(p) ||
+         try_cfg<N, 2, 2, 1>(p) || try_cfg<N, 1, 2, 1>(p);
+}
+
+template <int N>
+bool dispatch_n(const Params& p) {
+#ifdef SKINNY_TUNE
+  if (N != SKINNY_TUNE_N) return false;
+  return try_cfg<N, 1, 1, 1>(p) || try_cfg<N, 1, 2, 1>(p) ||
+         try_cfg<N, 1, 4, 1>(p) || try_cfg<N, 2, 1, 1>(p) ||
+         try_cfg<N, 2, 2, 1>(p) || try_cfg<N, 2, 4, 1>(p) ||
+         try_cfg<N, 4, 1, 1>(p) || try_cfg<N, 4, 2, 1>(p) ||
+         try_cfg<N, 4, 4, 1>(p) || try_cfg<N, 1, 1, 2>(p) ||
+         try_cfg<N, 1, 2, 2>(p) || try_cfg<N, 1, 4, 2>(p) ||
+         try_cfg<N, 2, 1, 2>(p) || try_cfg<N, 2, 2, 2>(p) ||
+         try_cfg<N, 2, 4, 2>(p) || try_cfg<N, 4, 1, 2>(p) ||
+         try_cfg<N, 4, 2, 2>(p) || try_cfg<N, 1, 1, 3>(p) ||
+         try_cfg<N, 1, 2, 3>(p) || try_cfg<N, 1, 4, 3>(p) ||
+         try_cfg<N, 2, 1, 3>(p) || try_cfg<N, 2, 2, 3>(p) ||
+         try_cfg<N, 2, 4, 3>(p) || try_cfg<N, 1, 1, 4>(p) ||
+         try_cfg<N, 1, 2, 4>(p) || try_cfg<N, 2, 1, 4>(p) ||
+         try_cfg<N, 2, 2, 4>(p);
+#else
+  return dispatch_cfg<N>(p);
+#endif
+}
+
+}  // namespace
+
+torch::Tensor wv_int4(const at::Tensor& w, const at::Tensor& x,
+                      const at::Tensor& scale,
+                      const std::optional<at::Tensor>& zp,
+                      const std::optional<at::Tensor>& bias, int64_t cu_count,
+                      int64_t group_size, int64_t ytile, int64_t unrl,
+                      int64_t tm) {
+  const int64_t M = w.size(0);
+  const int64_t N = x.size(0);
+  const int64_t K = x.size(1);
+  TORCH_CHECK(x.dtype() == torch::kFloat16 && scale.dtype() == torch::kFloat16,
+              "fp16 only");
+  TORCH_CHECK(group_size == kGroup, "group_size must be 128");
+  TORCH_CHECK(1 <= N && N <= kMaxN, "N must be 1..8, got ", N);
+  TORCH_CHECK(K % kGroup == 0, "K must be divisible by 128");
+  TORCH_CHECK(w.numel() * w.element_size() == M * K / 2,
+              "weight must hold M*K/2 bytes");
+  TORCH_CHECK(scale.dim() == 2 && scale.size(0) == M &&
+                  scale.size(1) == K / kGroup,
+              "scale must be [M, K/128]");
+  TORCH_CHECK(x.is_contiguous() && scale.is_contiguous(),
+              "x and scale must be contiguous");
+  if (zp.has_value()) {
+    TORCH_CHECK(zp->dtype() == torch::kFloat16 && zp->dim() == 2 &&
+                    zp->size(0) == M && zp->size(1) == K / kGroup &&
+                    zp->is_contiguous(),
+                "zero points must be fp16 [M, K/128]");
+  }
+  const bool has_bias = bias.has_value() && bias->numel() > 0;
+  const int64_t Bx = has_bias ? (bias->dim() == 2 ? bias->size(1) : bias->size(0)) : 1;
+  const int64_t By = (has_bias && bias->dim() == 2) ? bias->size(0) : 1;
+
+  auto out = torch::empty(
+      {N, M}, torch::TensorOptions().dtype(x.dtype()).device(x.device()));
+
+  Params p;
+  p.K = K;
+  p.M = M;
+  p.N = N;
+  p.Bx = Bx;
+  p.By = By;
+  p.CuCount = cu_count;
+  p.KC = (K * N > kLdsElems) ? (kLdsElems / (int)N / kStepK) * kStepK : (int)K;
+  p.w = reinterpret_cast<const uint8_t*>(w.data_ptr());
+  p.a = reinterpret_cast<const _Float16*>(x.data_ptr());
+  p.scale = reinterpret_cast<const _Float16*>(scale.data_ptr());
+  p.zp = zp.has_value() ? reinterpret_cast<const _Float16*>(zp->data_ptr())
+                        : nullptr;
+  p.bias = has_bias ? reinterpret_cast<const _Float16*>(bias->data_ptr())
+                    : nullptr;
+  p.c = reinterpret_cast<_Float16*>(out.data_ptr());
+  p.stream = at::hip::getCurrentHIPStream();
+
+  if (ytile == 0) {
+    const bool chunked = p.KC < K;
+    auto_cfg((int)N, (int)M, (int)K, (int)cu_count, chunked, p.ytile, p.unrl,
+             p.tm);
+  } else {
+    p.ytile = ytile;
+    p.unrl = unrl;
+    p.tm = tm;
+  }
+  TORCH_CHECK(M % p.ytile == 0, "M=", M, " not divisible by YTILE=", p.ytile);
+  p.wvPrGrp = mindiv((int)M, (int)cu_count * p.ytile, kWaves);
+
+  bool ok = false;
+  switch (N) {
+    case 1: ok = dispatch_n<1>(p); break;
+    case 2: ok = dispatch_n<2>(p); break;
+    case 3: ok = dispatch_n<3>(p); break;
+    case 4: ok = dispatch_n<4>(p); break;
+    case 5: ok = dispatch_n<5>(p); break;
+    case 6: ok = dispatch_n<6>(p); break;
+    case 7: ok = dispatch_n<7>(p); break;
+    case 8: ok = dispatch_n<8>(p); break;
+  }
+  TORCH_CHECK(ok, "no instantiation for N=", N, " ytile=", p.ytile,
+              " unrl=", p.unrl, " tm=", p.tm);
+  const hipError_t err = hipGetLastError();
+  TORCH_CHECK(err == hipSuccess, "skinny_int4 launch failed: ",
+              hipGetErrorString(err));
+  return out;
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("wv_int4", &wv_int4,
+        "W4A16 skinny GEMM, N<=8, weights read once (gfx1030)");
+}
