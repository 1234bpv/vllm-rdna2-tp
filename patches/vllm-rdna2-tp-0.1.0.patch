+# ----------------------------------------------------------------------
+# 6. Verification that HIP Kernel Actually Dispatched
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "config",
+    ALL_CONFIGS,
+    ids=[c[0] for c in ALL_CONFIGS],
+)
+@pytest.mark.parametrize("block_size", [16, 32])
+def test_hip_kernel_dispatched(monkeypatch, config, block_size):
+    """Specification 7: Verify that HIP kernel is invoked when
+    VLLM_ROCM_INT4_PREFILL_KERNEL='hip', and bypassed when 'triton'.
+    """
+    _, head_size, num_qh, num_kvh, window_size = config
+    seq_len = 73
+    q_len = 17
+    num_blocks = (seq_len + block_size - 1) // block_size
+
+    torch.manual_seed(101)
+    k = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q = torch.randn(q_len, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    block_table = torch.arange(num_blocks, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+    slot_mapping = torch.arange(seq_len, dtype=torch.int64, device=DEVICE)
+
+    reshape_and_cache_int4(
+        k, v, k_cache, v_cache, slot_mapping,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+    cu_seqlens_q = torch.tensor([0, q_len], dtype=torch.int32, device=DEVICE)
+    seqused_k = torch.tensor([seq_len], dtype=torch.int32, device=DEVICE)
+
+    hip_calls = 0
+    orig_try_launch = hip_prefill_mod.try_launch_int4_prefill_attn
+
+    def spy_try_launch(*args, **kwargs):
+        nonlocal hip_calls
+        res = orig_try_launch(*args, **kwargs)
+        if res:
+            hip_calls += 1
+        return res
+
+    monkeypatch.setattr(hip_prefill_mod, "try_launch_int4_prefill_attn", spy_try_launch)
+
+    # 1. When VLLM_ROCM_INT4_PREFILL_KERNEL='hip'
+    monkeypatch.setenv("VLLM_ROCM_INT4_PREFILL_KERNEL", "hip")
+    hip_calls = 0
+    out_hip = torch.empty_like(q)
+    unified_attention_int4(
+        q=q.clone(), k_cache=k_cache, v_cache=v_cache, out=out_hip,
+        cu_seqlens_q=cu_seqlens_q, max_seqlen_q=q_len, seqused_k=seqused_k,
+        max_seqlen_k=seq_len, softmax_scale=softmax_scale, window_size=window_size,
+        block_table=block_table, softcap=0.0, sinks=None, alibi_slopes=None,
+        use_alibi_sqrt=False, qq_bias=None, output_scale=None, mm_prefix_range=None,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache,
+    )
+    assert hip_calls == 1, (
+        f"Expected try_launch_int4_prefill_attn to be called and return True exactly once, "
+        f"but got {hip_calls} calls when VLLM_ROCM_INT4_PREFILL_KERNEL='hip'!"
+    )
+
+    # 2. When VLLM_ROCM_INT4_PREFILL_KERNEL='triton'
+    monkeypatch.setenv("VLLM_ROCM_INT4_PREFILL_KERNEL", "triton")
+    hip_calls = 0
+    out_triton = torch.empty_like(q)
+    unified_attention_int4(
+        q=q.clone(), k_cache=k_cache, v_cache=v_cache, out=out_triton,
+        cu_seqlens_q=cu_seqlens_q, max_seqlen_q=q_len, seqused_k=seqused_k,
+        max_seqlen_k=seq_len, softmax_scale=softmax_scale, window_size=window_size,
+        block_table=block_table, softcap=0.0, sinks=None, alibi_slopes=None,
+        use_alibi_sqrt=False, qq_bias=None, output_scale=None, mm_prefix_range=None,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache,
+    )
+    assert hip_calls == 0, (
+        f"Expected try_launch_int4_prefill_attn NOT to be called when "
+        f"VLLM_ROCM_INT4_PREFILL_KERNEL='triton', but got {hip_calls} calls!"
+    )
+
+
+# ----------------------------------------------------------------------
+# 7. Boundary Conditions and Edge Cases
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize("kernel", ["hip", "triton"])
+@pytest.mark.parametrize("block_size", [16, 32])
+def test_boundary_single_token_in_last_block(kernel, block_size):
+    """Boundary test: sequence length leaves exactly 1 token in the last block
+    (seq_len = block_size + 1), with minimum prefill q_len = 2.
+    """
+    head_size = 256
+    num_qh = 8
+    num_kvh = 4
+    window_size = (1023, 0)
+    seq_len = block_size + 1
+    q_len = 2
+    context_len = seq_len - q_len
+    num_blocks = 2
+
+    torch.manual_seed(333)
+    k = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q = torch.randn(q_len, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    block_table = torch.arange(num_blocks, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+    slot_mapping = torch.arange(seq_len, dtype=torch.int64, device=DEVICE)
+
+    reshape_and_cache_int4(
+        k, v, k_cache, v_cache, slot_mapping,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+    cu_seqlens_q = torch.tensor([0, q_len], dtype=torch.int32, device=DEVICE)
+    seqused_k = torch.tensor([seq_len], dtype=torch.int32, device=DEVICE)
+
+    ref = ref_attention(q, k, v, softmax_scale, window_size, context_len)
+
+    out = run_prefill_attn(
+        kernel, q, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    assert not torch.isnan(out).any()
+    assert not torch.isinf(out).any()
+
+    norm_ref = torch.linalg.norm(ref)
+    rel_err = (torch.linalg.norm(out.float() - ref) / norm_ref).item()
+    assert rel_err < 0.25, f"Boundary error unexpectedly high: {rel_err:.4f}"
