+"""HIP ядро префілу уваги з int4-KV для AMD RDNA2 (gfx1030).
+
+Замінює Triton `_attn_packed` на 2D-шляху (qlen > 1), коли
+`VLLM_ROCM_INT4_PREFILL_KERNEL=hip`. Розширення компілюється при першому
+виклику через load_rdna_ext, результат кешується. Непідтримані входи
+обгортка віддає назад Triton (повертає False).
+"""
+
+import os
+from functools import lru_cache
+from typing import Any, Optional, Tuple
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger("vllm.int4_prefill_attn")
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+@lru_cache(maxsize=1)
+def int4_prefill_attn_ext() -> Optional[Any]:
+    """Зібрати (за потреби) і повернути розширення HIP; None, якщо не вдалося."""
+    try:
+        from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+        ext = load_rdna_ext(
+            "vllm_int4_prefill_attn_rdna",
+            os.path.join(_DIR, "int4_prefill_attn.hip"),
+            ["-O3", "--offload-arch=gfx1030"],
+        )
+        logger.info("HIP розширення int4_prefill_attn зібрано й завантажено")
+        return ext
+    except Exception as e:
+        # Невдачу кешує lru_cache: повторна збірка на кожному кроці дорожча
+        # за відступ на Triton до перезапуску, тож кажемо про це голосно.
+        logger.error("int4_prefill_attn недоступний, префіл іде ядром Triton: %s", e)
+        return None
+
+
+def _sliding_window(window_size: Optional[Tuple[int, int]]) -> int:
+    """Скільки ключів бачить запит (0 — без вікна), як SLIDING_WINDOW у Triton."""
+    if window_size is None or window_size[0] < 0:
+        return 0
+    return 1 + window_size[0]
+
+
+def _hip_supports(num_queries_per_kv: int, head_size: int) -> bool:
+    """Ті самі поєднання, що й диспетчер у int4_prefill_attn.hip."""
+    if head_size == 512:
+        return num_queries_per_kv in (2, 4, 8)
+    return head_size == 256 and num_queries_per_kv in (1, 2, 4, 8)
+
+
+def _unsupported_reason(
+    *,
+    q: torch.Tensor,
+    out: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    seqused_k: torch.Tensor,
+    window_size: Tuple[int, int],
+    block_table: torch.Tensor,
+    softcap: Optional[float],
+    sinks: Optional[torch.Tensor],
+    alibi_slopes: Optional[torch.Tensor],
+    qq_bias: Optional[torch.Tensor],
+    output_scale: Optional[float],
+    mm_prefix_range: Optional[torch.Tensor],
+    k_scale_cache: torch.Tensor,
+    v_scale_cache: torch.Tensor,
+    packing_factor: int,
+    q_i8: Optional[torch.Tensor],
+    q_scale: Optional[torch.Tensor],
+    w4a8: bool,
+    num_query_heads: int,
+    num_queries_per_kv: int,
+    head_size: int,
+    block_size: int,
+    num_seqs: int,
+) -> Optional[str]:
+    """Причина, з якої вхід не підходить ядру, або None."""
+    if not _hip_supports(num_queries_per_kv, head_size):
+        return f"head_size={head_size}, G={num_queries_per_kv}"
+    if _sliding_window(window_size) > 2**31 - 1:
+        return "ковзне вікно не вміщується в int32"
+    if alibi_slopes is not None:
+        return "alibi"
+    if softcap is not None and softcap > 0:
+        return "softcap"
+    if sinks is not None:
+        return "sinks"
+    if qq_bias is not None:
+        return "qq_bias"
+    if mm_prefix_range is not None:
+        return "мультимодальний префікс"
+    if not w4a8 or q_i8 is None or q_scale is None:
+        return "без W4A8"
+    if output_scale is not None:
+        return "fp8-вихід"
+    if packing_factor != 2:
+        return f"packing_factor={packing_factor}"
+    if out.dtype != torch.float16 or q.dtype != torch.float16:
+        return "вихід не fp16"
+    if k_cache.dtype != torch.uint8 or v_cache.dtype != torch.uint8:
+        return "тип кеша KV"
+    if q_i8.dtype != torch.int8 or q_scale.dtype != torch.float32:
+        return "тип q_i8/q_scale"
+    if k_scale_cache.dtype != torch.float32 or v_scale_cache.dtype != torch.float32:
+        return "тип масштабів KV"
+    for name, t in (("block_table", block_table), ("seqused_k", seqused_k),
+                    ("cu_seqlens_q", cu_seqlens_q)):
+        if t.dtype != torch.int32:
+            return f"{name} не int32"
+    if block_table.dim() != 2 or (block_table.size(1) > 1 and block_table.stride(1) != 1):
+        return "block_table не суцільна за рядком"
+    if seqused_k.stride(0) != 1 or cu_seqlens_q.stride(0) != 1:
+        return "seqused_k/cu_seqlens_q не суцільні"
+    if (block_table.size(0) < num_seqs or seqused_k.numel() < num_seqs
