@@ -0,0 +1,264 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Обробник логітів для збереження повного вектора логітів і обраних токенів.
+
+Призначення: дзеркальний прилад до llama.cpp зонда для покрокової звірки
+чисел (logits, token IDs, top-k розподіл).
+
+Щабель виклику:
+У семплері vLLM v1 (vllm/v1/sample/sampler.py) обробник із `is_argmax_invariant() == False`
+викликається в `apply_logits_processors` на ПОВНИХ float32 логітах ДО застосування
+штрафів (presence, frequency, repetition penalties) та ДО ділення на температуру.
+У жадібному режимі (temperature=0) це чисті вихідні логіти моделі.
+"""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+
+import vllm.envs as envs
+from vllm import SamplingParams
+from vllm.logger import init_logger
+from vllm.v1.sample.logits_processor.interface import (
+    BatchUpdate,
+    LogitsProcessor,
+    MoveDirectionality,
+)
+
+logger = init_logger(__name__)
+
+
+def _get_tp_rank() -> int:
+    try:
+        from vllm.distributed import get_tensor_model_parallel_rank
+
+        return get_tensor_model_parallel_rank()
+    except Exception:
+        return 0
+
+
+class DumpLogitsProcessor(LogitsProcessor):
+    """LogitsProcessor, що записує повний вектор логітів на кожному кроці."""
+
+    def __init__(
+        self, vllm_config, device: torch.device, is_pin_memory: bool
+    ) -> None:
+        self.device = device
+        self.vllm_config = vllm_config
+        self.tp_rank = _get_tp_rank()
+
+        output_dir_str = (
+            envs.VLLM_PROBE_OUTPUT_DIR or "/tmp/vllm-rdna2/probe"
+        )
+        self.output_dir = Path(output_dir_str)
+        self.save_per_step = envs.VLLM_PROBE_SAVE_PER_STEP
+        self.top_k_report = envs.VLLM_PROBE_TOP_K
+
+        self.step_idx = 0
+        self.steps_info: list[dict[str, Any]] = []
+        self.prompt_tokens: list[int] = []
+        self.prompt_text: str = envs.VLLM_PROBE_PROMPT_TEXT
+        self.model_name_or_path: str = (
+            vllm_config.model_config.model
+            if hasattr(vllm_config, "model_config")
+            else "unknown"
+        )
+        self.vocab_size = (
+            vllm_config.model_config.get_vocab_size()
+            if hasattr(vllm_config, "model_config")
+            else 248320
+        )
+
+        self.tokenizer = None
+        try:
+            from vllm.tokenizers.registry import get_tokenizer
+
+            mc = vllm_config.model_config
+            self.tokenizer = get_tokenizer(
+                mc.tokenizer,
+                trust_remote_code=mc.trust_remote_code,
+                revision=mc.tokenizer_revision,
+            )
+        except Exception as e:
+            logger.warning(
+                "Не вдалося ініціалізувати токенізатор для декодування шматочків: %s",
+                e,
+            )
+
+        # Тільки ранг 0 записує спільні файли логітів
+        if self.tp_rank == 0:
+            self.output_dir.mkdir(parents=True, exist_ok=True)
+            self.logits_bin_path = self.output_dir / "logits.bin"
+            self.tokens_bin_path = self.output_dir / "tokens.bin"
+            self.prompt_tokens_bin_path = self.output_dir / "prompt_tokens.bin"
+            self.logits_info_path = self.output_dir / "logits_info.txt"
+
+            # Очищуємо / створюємо нові файли
+            with open(self.logits_bin_path, "wb"):
+                pass
+            with open(self.tokens_bin_path, "wb"):
+                pass
+
+            logger.info(
+                "DumpLogitsProcessor ініціалізовано: вивід у %s (словник: %d)",
+                self.output_dir,
+                self.vocab_size,
+            )
+
+    def is_argmax_invariant(self) -> bool:
+        # ОБОВ'ЯЗКОВО False, щоб обробник викликався в non_argmax_invariant черзі
+        # перед застосуванням штрафів і діленням на температуру
+        return False
+
+    def update_state(self, batch_update: BatchUpdate | None) -> None:
+        if batch_update is None:
+            return
+
+        for idx, _params, prompt_tokens, _out_tokens in batch_update.added:
+            if idx == 0 and prompt_tokens is not None and not self.prompt_tokens:
+                self.prompt_tokens = list(prompt_tokens)
+                if self.tp_rank == 0:
+                    arr = np.array(self.prompt_tokens, dtype=np.int32)
+                    arr.tofile(str(self.prompt_tokens_bin_path))
+                    self._update_logits_info()
+
+    def _decode_piece(self, token_id: int) -> str:
+        if self.tokenizer is None:
+            return f"token_{token_id}"
+        try:
+            return self.tokenizer.decode([token_id], clean_up_tokenization_spaces=False)
+        except Exception:
+            return f"token_{token_id}"
+
+    def _update_logits_info(self) -> None:
+        """Оновлює текстовий звіт про логіти у форматі, збіжному з llama.cpp зондом."""
+        if self.tp_rank != 0:
+            return
+
+        lines: list[str] = []
+        lines.append("=" * 80)
+        lines.append("                         VLLM ЗОНД — ЗВІТ ПРО ЛОГІТИ")
+        lines.append("=" * 80)
+        lines.append("")
+        lines.append("Параметри моделі та генерації:")
+        lines.append(f"  Модель:                {self.model_name_or_path}")
+        lines.append(f"  Розмір словника (V):   {self.vocab_size}")
+        lines.append(f"  Кількість кроків (S):  {self.step_idx}")
+        lines.append("  Тип даних логітів:     float32 (4 байти на значення, Little-Endian)")
+        lines.append(f"  Розмірність logits.bin:[{self.step_idx}, {self.vocab_size}]")
+        total_bytes = self.step_idx * self.vocab_size * 4
+        lines.append(f"  Загальний розмір логітів: {total_bytes} байт")
+        lines.append(f"  Файл логітів:          logits.bin")
+        lines.append(f"  Файл токенів:          tokens.bin (int32, {self.step_idx * 4} байт)")
+        lines.append(f"  Файл токенів запиту:   prompt_tokens.bin (int32, {len(self.prompt_tokens) * 4} байт)")
+        if self.prompt_text:
+            lines.append(f'  Вхідний запит (prompt):"{self.prompt_text}"')
+        lines.append(f"  Кількість токенів запиту: {len(self.prompt_tokens)}")
+        lines.append("")
+
+        if self.prompt_tokens:
+            lines.append("Токени запиту (prompt tokens):")
+            for i, tid in enumerate(self.prompt_tokens):
+                piece = self._decode_piece(tid)
+                lines.append(f'  [{i}] id={tid} piece="{piece}"')
+            lines.append("")
+
+        lines.append("-" * 80)
+        lines.append("Деталізація кожного кроку генерації (Пояснення та Top-5 кандидатів):")
+        lines.append("-" * 80)
+        lines.append("")
+
+        for s_info in self.steps_info:
+            st = s_info["step"]
+            offset = s_info["offset_bytes"]
+            sel_id = s_info["selected_id"]
+            sel_piece = s_info["selected_piece"]
+            lines.append(f"Крок {st}:")
+            lines.append(
+                f"  Зсув у logits.bin:     {offset} байт (елементи [{st * self.vocab_size} .. {(st + 1) * self.vocab_size - 1}])"
+            )
+            lines.append(f'  Обраний токен:         id={sel_id} piece="{sel_piece}"')
+            lines.append(f"  Топ-{len(s_info['candidates'])} кандидатів за спаданням логітів:")
+            for rank_k, cand in enumerate(s_info["candidates"], 1):
+                cid = cand["id"]
+                clog = cand["logit"]
+                cpr = cand["prob"]
+                cpi = cand["piece"]
+                lines.append(
+                    f'    {rank_k}. id={cid:7d} | logit={clog:9.4f} | prob={cpr:9.6f} | piece="{cpi}"'
+                )
+            lines.append("")
+
+        with open(self.logits_info_path, "w", encoding="utf-8") as f:
+            f.write("\n".join(lines) + "\n")
+
+    def apply(self, logits: torch.Tensor) -> torch.Tensor:
+        if self.tp_rank != 0:
+            return logits
+
+        # Працюємо з першим запитом у батчі (індекс 0)
+        if logits.shape[0] == 0:
+            return logits
+
+        # Переводимо у float32 на CPU
+        l_row = logits[0].detach().to(dtype=torch.float32, device="cpu").contiguous()
+
+        # Визначаємо обраний токен (жадібний argmax)
+        selected_id = int(torch.argmax(l_row).item())
+        selected_piece = self._decode_piece(selected_id)
+
+        # Рахуємо ймовірності через softmax для звіту
+        probs = torch.softmax(l_row, dim=-1)
+        top_k = min(self.top_k_report, l_row.shape[0])
+        top_vals, top_indices = torch.topk(l_row, top_k)
+        top_probs = probs[top_indices]
+
+        candidates = []
+        for i in range(top_k):
+            cid = int(top_indices[i].item())
+            clog = float(top_vals[i].item())
+            cprob = float(top_probs[i].item())
+            cpiece = self._decode_piece(cid)
+            candidates.append(
+                {
+                    "id": cid,
+                    "logit": clog,
+                    "prob": cprob,
+                    "piece": cpiece,
+                }
+            )
+
+        offset_bytes = self.step_idx * self.vocab_size * 4
+
+        # Дописуємо логіти в logits.bin
+        l_np = l_row.numpy()
+        with open(self.logits_bin_path, "ab") as f:
+            l_np.tofile(f)
+
+        # Дописуємо токен у tokens.bin
+        with open(self.tokens_bin_path, "ab") as f:
+            np.array([selected_id], dtype=np.int32).tofile(f)
+
+        # Окремий файл кроку (якщо увімкнено)
+        if self.save_per_step:
+            step_file = self.output_dir / f"logits_step_{self.step_idx:04d}.bin"
+            l_np.tofile(str(step_file))
+
+        self.steps_info.append(
+            {
+                "step": self.step_idx,
+                "offset_bytes": offset_bytes,
+                "selected_id": selected_id,
+                "selected_piece": selected_piece,
+                "candidates": candidates,
+            }
+        )
+
+        self.step_idx += 1
+        self._update_logits_info()
+
+        return logits
diff --git a/vllm/v1/sample/logits_processor/probe_hooks.py b/vllm/v1/sample/logits_processor/probe_hooks.py
