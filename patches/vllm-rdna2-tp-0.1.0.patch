+class _PinnedPool:
+    """Пул закріплених буферів хоста, що виділяються один раз (форк gfx1030).
+
+    Виділення закріпленої пам'яті під новий розмір коштує сотні мілісекунд
+    (720 мс для 84 МБ), тож робити його на кожну передачу між стадіями PP не
+    можна. Буфер — суцільний `uint8`; беруть найменший вільний із місткістю не
+    меншою за потрібну, інакше виділяють новий. Пул безпечний щодо повторного
+    використання, бо буфер повертається лише тоді, коли з нього вже ніхто не
+    читає й не пише:
+      * відправка: фоновий потік `give` після того, як gloo send завершився;
+      * прийом: `hold` тримає буфер, доки подія копії хост -> карта не
+        виконана (`event.query()`, перевіряється ліниво в `take`).
+    Виділення йде поза замком: воно повільне, а фоновий потік не мусить
+    через нього чекати з `give`.
+    """
+
+    def __init__(self, name: str, pin_memory: bool) -> None:
+        self._name = name
+        self._pin_memory = pin_memory
+        self._lock = threading.Lock()
+        self._free: list[torch.Tensor] = []
+        self._busy: list[tuple[Any, torch.Tensor]] = []
+        self.allocations = 0
+
+    def take(self, nbytes: int) -> torch.Tensor:
+        with self._lock:
+            still_busy = []
+            for event, buf in self._busy:
+                if event.query():
+                    self._free.append(buf)
+                else:
+                    still_busy.append((event, buf))
+            self._busy = still_busy
+            fit = [b for b in self._free if b.numel() >= nbytes]
+            if fit:
+                best = min(fit, key=lambda b: b.numel())
+                self._free = [b for b in self._free if b is not best]
+                return best
+        capacity = -(-nbytes // _PINNED_POOL_GRANULE) * _PINNED_POOL_GRANULE
+        buf = torch.empty(capacity, dtype=torch.uint8, pin_memory=self._pin_memory)
+        with self._lock:
+            self.allocations += 1
+            count = self.allocations
+        logger.debug(
+            "закріплений пул %s: нове виділення %d байт (потрібно %d), усього %d",
+            self._name,
+            capacity,
+            nbytes,
+            count,
+        )
+        return buf
+
+    def take_view(
+        self, shape: torch.Size | tuple[int, ...], dtype: torch.dtype
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Повертає (суцільний вигляд потрібної форми, буфер для give/hold)."""
+        numel = math.prod(shape)
+        nbytes = numel * torch.empty(0, dtype=dtype).element_size()
+        buf = self.take(nbytes)
+        return buf[:nbytes].view(dtype).view(shape), buf
