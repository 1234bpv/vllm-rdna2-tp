+    # сторінки росте на цілу частину співвідношення (16 → 32), доповнюється лише залишок;
+    # без нього — доповнення на все співвідношення при незмінному блоці (як в апстрімі).
+    monkeypatch.setattr(kv_cache_utils.envs, "VLLM_KV_PAGE_GROW_BLOCK", grow)
+    full = new_kv_cache_spec(head_size=64, indexes_kv_by_block_stride=True)
+    swa = new_sliding_window_spec(head_size=136, indexes_kv_by_block_stride=True)
+    unified = kv_cache_utils.unify_kv_cache_spec_page_size(
+        {"layer_1": full, "layer_2": swa}
+    )
+    assert unified["layer_2"] == swa
+    got = unified["layer_1"]
+    assert got.page_size_bytes == swa.page_size_bytes
+    if grow:
+        assert got.block_size == 32
+        assert got.unpadded_page_size_bytes == 2 * full.page_size_bytes
+    else:
+        assert got.block_size == 16
+        assert got.unpadded_page_size_bytes == full.page_size_bytes
+    assert got.page_size_padded == swa.page_size_bytes
