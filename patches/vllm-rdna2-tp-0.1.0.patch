+"""Спільне складання JIT-розширень HIP для gfx1030.
+
+Тека збірки torch (`~/.cache/torch_extensions/<py_torch>/<name>`) спільна для
+всіх процесів і всіх робочих дерев форку. Тому ім'я розширення містить хеш
+усього, від чого залежить результат: вмісту джерела та локальних заголовків,
+прапорців, архітектури й теки джерела. Так кожне дерево й кожна версія
+джерела мають власну теку, а `.so`, який уже тримає відображеним інший
+процес, ніколи не перезаписується (HIP читає кодові об'єкти з відображеного
+файлу ліниво, тож підміна на місці псує код, що виконується на карті).
+
+Абсолютний шлях джерела входить у `build.ninja`, тож без шляху в хеші процес
+з іншого дерева переписував би `build.ninja` й ninja перезбирав би `.o` та
+`.so` в тій самій теці навіть за однакового вмісту.
+
+Про hipify. Для джерела, яке вже написано мовою HIP, torch пише «skipped, no
+changes» і нічого не створює. Якщо ж hipify щось замінює, він кладе поруч
+`<ім'я>_hip.hip` і переписує його лише тоді, коли вміст відрізняється
+(`hipify_python.py`: `do_write = fout_old.read() != output_source`), тож
+mtime не змінюється щоразу й ninja не перезбирає `.o` при кожному старті.
+Згенерований файл лежить у теці джерела, тобто окремий для кожного дерева;
+хеш у імені розширення цього не змінює й не потребує.
+"""
+
+import hashlib
+import os
+import re
+from typing import Any
+
+_HASH_LEN = 12
+_LOCAL_INCLUDE = re.compile(rb'^\s*#\s*include\s*"([^"]+)"', re.MULTILINE)
+
+
+def _local_headers(source: str) -> list[str]:
+    """Заголовки з теки джерела, які воно підключає (рекурсивно)."""
+    src_dir = os.path.dirname(os.path.realpath(source))
+    found: dict[str, None] = {}
+    todo = [os.path.realpath(source)]
+    while todo:
+        path = todo.pop()
+        with open(path, "rb") as f:
+            text = f.read()
+        for m in _LOCAL_INCLUDE.finditer(text):
+            header = os.path.realpath(os.path.join(src_dir, m.group(1).decode()))
+            if header not in found and os.path.isfile(header):
+                found[header] = None
+                todo.append(header)
+    return sorted(found)
+
+
+def rdna_ext_name(base_name: str, source: str, extra_cuda_cflags: list[str]) -> str:
+    """Ім'я розширення `<base_name>_<хеш>`; стале для однакових вхідних."""
+    h = hashlib.sha1()
+
+    def add(label: bytes, data: bytes) -> None:
+        # Довжина поля не дає двом різним наборам склеїтися в однаковий потік.
+        h.update(label + str(len(data)).encode() + b":" + data)
+
+    with open(source, "rb") as f:
+        add(b"src", f.read())
+    for header in _local_headers(source):
+        with open(header, "rb") as f:
+            add(b"hdr:" + os.path.basename(header).encode(), f.read())
+    add(b"flags", "\0".join(extra_cuda_cflags).encode())
+    add(b"arch", os.environ.get("PYTORCH_ROCM_ARCH", "").encode())
+    add(b"dir", os.path.dirname(os.path.realpath(source)).encode())
+    return f"{base_name}_{h.hexdigest()[:_HASH_LEN]}"
+
+
+def load_rdna_ext(base_name: str, source: str, extra_cuda_cflags: list[str]) -> Any:
+    """Зібрати (за потреби) і завантажити розширення з ім'ям, що містить хеш.
+
+    Викликає `torch.utils.cpp_extension.load`; збірку між рангами TP
+    серіалізує `FileBaton` у теці збірки (файл `lock`).
+    """
+    from torch.utils.cpp_extension import load
+
+    if "PYTORCH_ROCM_ARCH" not in os.environ:
+        os.environ["PYTORCH_ROCM_ARCH"] = "gfx1030"
+    return load(
+        name=rdna_ext_name(base_name, source, extra_cuda_cflags),
+        sources=[source],
+        extra_cuda_cflags=extra_cuda_cflags,
+        verbose=False,
+    )
