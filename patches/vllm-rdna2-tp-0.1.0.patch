+        return "метадані коротші за num_seqs"
+    if q_i8.dim() != 3 or q_i8.stride(2) != 1:
+        return "q_i8 не суцільний за виміром голови"
+    if q_i8.size(0) < q.size(0) or q_i8.size(1) < num_query_heads or q_i8.size(2) < head_size:
+        return "q_i8 менший за q"
+    if q_scale.dim() != 2 or q_scale.size(0) < q.size(0) or q_scale.size(1) < num_query_heads:
+        return "q_scale менший за q"
+    if k_cache.stride(3) != 1 or v_cache.stride(3) != 1:
+        return "кеш KV не суцільний за внутрішнім виміром"
+    # група з 16 ключів мусить лежати в одному блоці кеша
+    if block_size % 16 != 0:
+        return f"block_size={block_size}"
