+    def hold(self, buf: torch.Tensor, device: torch.device) -> None:
+        """Віддає буфер пулу після завершення вже поставленої в потік копії."""
+        event = torch.cuda.Event()
+        event.record(torch.cuda.current_stream(device))
+        with self._lock:
