+
+
+# ── Функції, що виконуються В РОБОЧИХ ПРОЦЕСАХ ────────────────────────────────
+# ⚠️ Вони мусять бути МОДУЛЬНОГО рівня. apply_model пересилає функцію у процеси
+# воркерів через pickle, а той пакує функції лише за іменем «модуль.функція».
+# Вкладена функція власного імені не має, і спроба дала
+# "Can't pickle local object 'worker_init_probe.<locals>._init_fn'".
+# Налаштування передаємо змінними середовища, які воркери успадковують самі.
+
+def init_probe(model: "nn.Module") -> bool:
+    """Створює менеджер зачепів і чіпляє його до моделі (у воркері)."""
+    global _WORKER_PROBE_MANAGER
+    tp_rank, tp_size = 0, 1
+    try:
+        from vllm.distributed import (
+            get_tensor_model_parallel_rank,
+            get_tensor_model_parallel_world_size,
+        )
+        tp_rank = get_tensor_model_parallel_rank()
+        tp_size = get_tensor_model_parallel_world_size()
+    except Exception:
+        pass
+
+    import vllm.envs as envs
+
+    шари = [int(x) for x in envs.VLLM_PROBE_LAYERS.split(",") if x.strip()]
+    взірець = envs.VLLM_PROBE_HOOK_PATTERN
+    тека = envs.VLLM_PROBE_OUTPUT_DIR
+    if not тека:
+        raise KeyError("VLLM_PROBE_OUTPUT_DIR: для зачепів зонда тека обов'язкова")
+    _WORKER_PROBE_MANAGER = ProbeHookManager(
+        output_dir=тека,
+        layer_indices=шари,
+        save_all_layers=envs.VLLM_PROBE_ALL_LAYERS,
+        hook_pattern=взірець,
+        tp_rank=tp_rank,
+        tp_world_size=tp_size,
+    )
+    _WORKER_PROBE_MANAGER.attach_to_model(model)
+    return True
+
+
+def finalize_probe(model: "nn.Module") -> bool:
+    """Знімає зачепи з моделі (у воркері)."""
+    global _WORKER_PROBE_MANAGER
+    if _WORKER_PROBE_MANAGER is not None:
+        _WORKER_PROBE_MANAGER.detach()
+        _WORKER_PROBE_MANAGER = None
+    return True
