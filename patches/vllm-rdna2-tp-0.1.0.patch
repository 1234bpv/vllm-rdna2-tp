@@ -0,0 +1,1105 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Розподіл запитів декоду на мікропакети при конвеєрному паралелізмі (PP).
+
+Тести написано від специфікації, а не від реалізації. Вони імітують чергу
+пакетів рушія (`EngineCore.step_with_batch_queue`) без GPU:
+
+* поки черга не повна, рушій кличе `scheduler.schedule()` і кладе результат
+  у чергу — зокрема й порожній пакет, якщо в планувальнику є запити;
+* коли черга повна, рушій бере НАЙСТАРІШИЙ пакет і лише тоді кличе для нього
+  `scheduler.update_from_output()`; кожен запланований запит отримує один
+  новий токен.
+
+Специфікація (pp_size=3, сталий режим декоду, усі N запитів декодують):
+
+1. Розміри непорожніх мікропакетів, що одночасно перебувають у черзі:
+   N=1 -> [1]; 2 -> [1,1]; 3 -> [1,1,1]; 4 -> [2,1,1]; 5 -> [2,2,1];
+   6 -> [2,2,2]; 8 -> [3,3,2] (порядок довільний).
+2. Справедливість: за 30 оборотів кожен запит отримує однакову кількість
+   токенів +-1; жоден не голодує.
+3. Шматки префілу не блокуються капом декоду.
+4. Без PP (pipeline_parallel_size=1) усі декодуючі запити в одному пакеті.
+5. Число непорожніх пакетів у дорозі ніколи не перевищує 3.
+
+Доповнення після рецензії:
+
+A. Запити приходять не разом (N0 декодують, потім k нових — коротких чи
+   довгих): не пізніше 5 оборотів після того, як усі декодують, групи — як
+   у таблиці для N=N0+k; найбільша група не перевищує ceil(N/3).
+B. Справедливість під час вирівнювання: кожне вікно з 3 оборотів дає
+   кожному >=1 токен; за 30 оборотів різниця <=1.
+C. `scheduler._pp_steps_in_flight` після кожного кроку дорівнює числу
+   непорожніх пакетів у черзі.
+D. Краї: витіснення через брак KV, скасування запиту зі шматком префілу в
+   дорозі, шматки префілу, що вичерпують бюджет перед декодами.
+E. Асинхронний шлях (async_scheduling=True, PP=3) не змінився проти HEAD.
+"""
+
+import subprocess
+import types
+from collections import Counter, deque
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import pytest
+
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.outputs import ModelRunnerOutput
+from vllm.v1.request import RequestStatus
+
+from .utils import create_requests, create_scheduler
+
+pytestmark = pytest.mark.cpu_test
+
+PP_SIZE = 3
+SHORT_PROMPT = 8
+# Великий запас: за сотні кроків тесту жоден запит не має завершитися.
+LONG_MAX_TOKENS = 2000
+# opt-125m має 2048 позицій; більше значення модель мовчки обрізає.
+MAX_MODEL_LEN = 2048
+
+# Специфікація, пункт 1.
+EXPECTED_STEADY_SIZES = {
+    1: [1],
+    2: [1, 1],
+    3: [1, 1, 1],
+    4: [2, 1, 1],
+    5: [2, 2, 1],
+    6: [2, 2, 2],
+    8: [3, 3, 2],
+}
+
+# Скільки оборотів черги дати на вихід у сталий режим і скільки перевіряти.
+# Оборот — pp_size викликів schedule() (стільки пакетів уміщує черга).
+WARMUP_TURNS = 10
+CHECK_TURNS = 10
+FAIRNESS_TURNS = 30
+
+
+@pytest.fixture(autouse=True)
+def _default_microbatch_env(monkeypatch):
+    """Перевіряємо ТИПОВУ поведінку: жодних ручних перемикачів із оточення."""
+    monkeypatch.delenv("VLLM_PP_MICROBATCH_SPLIT", raising=False)
+
+
+def _model_output_for(
+    scheduler_output: SchedulerOutput, partial_prefill_ids: frozenset[str]
+) -> ModelRunnerOutput:
+    """Кожен запланований запит отримує рівно один новий токен — крім
+    шматків префілу, що не дійшли до кінця промпта: для них виконавець,
+    як і справжній, повертає порожній перелік (токен відкинуто)."""
+    req_ids = list(scheduler_output.num_scheduled_tokens.keys())
+    return ModelRunnerOutput(
+        req_ids=req_ids,
+        req_id_to_index={rid: i for i, rid in enumerate(req_ids)},
+        sampled_token_ids=[
+            [] if rid in partial_prefill_ids else [1] for rid in req_ids
+        ],
+        logprobs=None,
+        prompt_logprobs_dict={},
+        pooler_output=[],
+    )
+
+
+def _partial_prefill_ids(scheduler, scheduler_output: SchedulerOutput):
+    """Викликати ОДРАЗУ після schedule(): запити, чий шматок цього пакета
+    не завершує промпт."""
+    return frozenset(
+        rid for rid in scheduler_output.num_scheduled_tokens
+        if scheduler.requests[rid].is_prefill_chunk
+    )
+
+
+@dataclass
+class EngineSim:
+    """Імітація `step_with_batch_queue` для не-асинхронного планування."""
+
+    scheduler: object
+    queue_size: int
+    queue: deque = field(default_factory=deque)
+    # id(пакета) -> запити з незавершеним шматком префілу в ньому.
+    partial_prefill: dict = field(default_factory=dict)
+    # Знімки черги в мить, коли вона повна (перед вийманням найстарішого).
+    full_queue_snapshots: list[list[SchedulerOutput]] = field(default_factory=list)
+    # Скільки токенів отримав кожен запит (за викликами update_from_output).
+    tokens_received: Counter = field(default_factory=Counter)
+    # Усі пакети, що пройшли через schedule(), у порядку створення.
+    scheduled: list[SchedulerOutput] = field(default_factory=list)
+    max_nonempty_in_flight: int = 0
+    double_scheduled: list[tuple[int, str]] = field(default_factory=list)
+    # Номер поточного виклику step() (з нуля).
+    num_steps: int = 0
+    # (крок, scheduler._pp_steps_in_flight або None, непорожніх у черзі)
+    # після кожного step() — для інваріанта лічильника (пункт C).
+    counter_log: list[tuple[int, int | None, int]] = field(default_factory=list)
+    # Кроки, на яких сталося витіснення (з preempted_req_ids пакета) або
+    # тест скасував запит (mark_event).
+    events: list[int] = field(default_factory=list)
+
+    def mark_event(self) -> None:
+        self.events.append(self.num_steps)
+
+    def nonempty_in_queue(self) -> int:
+        return sum(1 for so in self.queue if so.total_num_scheduled_tokens > 0)
+
+    def _check_in_flight_invariants(self) -> None:
+        nonempty = [
+            so for so in self.queue if so.total_num_scheduled_tokens > 0
+        ]
+        self.max_nonempty_in_flight = max(self.max_nonempty_in_flight, len(nonempty))
+        # Запит декоду не може бути одночасно в двох пакетах у дорозі:
+        # його наступний токен ще не відомий. Шматки префілу — виняток,
+        # вони можуть іти один за одним без очікування.
+        seen: Counter = Counter()
+        for so in self.queue:
+            for rid in so.num_scheduled_tokens:
+                request = self.scheduler.requests.get(rid)
+                if request is not None and request.num_output_tokens > 0:
+                    seen[rid] += 1
+        for rid, count in seen.items():
+            if count > 1:
+                self.double_scheduled.append((len(self.scheduled), rid))
+
+    def step(self) -> SchedulerOutput | None:
+        """Один виклик `step_with_batch_queue`. Повертає пакет, щойно
+        доданий у чергу (або None, якщо планувальник порожній)."""
+        new_batch = self._step()
+        if new_batch is not None and new_batch.preempted_req_ids:
+            self.events.append(self.num_steps)
+        self.counter_log.append((
+            self.num_steps,
+            getattr(self.scheduler, "_pp_steps_in_flight", None),
+            self.nonempty_in_queue(),
+        ))
+        self.num_steps += 1
+        return new_batch
+
+    def _step(self) -> SchedulerOutput | None:
+        assert len(self.queue) < self.queue_size
+        new_batch = None
+        if self.scheduler.has_requests():
+            new_batch = self.scheduler.schedule()
+            self.scheduled.append(new_batch)
+            self.partial_prefill[id(new_batch)] = _partial_prefill_ids(
+                self.scheduler, new_batch
+            )
+            # appendleft/pop, як у рушії: найстаріший — праворуч.
+            self.queue.appendleft(new_batch)
+            self._check_in_flight_invariants()
+            model_executed = new_batch.total_num_scheduled_tokens > 0
+            if len(self.queue) < self.queue_size and (
+                model_executed or self.scheduler.has_requests()
+            ):
+                return new_batch
+        elif not self.queue:
+            return None
+
+        if len(self.queue) == self.queue_size:
+            self.full_queue_snapshots.append(list(self.queue))
+        oldest = self.queue.pop()
+        partial = self.partial_prefill.pop(id(oldest))
+        for rid in oldest.num_scheduled_tokens:
+            if rid not in partial:
+                self.tokens_received[rid] += 1
+        self.scheduler.update_from_output(
+            oldest, _model_output_for(oldest, partial)
+        )
+        return new_batch
+
+    def run_turns(self, turns: int) -> None:
+        for _ in range(turns * self.queue_size):
+            self.step()
+
+
+def _nonempty_sizes(snapshot: list[SchedulerOutput]) -> list[int]:
+    return sorted(
+        (len(so.num_scheduled_tokens) for so in snapshot
+         if so.total_num_scheduled_tokens > 0),
+        reverse=True,
+    )
+
+
+def _make_pp_scheduler(pp_size: int = PP_SIZE, **kwargs):
+    kwargs.setdefault("max_num_seqs", 16)
+    kwargs.setdefault("max_num_batched_tokens", 2048)
+    kwargs.setdefault("max_model_len", MAX_MODEL_LEN)
+    return create_scheduler(
+        pipeline_parallel_size=pp_size,
+        async_scheduling=False,
+        **kwargs,
+    )
+
+
+def _start_decoding(num_requests: int, pp_size: int = PP_SIZE, **kwargs):
+    """Піднімає планувальник і імітацію рушія, додає N коротких запитів і
+    крутить рушій, доки кожен не вийде з префілу в декод."""
+    scheduler = _make_pp_scheduler(pp_size, **kwargs)
+    queue_size = scheduler.vllm_config.max_concurrent_batches
+    engine = EngineSim(scheduler=scheduler, queue_size=queue_size)
+    requests = create_requests(
+        num_requests=num_requests,
+        num_tokens=SHORT_PROMPT,
+        max_tokens=LONG_MAX_TOKENS,
+        ignore_eos=True,
+    )
+    for req in requests:
+        scheduler.add_request(req)
+
+    for _ in range(20 * queue_size):
+        if all(r.num_output_tokens > 0 for r in requests):
+            break
+        engine.step()
+    assert all(r.num_output_tokens > 0 for r in requests), (
+        "Короткі промпти мали пройти префіл за кілька кроків; "
+        f"output_tokens={[r.num_output_tokens for r in requests]}"
+    )
+    return scheduler, engine, requests
+
+
+# ---------------------------------------------------------------------------
+# Стенд: спершу переконатися, що імітація рушія відповідає рушію.
+# ---------------------------------------------------------------------------
+
+
+def test_sim_queue_size_equals_pp_size_without_async():
+    """Рушій тримає чергу на pp_size пакетів при PP без асинхронного
+    планування; інакше решта тестів імітує не той рушій."""
+    scheduler = _make_pp_scheduler()
+    assert scheduler.vllm_config.max_concurrent_batches == PP_SIZE
+
+
+def test_sim_short_prompts_finish_prefill_in_one_batch():
+    """Короткі промпти мають пройти префіл одним пакетом — передумова того,
+    що сталий режим декоду досяжний на коротких відрізках."""
+    scheduler = _make_pp_scheduler()
+    requests = create_requests(
+        num_requests=4, num_tokens=SHORT_PROMPT,
+        max_tokens=LONG_MAX_TOKENS, ignore_eos=True,
+    )
+    for req in requests:
+        scheduler.add_request(req)
+    first = scheduler.schedule()
+    assert first.num_scheduled_tokens == {
+        r.request_id: SHORT_PROMPT for r in requests
+    }
+
+
+def test_sim_request_with_token_in_flight_is_not_rescheduled():
+    """Контракт, на який спирається імітація: запит, чий токен ще в дорозі
+    (заплановано, update ще не було), повторно не планується."""
+    scheduler = _make_pp_scheduler()
+    (req,) = create_requests(
+        num_requests=1, num_tokens=SHORT_PROMPT,
+        max_tokens=LONG_MAX_TOKENS, ignore_eos=True,
+    )
+    scheduler.add_request(req)
+    first = scheduler.schedule()
+    assert req.request_id in first.num_scheduled_tokens
+    second = scheduler.schedule()
+    assert req.request_id not in second.num_scheduled_tokens
+    assert second.total_num_scheduled_tokens == 0
+
+
+# ---------------------------------------------------------------------------
+# Специфікація, пункт 1: розміри мікропакетів у сталому режимі.
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "num_requests", sorted(EXPECTED_STEADY_SIZES), ids=lambda n: f"N={n}"
+)
+def test_steady_state_microbatch_sizes(num_requests: int):
+    """Кожен знімок повної черги в сталому режимі має непорожні пакети
+    саме тих розмірів, що в специфікації."""
+    _, engine, _ = _start_decoding(num_requests)
+    engine.run_turns(WARMUP_TURNS)
+    engine.full_queue_snapshots.clear()
+    engine.run_turns(CHECK_TURNS)
+
+    expected = EXPECTED_STEADY_SIZES[num_requests]
+    observed = [_nonempty_sizes(s) for s in engine.full_queue_snapshots]
+    assert len(observed) >= CHECK_TURNS * PP_SIZE - 1, (
+        f"Черга мала бути повною щокроку; знімків {len(observed)}"
+    )
+    wrong = [(i, sizes) for i, sizes in enumerate(observed) if sizes != expected]
+    assert not wrong, (
+        f"N={num_requests}: очікувано {expected} у кожному знімку повної "
+        f"черги; невідповідних знімків {len(wrong)} з {len(observed)}; "
+        f"перші: {wrong[:6]}"
+    )
+
+
+@pytest.mark.parametrize(
+    "num_requests", sorted(EXPECTED_STEADY_SIZES), ids=lambda n: f"N={n}"
+)
+def test_steady_state_all_requests_in_flight(num_requests: int):
+    """Наслідок пункту 1: сума розмірів непорожніх пакетів у повній черзі
+    дорівнює N — жоден декодуючий запит не простоює поза конвеєром."""
+    _, engine, _ = _start_decoding(num_requests)
+    engine.run_turns(WARMUP_TURNS)
+    engine.full_queue_snapshots.clear()
+    engine.run_turns(CHECK_TURNS)
+
+    totals = [sum(_nonempty_sizes(s)) for s in engine.full_queue_snapshots]
+    assert totals and all(t == num_requests for t in totals), (
+        f"N={num_requests}: у дорозі мало бути {num_requests} запитів; "
+        f"спостережено {Counter(totals)}"
+    )
+
+
+# ---------------------------------------------------------------------------
+# Специфікація, пункт 2: справедливість.
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "num_requests", sorted(EXPECTED_STEADY_SIZES), ids=lambda n: f"N={n}"
+)
+def test_fairness_tokens_per_request_within_one(num_requests: int):
+    """За 30 оборотів після виходу з префілу кожен запит отримує однакову
+    кількість токенів з точністю до одного."""
+    _, engine, requests = _start_decoding(num_requests)
+    before = {r.request_id: engine.tokens_received[r.request_id] for r in requests}
+    engine.run_turns(FAIRNESS_TURNS)
+    gained = {
+        r.request_id: engine.tokens_received[r.request_id] - before[r.request_id]
+        for r in requests
+    }
+    assert max(gained.values()) - min(gained.values()) <= 1, (
+        f"N={num_requests}: токени за {FAIRNESS_TURNS} оборотів "
+        f"розподілено нерівно: {gained}"
+    )
+
+
+@pytest.mark.parametrize(
+    "num_requests", sorted(EXPECTED_STEADY_SIZES), ids=lambda n: f"N={n}"
+)
+def test_fairness_no_request_starves(num_requests: int):
+    """Жоден запит не голодує: у кожному вікні з трьох оборотів кожен
+    запит отримує принаймні один токен."""
+    _, engine, requests = _start_decoding(num_requests)
+    engine.run_turns(WARMUP_TURNS)
+    starved = []
+    for window in range(FAIRNESS_TURNS // 3):
+        before = dict(engine.tokens_received)
+        engine.run_turns(3)
+        for r in requests:
+            if engine.tokens_received[r.request_id] == before.get(r.request_id, 0):
+                starved.append((window, r.request_id))
+    assert not starved, (
+        f"N={num_requests}: запити без жодного токена за три оборотів "
+        f"(вікно, запит): {starved[:10]}"
+    )
+
+
+# ---------------------------------------------------------------------------
+# Специфікація, пункт 3: префіл не блокується капом декоду.
+# ---------------------------------------------------------------------------
+
+LONG_PROMPT = 1500
+SMALL_BUDGET = 256
+
+
+@pytest.mark.parametrize("num_decoding", [4, 6], ids=lambda n: f"N={n}")
+def test_prefill_chunks_advance_every_step_during_decode(num_decoding: int):
+    """Новий запит із довгим промптом (кілька шматків chunked prefill)
+    отримує шматок префілу в кожному виклику schedule(), доки префіл не
+    завершиться, хоча поруч декодують N запитів під капом."""
+    scheduler, engine, _ = _start_decoding(
+        num_decoding, max_num_batched_tokens=SMALL_BUDGET
+    )
+    engine.run_turns(WARMUP_TURNS)
+
+    (long_req,) = create_requests(
+        num_requests=1, num_tokens=LONG_PROMPT, max_tokens=100,
+        ignore_eos=True, req_ids=["long"],
+    )
+    scheduler.add_request(long_req)
+    first_index = len(engine.scheduled)
+
+    stalls = []
+    chunks = []
+    for _ in range(200):
+        if long_req.num_computed_tokens >= LONG_PROMPT:
+            break
+        batch = engine.step()
+        assert batch is not None
+        n = batch.num_scheduled_tokens.get("long", 0)
+        chunks.append(n)
+        decode_tokens = batch.total_num_scheduled_tokens - n
+        # «Коли є бюджет»: бюджету лишалося щонайменше на один токен.
+        if n == 0 and decode_tokens < SMALL_BUDGET:
+            stalls.append(len(engine.scheduled) - 1 - first_index)
+
+    assert long_req.num_computed_tokens >= LONG_PROMPT, (
+        f"Префіл {LONG_PROMPT} токенів не завершився за 200 кроків; "
+        f"обчислено {long_req.num_computed_tokens}; шматки {chunks}"
+    )
+    assert len(chunks) >= 2, "Промпт мав іти кількома шматками"
+    assert not stalls, (
+        f"N={num_decoding}: кроки без шматка префілу при вільному бюджеті "
+        f"(номери кроків від додавання запиту): {stalls}; шматки {chunks}"
+    )
+
+
+@pytest.mark.parametrize("num_decoding", [4, 6], ids=lambda n: f"N={n}")
+def test_prefill_does_not_stop_decoding(num_decoding: int):
+    """Поки йде довгий префіл, декод N запитів не зупиняється: кожен
+    отримує токени, а черга не складається з порожніх для декоду пакетів."""
+    scheduler, engine, requests = _start_decoding(
+        num_decoding, max_num_batched_tokens=SMALL_BUDGET
+    )
+    engine.run_turns(WARMUP_TURNS)
+    (long_req,) = create_requests(
+        num_requests=1, num_tokens=LONG_PROMPT, max_tokens=100,
+        ignore_eos=True, req_ids=["long"],
+    )
+    scheduler.add_request(long_req)
+    before = dict(engine.tokens_received)
+    engine.run_turns(3)
+    stalled = [
+        r.request_id for r in requests
+        if engine.tokens_received[r.request_id] == before.get(r.request_id, 0)
+    ]
+    assert not stalled, (
+        f"Під час префілу за три обороти декод не отримали: {stalled}"
+    )
