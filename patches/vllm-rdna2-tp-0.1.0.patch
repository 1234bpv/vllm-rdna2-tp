+def try_launch_int4_prefill_attn(
+    *,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    out: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    seqused_k: torch.Tensor,
+    softmax_scale: float,
+    window_size: Tuple[int, int],
+    block_table: torch.Tensor,
+    softcap: Optional[float],
+    sinks: Optional[torch.Tensor],
+    alibi_slopes: Optional[torch.Tensor],
+    qq_bias: Optional[torch.Tensor],
+    output_scale: Optional[float],
+    mm_prefix_range: Optional[torch.Tensor],
+    k_scale_cache: torch.Tensor,
+    v_scale_cache: torch.Tensor,
+    packing_factor: int,
+    q_i8: Optional[torch.Tensor],
+    q_scale: Optional[torch.Tensor],
+    w4a8: bool,
+    num_query_heads: int,
+    num_kv_heads: int,
+    num_queries_per_kv: int,
+    head_size: int,
+    block_size: int,
+    num_seqs: int,
+) -> bool:
+    """Запустити HIP-ядро префілу; False — вхід не підходить, іде Triton."""
+    reason = _unsupported_reason(
+        q=q, out=out, k_cache=k_cache, v_cache=v_cache,
+        cu_seqlens_q=cu_seqlens_q, seqused_k=seqused_k,
+        window_size=window_size, block_table=block_table, softcap=softcap,
+        sinks=sinks, alibi_slopes=alibi_slopes, qq_bias=qq_bias,
+        output_scale=output_scale, mm_prefix_range=mm_prefix_range,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache,
+        packing_factor=packing_factor, q_i8=q_i8, q_scale=q_scale,
+        w4a8=w4a8, num_query_heads=num_query_heads,
+        num_queries_per_kv=num_queries_per_kv, head_size=head_size,
+        block_size=block_size, num_seqs=num_seqs,
+    )
+    if reason is not None:
+        # Без сліду відступ на Triton непомітний: замір із прапорцем hip
+        # міряв би Triton.
+        logger.info_once("HIP-ядро префілу не застосовне, відступ на Triton: %s", reason)
+        return False
+
+    ext = int4_prefill_attn_ext()
+    if ext is None:
+        return False
+
+    ext.int4_prefill_attn(
+        out,
+        q_i8,
+        q_scale,
+        k_cache,
+        v_cache,
+        k_scale_cache,
+        v_scale_cache,
+        block_table,
+        seqused_k,
+        cu_seqlens_q,
+        float(softmax_scale),
+        int(num_seqs),
+        int(num_query_heads),
+        int(num_kv_heads),
+        int(num_queries_per_kv),
+        int(head_size),
+        int(block_size),
+        _sliding_window(window_size),
+    )
+    return True
