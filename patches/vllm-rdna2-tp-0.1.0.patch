+# D3. Шматки префілу, що вичерпують бюджет ПЕРЕД декодами.
+#
+# При FCFS без витіснень такий порядок у `running` недосяжний: декодуючий
+# запит допускається лише на кроці, де після шматків попередніх запитів
+# лишився бюджет, а шматки потім не ростуть. Тому стан будуємо прямо:
+# переставляємо довгі запити в голову `running` (так, як їх поставили б
+# інші політики чи відновлення). Бюджет 64 при порозі шматка 32 повністю
+# забирають два довгі префіли, тож поки вони йдуть, декоди бюджету не
+# мають — це очікувано. Перевіряємо, що ПІСЛЯ префілу декоди не голодують
+# і групи вирівнюються.
+
+D3_BUDGET = 64
+D3_CHUNK = 32
+
+
+def _prefill_ahead_of_decodes(n0: int):
+    scheduler, engine, decoders = _start_decoding(
+        n0, max_num_batched_tokens=D3_BUDGET,
+        long_prefill_token_threshold=D3_CHUNK,
+    )
+    engine.run_turns(WARMUP_TURNS)
+    longs = []
+    for i, prompt in enumerate((300, 420)):
+        (req,) = create_requests(
+            num_requests=1, num_tokens=prompt, max_tokens=500,
+            ignore_eos=True, req_ids=[f"long{i}"],
+        )
+        longs.append(req)
+        scheduler.add_request(req)
+    for _ in range(3 * engine.queue_size):
+        if all(r in scheduler.running for r in longs):
+            break
+        engine.step()
+    assert all(r in scheduler.running for r in longs)
+    scheduler.running.sort(key=lambda r: 0 if r in longs else 1)
+    exhausted_steps = 0
+    everyone = decoders + longs
+    for _ in range(200 * engine.queue_size):
+        if _all_decoding(everyone):
+            break
+        batch = engine.step()
+        if batch is not None and batch.total_num_scheduled_tokens >= D3_BUDGET:
+            exhausted_steps += 1
+    assert _all_decoding(everyone), "Довгі префіли не завершилися"
+    assert exhausted_steps > 0, "Бюджет жодного разу не вичерпано — стан не той"
+    return scheduler, engine, everyone
+
