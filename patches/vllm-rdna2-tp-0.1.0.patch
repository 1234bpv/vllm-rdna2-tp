+# SPDX-License-Identifier: Apache-2.0
+"""Independent specification-based tests for W8A16 skinny GEMV and linear layers.
+
+Target hardware: AMD RX 6800 (gfx1030, ROCm).
+Specification requirements:
+1. quantize_w8:
+   - symmetric, per-row;
+   - |int8| <= 127;
+   - scale = amax(row) / 127 (rounded to fp16 precision, stored in fp32);
+   - zero row does not yield NaN/Inf;
+   - dequantized weight differs elementwise by <= scale/2 (+ fp16 error).
+2. w8a16_gemv / w8a16_gemv_f32:
+   - match fp32 reference x.float() @ (w_int8.float() * scale[:, None]).T
+   - relative error <= 2e-3 (fp16 output) and <= 1e-5 (fp32 output)
+   - n = 1..5 for gemv, n = 1..16 for gemv_f32
+   - M in {1, 31, 32, 256, 2048, 6144, 124160} x K in {16, 256, 2048, 4096, 2064}
+   - with and without bias; tail rows checked.
+3. Unsupported inputs rejected explicitly (RuntimeError / ValueError), never silent wrong outputs.
+4. w8a16_linear:
+   - n = 1..5, 6..16 (chunked), 17, 64, 300 (dequant + GEMM) match reference (<= 2e-3)
+   - 3D x [b, s, K] -> [b, s, M]
+   - deterministic (bitwise equal across calls).
+5. HIP graph capture (torch.cuda.CUDAGraph):
+   - n = 1 and n = 4, replay matches direct execution bitwise.
+6. Integration:
+   - VLLM_ROCM_W8A16=1: ReplicatedLinear has weight_int8 / weight_scale,
+     forward rel error <= 1.5e-2 vs fp16 path and <= 2e-3 vs dequant reference.
+   - VLLM_ROCM_W8A16=0: no int8 buffers, standard forward.
+   - prefixes ending with .gate, .shared_expert_gate, or containing visual are not quantized.
+"""
+
+import math
+import os
+from typing import Optional
+
+import pytest
+import torch
+import torch.nn as nn
+
+from vllm.platforms import current_platform
+
+if not current_platform.is_rocm():
+    pytest.skip("W8A16 skinny GEMV is supported only on ROCm", allow_module_level=True)
+
+from vllm.model_executor.layers.w8a16_skinny import (
+    KERNEL_MAX_N,
+    SKINNY_MAX_N,
+    layer_eligible,
+    quantize_layer,
+    quantize_w8,
+    w8a16_dequant,
+    w8a16_gemv,
+    w8a16_gemv_f32,
+    w8a16_linear,
+)
+
+# Skip global dist cleanup between independent kernel tests to avoid tearing down
+# torch context prematurely; dist_init fixture manages distributed state explicitly.
+pytestmark = pytest.mark.skip_global_cleanup
+
+
+def compute_rel_error(actual: torch.Tensor, expected: torch.Tensor) -> float:
+    """Compute Frobenius/L2 relative error between actual and expected tensors."""
+    diff = actual.float() - expected.float()
+    norm_diff = torch.linalg.norm(diff.reshape(-1))
+    norm_exp = torch.linalg.norm(expected.float().reshape(-1))
+    if norm_exp.item() == 0.0:
+        return norm_diff.item()
+    return (norm_diff / norm_exp).item()
+
+
+def compute_fp32_reference(
+    x: torch.Tensor,
+    w_int8: torch.Tensor,
+    scale: torch.Tensor,
+    bias: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Compute fp32 reference: x.float() @ (w_int8.float() * scale[:, None]).T + bias."""
+    m, k = w_int8.shape
+    # For large M, compute as (x.float() @ w_int8.float().T) * scale + bias
+    # to avoid allocating massive [M, K] fp32 weight tensors.
+    # Mathematically: x @ (W * scale[:, None]).T == (x @ W.T) * scale
+    ref = (x.reshape(-1, k).float() @ w_int8.float().t()) * scale.float()
+    if bias is not None:
+        ref = ref + bias.float()
+    return ref.reshape(*x.shape[:-1], m)
+
+
+# ==============================================================================
+# 1. quantize_w8 Specification Tests
+# ==============================================================================
+
+
+class TestQuantizeW8Spec:
+    """Tests strictly against Specification 1 for quantize_w8."""
+
+    def test_symmetry_and_per_row_scale(self):
+        """Scale must be per-row (shape [M]), symmetric (|int8| <= 127).
+
+        scale = amax(row) / 127 rounded to fp16 then stored in fp32.
+        """
+        torch.manual_seed(101)
+        m, k = 64, 128
+        w = torch.randn(m, k, dtype=torch.float16, device="cuda")
+        # Ensure distinct row magnitudes
+        for i in range(m):
+            w[i] = w[i] * (0.01 * (i + 1))
+
+        w_q, scale = quantize_w8(w)
+
+        assert w_q.shape == (m, k)
+        assert w_q.dtype == torch.int8
+        assert scale.shape == (m,)
+        assert scale.dtype == torch.float32
+
+        # Check per-row scale formula: (amax / 127).to(fp16).to(fp32)
+        row_amax = w.abs().amax(dim=1).to(torch.float32)
+        expected_scale = (row_amax / 127.0).clamp_min(1e-7).to(torch.float16).to(torch.float32)
+        torch.testing.assert_close(scale, expected_scale, rtol=1e-5, atol=1e-7)
+
+    def test_strict_int8_bounds_no_neg128(self):
+        """Check that |int8| <= 127 strictly; -128 is disallowed in symmetric quantization."""
+        torch.manual_seed(102)
+        m, k = 32, 64
+        # Create tensor with large negative and positive extremes
+        w = torch.zeros(m, k, dtype=torch.float16, device="cuda")
+        w[0, 0] = -65504.0  # Min normal fp16
+        w[0, 1] = 65504.0   # Max normal fp16
+        w[1] = -100.0       # All negative
+        w[2] = 100.0        # All positive
+        w[3:] = torch.randn(m - 3, k, dtype=torch.float16, device="cuda") * 50.0
+
+        w_q, scale = quantize_w8(w)
+
+        assert int(w_q.min().item()) >= -127, f"Found value < -127: {w_q.min().item()}"
+        assert int(w_q.max().item()) <= 127, f"Found value > 127: {w_q.max().item()}"
+        assert not (w_q == -128).any(), "Found forbidden int8 value -128 in symmetric quantization"
+
+    def test_zero_row_no_nan_inf(self):
+        """Zero row must not produce NaN or Inf scale; scale must be finite and positive."""
+        m, k = 16, 64
+        w = torch.zeros(m, k, dtype=torch.float16, device="cuda")
+        # Row 1 is non-zero, others all zero
+        w[1, :] = 1.0
+
+        w_q, scale = quantize_w8(w)
+
+        assert not torch.isnan(scale).any(), "Scale contains NaN for zero row"
+        assert not torch.isinf(scale).any(), "Scale contains Inf for zero row"
+        assert (scale > 0.0).all(), "Scale must be strictly positive"
+        # Zero rows must quantize to all zeros
+        assert (w_q[0] == 0).all()
+        assert (w_q[2:] == 0).all()
+
+    def test_dequant_elementwise_error_bound(self):
+        """Dequantized weight differs from original by <= scale/2 (+ fp16 rounding error)."""
+        torch.manual_seed(103)
+        shapes = [(1, 16), (31, 256), (32, 512), (256, 2048)]
+        for m, k in shapes:
+            w = torch.randn(m, k, dtype=torch.float16, device="cuda") * 2.5
+            w_q, scale = quantize_w8(w)
+
+            # Dequantized weight
+            w_deq = w_q.float() * scale[:, None]
+            elem_diff = (w.float() - w_deq).abs()
+
+            # Bound: scale / 2 + fp16 error margin (0.5 ULP of w + eps)
+            bound = scale[:, None] / 2.0 + 1e-3 * w.float().abs() + 1e-5
+            violations = elem_diff > bound
+            assert not violations.any(), (
+                f"Elementwise error bound violated for shape ({m}, {k}): "
+                f"max violation = {(elem_diff - bound).max().item():.6e}"
+            )
+
+    def test_empty_weight_handling(self):
+        """quantize_w8 on empty weight matrix M=0 returns empty outputs."""
+        w = torch.empty(0, 32, dtype=torch.float16, device="cuda")
+        w_q, scale = quantize_w8(w)
+        assert w_q.shape == (0, 32)
+        assert scale.shape == (0,)
+
+
+# ==============================================================================
+# 2. w8a16_gemv / w8a16_gemv_f32 Specification Tests
+# ==============================================================================
+
+
+SPEC_M_VALUES = [1, 31, 32, 256, 2048, 6144, 124160]
+SPEC_K_VALUES = [16, 256, 2048, 4096, 2064]
+
+
+class TestGemvAccuracySpec:
+    """Tests against Specification 2: accuracy against fp32 reference, M x K shapes, tails."""
+
+    @pytest.mark.parametrize("M", SPEC_M_VALUES)
+    @pytest.mark.parametrize("K", SPEC_K_VALUES)
+    def test_w8a16_gemv_shapes_and_n_range(self, M: int, K: int):
+        """Verify w8a16_gemv for n=1..5 with and without bias across all (M, K) combinations."""
+        torch.manual_seed(M * 1000 + K)
+
+        # Generate integer weights directly in [-127, 127]
+        w_int8 = torch.randint(-127, 128, (M, K), dtype=torch.int8, device="cuda")
+        scale = torch.rand(M, dtype=torch.float32, device="cuda") * 0.05 + 0.001
+        bias = torch.randn(M, dtype=torch.float16, device="cuda")
+
+        # Test boundary and middle n values in 1..5
+        for n in [1, 2, 5]:
+            x = torch.randn(n, K, dtype=torch.float16, device="cuda")
+
+            # 1. Without bias, fp16 output (rel err <= 2e-3)
+            out16 = w8a16_gemv(x, w_int8, scale, bias=None, out_f32=False)
+            assert out16.shape == (n, M)
+            assert out16.dtype == torch.float16
+            ref = compute_fp32_reference(x, w_int8, scale, bias=None)
+            rel16 = compute_rel_error(out16, ref)
+            assert rel16 <= 2e-3, (
+                f"w8a16_gemv without bias failed at M={M}, K={K}, n={n}: rel_err={rel16:.6e} > 2e-3"
+            )
+
+            # 2. With bias, fp16 output (rel err <= 2e-3)
+            out16_b = w8a16_gemv(x, w_int8, scale, bias=bias, out_f32=False)
+            assert out16_b.shape == (n, M)
+            assert out16_b.dtype == torch.float16
+            ref_b = compute_fp32_reference(x, w_int8, scale, bias=bias)
+            rel16_b = compute_rel_error(out16_b, ref_b)
+            assert rel16_b <= 2e-3, (
+                f"w8a16_gemv with bias failed at M={M}, K={K}, n={n}: rel_err={rel16_b:.6e} > 2e-3"
+            )
+
+            # 3. Without bias, fp32 output via out_f32=True (rel err <= 1e-5)
+            out32 = w8a16_gemv(x, w_int8, scale, bias=None, out_f32=True)
+            assert out32.shape == (n, M)
+            assert out32.dtype == torch.float32
+            rel32 = compute_rel_error(out32, ref)
+            assert rel32 <= 1e-5, (
+                f"w8a16_gemv out_f32 failed at M={M}, K={K}, n={n}: rel_err={rel32:.6e} > 1e-5"
+            )
+
+        del w_int8, scale, bias
+        torch.cuda.empty_cache()
+
+    @pytest.mark.parametrize("n", [1, 2, 3, 4, 5, 6, 7, 8, 12, 15, 16])
+    @pytest.mark.parametrize("M,K", [(31, 256), (256, 2048), (2048, 2064)])
+    def test_w8a16_gemv_f32_n_range(self, n: int, M: int, K: int):
+        """Verify w8a16_gemv_f32 across the full n=1..16 range (rel err <= 1e-5)."""
+        torch.manual_seed(n * 100 + M)
+        w_int8 = torch.randint(-127, 128, (M, K), dtype=torch.int8, device="cuda")
+        scale = torch.rand(M, dtype=torch.float32, device="cuda") * 0.04 + 0.002
+        x = torch.randn(n, K, dtype=torch.float16, device="cuda")
+
+        out = w8a16_gemv_f32(x, w_int8, scale)
+
+        assert out.shape == (n, M)
+        assert out.dtype == torch.float32
+        ref = compute_fp32_reference(x, w_int8, scale)
+        rel = compute_rel_error(out, ref)
+        assert rel <= 1e-5, (
+            f"w8a16_gemv_f32 failed at n={n}, M={M}, K={K}: rel_err={rel:.6e} > 1e-5"
+        )
+
+
+# ==============================================================================
+# 3. Unsupported Inputs Rejection Tests
+# ==============================================================================
+
+
+class TestUnsupportedInputsSpec:
+    """Tests against Specification 3: explicit exceptions on illegal inputs."""
+
+    @pytest.fixture(autouse=True)
+    def setup_valid_tensors(self):
+        self.M, self.K = 32, 64
+        self.w_int8 = torch.randint(-10, 10, (self.M, self.K), dtype=torch.int8, device="cuda")
+        self.scale = torch.ones(self.M, dtype=torch.float32, device="cuda")
+        self.x = torch.randn(1, self.K, dtype=torch.float16, device="cuda")
+
+    @pytest.mark.parametrize("bad_K", [15, 17, 30, 2047, 2065])
+    def test_k_not_divisible_by_16_rejected(self, bad_K: int):
+        """K not divisible by 16 must raise RuntimeError, not execute silently."""
+        w_bad = torch.randint(-10, 10, (self.M, bad_K), dtype=torch.int8, device="cuda")
+        x_bad = torch.randn(1, bad_K, dtype=torch.float16, device="cuda")
+        with pytest.raises(RuntimeError, match="divisible by 16"):
+            w8a16_gemv(x_bad, w_bad, self.scale)
+
+    def test_n_gemv_boundaries_rejected(self):
+        """w8a16_gemv accepts only n in 1..5. n=0 and n=6 must raise RuntimeError."""
+        # n = 0
+        x_0 = torch.randn(0, self.K, dtype=torch.float16, device="cuda")
+        with pytest.raises(RuntimeError, match="N must be 1..5"):
+            w8a16_gemv(x_0, self.w_int8, self.scale)
+
+        # n = 6
+        x_6 = torch.randn(6, self.K, dtype=torch.float16, device="cuda")
+        with pytest.raises(RuntimeError, match="N must be 1..5"):
+            w8a16_gemv(x_6, self.w_int8, self.scale)
+
+    def test_n_gemv_f32_boundaries_rejected(self):
+        """w8a16_gemv_f32 accepts only n in 1..16. n=0 and n=17 must raise ValueError."""
+        # n = 0
+        x_0 = torch.randn(0, self.K, dtype=torch.float16, device="cuda")
+        with pytest.raises(ValueError, match="n має бути 1.."):
+            w8a16_gemv_f32(x_0, self.w_int8, self.scale)
+
+        # n = 17
+        x_17 = torch.randn(17, self.K, dtype=torch.float16, device="cuda")
+        with pytest.raises(ValueError, match="n має бути 1.."):
+            w8a16_gemv_f32(x_17, self.w_int8, self.scale)
+
+    @pytest.mark.parametrize("bad_dtype", [torch.float32, torch.bfloat16, torch.int32])
+    def test_illegal_x_dtype_rejected(self, bad_dtype):
+        """x with non-fp16 dtype must be explicitly rejected by w8a16_gemv."""
+        x_bad = torch.randn(1, self.K, device="cuda").to(bad_dtype)
+        with pytest.raises(RuntimeError, match="x must be fp16"):
+            w8a16_gemv(x_bad, self.w_int8, self.scale)
+
+    def test_non_contiguous_weight_rejected(self):
+        """Non-contiguous weight tensor must be rejected with RuntimeError."""
+        w_noncontig = torch.randint(
+            -10, 10, (self.M, self.K * 2), dtype=torch.int8, device="cuda"
+        )[:, ::2]
+        assert not w_noncontig.is_contiguous()
+        with pytest.raises(RuntimeError, match="contiguous"):
+            w8a16_gemv(self.x, w_noncontig, self.scale)
+
+    def test_non_contiguous_x_rejected(self):
+        """Non-contiguous x tensor must be rejected with RuntimeError."""
+        x_noncontig = torch.randn(1, self.K * 2, dtype=torch.float16, device="cuda")[:, ::2]
+        assert not x_noncontig.is_contiguous()
+        with pytest.raises(RuntimeError, match="contiguous"):
+            w8a16_gemv(x_noncontig, self.w_int8, self.scale)
+
+    def test_dimension_mismatch_rejected(self):
+        """Mismatched tensor dimensions must be rejected with RuntimeError."""
