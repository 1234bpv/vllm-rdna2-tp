+# SPDX-License-Identifier: Apache-2.0
+"""Specification-based tests for HIP int4 prefill attention kernel.
+
+Tests are written strictly against the functional specification:
+1. Accuracy against independent reference: fp32 attention on original (unquantized)
+   K, V tensors with causal and sliding window masking. HIP relative error <= Triton error * 1.1 + 1e-3.
+2. Causality: modifying K/V tokens strictly after query position does not alter
+   the output for that query token (bitwise identical).
+3. Sliding window: modifying K/V tokens strictly outside the sliding window does not
+   alter the output (bitwise identical); modifying the token on the boundary changes output.
+4. Page layout invariance: permuting physical blocks in block_table produces bitwise identical output.
+5. Batch sequence independence: sequence A alone vs in a batch with sequence B produces
+   bitwise identical output for sequence A.
+6. Coverage of block sizes (16, 32), head configurations (512 with 8q/1kv, 256 with 8q/4kv sw1024,
+   256 with 8q/1kv), non-block-aligned context lengths, q_len > 1 (2, 17, 700), context up to ~5000.
+7. Verification that HIP kernel is dispatched when VLLM_ROCM_INT4_PREFILL_KERNEL='hip'.
+"""
+
+import math
+import os
+from typing import Optional, Tuple
+
+import pytest
+import torch
+
+from vllm.v1.attention.ops.int4_per_token_head import (
+    reshape_and_cache_int4,
+    single_rht,
+    unified_attention_int4,
+)
+import vllm.v1.attention.ops.int4_prefill_attn as hip_prefill_mod
+
+DEVICE = torch.device("cuda:0")
+
+# Head configs under test: (name, head_size, num_qh, num_kvh, window_size)
+CONFIG_GEMMA_GLOBAL = ("head512_q8_kv1", 512, 8, 1, (-1, -1))
+CONFIG_SLIDING_G2 = ("head256_q8_kv4_sw1024", 256, 8, 4, (1023, 0))
+CONFIG_G8_256 = ("head256_q8_kv1", 256, 8, 1, (-1, -1))
+
+ALL_CONFIGS = [CONFIG_GEMMA_GLOBAL, CONFIG_SLIDING_G2, CONFIG_G8_256]
+
+
+# ----------------------------------------------------------------------
+# Independent fp32 Reference Implementation
+# ----------------------------------------------------------------------
+
+def ref_attention(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    softmax_scale: float,
+    window_size: Optional[Tuple[int, int]],
+    context_len: int,
+) -> torch.Tensor:
+    """Independent vectorized fp32 reference attention on original K, V.
+
+    q: [q_len, num_query_heads, head_size]
+    k: [seq_len, num_kv_heads, head_size]
+    v: [seq_len, num_kv_heads, head_size]
+    """
+    q_len, num_qh, hs = q.shape
+    seq_len, num_kvh, _ = k.shape
+    g = num_qh // num_kvh
+
+    # Expand KV heads for GQA
+    k_exp = k.repeat_interleave(g, dim=1)  # [seq_len, num_qh, hs]
+    v_exp = v.repeat_interleave(g, dim=1)  # [seq_len, num_qh, hs]
+
+    qt = q.transpose(0, 1).float()  # [num_qh, q_len, hs]
+    kt = k_exp.transpose(0, 1).float()  # [num_qh, seq_len, hs]
+    vt = v_exp.transpose(0, 1).float()  # [num_qh, seq_len, hs]
+
+    scores = torch.bmm(qt, kt.transpose(1, 2)) * softmax_scale  # [num_qh, q_len, seq_len]
+
+    pos_q = context_len + torch.arange(q_len, device=q.device).unsqueeze(1)  # [q_len, 1]
+    pos_k = torch.arange(seq_len, device=k.device).unsqueeze(0)  # [1, seq_len]
+
+    # Causal mask: key > query
+    mask = pos_k > pos_q
+
+    # Sliding window: visible if 0 <= pos_q - pos_k < W
+    if window_size is not None and window_size[0] >= 0:
+        w = window_size[0] + 1
+        mask = mask | ((pos_q - pos_k) >= w)
+
+    scores.masked_fill_(mask.unsqueeze(0), float("-inf"))
+    probs = torch.softmax(scores, dim=-1)  # [num_qh, q_len, seq_len]
+    out = torch.bmm(probs, vt)  # [num_qh, q_len, hs]
+    return out.transpose(0, 1)  # [q_len, num_qh, hs]
+
+
+# ----------------------------------------------------------------------
+# Helpers for Cache and Attention
+# ----------------------------------------------------------------------
+
+def allocate_int4_cache(
+    num_blocks: int,
+    block_size: int,
+    num_kv_heads: int,
+    head_size: int,
+    device: torch.device = DEVICE,
+):
+    k_cache = torch.zeros(
+        num_blocks, block_size, num_kv_heads, head_size // 2,
+        dtype=torch.uint8, device=device
+    )
+    v_cache = torch.zeros(
+        num_blocks, block_size, num_kv_heads, head_size // 2,
+        dtype=torch.uint8, device=device
+    )
+    k_scale_cache = torch.zeros(
+        num_blocks, block_size, num_kv_heads,
+        dtype=torch.float32, device=device
+    )
+    v_scale_cache = torch.zeros(
+        num_blocks, block_size, num_kv_heads,
+        dtype=torch.float32, device=device
+    )
+    return k_cache, v_cache, k_scale_cache, v_scale_cache
+
+
+def run_prefill_attn(
+    kernel: str,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    k_scale_cache: torch.Tensor,
+    v_scale_cache: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    max_seqlen_q: int,
+    seqused_k: torch.Tensor,
+    max_seqlen_k: int,
+    softmax_scale: float,
+    window_size: Tuple[int, int],
+    block_table: torch.Tensor,
+) -> torch.Tensor:
+    os.environ["VLLM_ROCM_INT4_PREFILL_KERNEL"] = kernel
+    out = torch.empty_like(q)
+    unified_attention_int4(
+        q=q.clone(),
+        k_cache=k_cache,
+        v_cache=v_cache,
+        out=out,
+        cu_seqlens_q=cu_seqlens_q,
+        max_seqlen_q=max_seqlen_q,
+        seqused_k=seqused_k,
+        max_seqlen_k=max_seqlen_k,
+        softmax_scale=softmax_scale,
+        window_size=window_size,
+        block_table=block_table,
+        softcap=0.0,
+        sinks=None,
+        alibi_slopes=None,
+        use_alibi_sqrt=False,
+        qq_bias=None,
+        output_scale=None,
+        mm_prefix_range=None,
+        k_scale_cache=k_scale_cache,
+        v_scale_cache=v_scale_cache,
+    )
+    return out
+
+
+# ----------------------------------------------------------------------
+# 1. Accuracy Against Independent Reference
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    "config",
+    ALL_CONFIGS,
+    ids=[c[0] for c in ALL_CONFIGS],
+)
+@pytest.mark.parametrize("block_size", [16, 32])
+@pytest.mark.parametrize(
+    "q_len, seq_len",
+    [
+        (2, 35),       # Small context, min q_len
+        (17, 257),     # Medium context
+        (700, 4999),   # Large context up to ~5000
+    ],
+    ids=["q2_seq35", "q17_seq257", "q700_seq4999"],
+)
+def test_accuracy_vs_reference(config, block_size, q_len, seq_len):
+    """Specification 1: HIP relative error <= Triton relative error * 1.1 + 1e-3."""
+    _, head_size, num_qh, num_kvh, window_size = config
+    context_len = seq_len - q_len
+    num_blocks = (seq_len + block_size - 1) // block_size
+
+    torch.manual_seed(1234)
+    k = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q = torch.randn(q_len, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    block_table = torch.arange(num_blocks, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+    slot_mapping = torch.arange(seq_len, dtype=torch.int64, device=DEVICE)
+
+    reshape_and_cache_int4(
+        k, v, k_cache, v_cache, slot_mapping,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+    cu_seqlens_q = torch.tensor([0, q_len], dtype=torch.int32, device=DEVICE)
+    seqused_k = torch.tensor([seq_len], dtype=torch.int32, device=DEVICE)
+
+    ref = ref_attention(q, k, v, softmax_scale, window_size, context_len)
+
+    out_triton = run_prefill_attn(
+        "triton", q, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    out_hip = run_prefill_attn(
+        "hip", q, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    assert not torch.isnan(out_hip).any(), "HIP output contains NaNs"
+    assert not torch.isinf(out_hip).any(), "HIP output contains Infs"
+
+    norm_ref = torch.linalg.norm(ref)
+    err_triton = (torch.linalg.norm(out_triton.float() - ref) / norm_ref).item()
+    err_hip = (torch.linalg.norm(out_hip.float() - ref) / norm_ref).item()
+    allowed_limit = err_triton * 1.1 + 1e-3
+
+    assert err_hip <= allowed_limit, (
+        f"HIP relative error {err_hip:.6f} exceeded Triton error "
+        f"{err_triton:.6f} * 1.1 + 1e-3 (limit: {allowed_limit:.6f})"
+    )
+
+
+# ----------------------------------------------------------------------
+# 2. Causality
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize("kernel", ["hip", "triton"])
+@pytest.mark.parametrize(
+    "config",
+    ALL_CONFIGS,
+    ids=[c[0] for c in ALL_CONFIGS],
+)
+@pytest.mark.parametrize("block_size", [16, 32])
+@pytest.mark.parametrize(
+    "q_len, seq_len",
+    [(17, 73), (17, 257)],
+    ids=["q17_seq73", "q17_seq257"],
+)
+def test_causality(kernel, config, block_size, q_len, seq_len):
+    """Specification 2: Modifying K/V tokens strictly after query position
+    does not alter the output for that query row (bitwise identical).
+    """
+    _, head_size, num_qh, num_kvh, window_size = config
+    context_len = seq_len - q_len
+    num_blocks = (seq_len + block_size - 1) // block_size
+
+    torch.manual_seed(42)
+    k = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q = torch.randn(q_len, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    block_table = torch.arange(num_blocks, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+    slot_mapping = torch.arange(seq_len, dtype=torch.int64, device=DEVICE)
+
+    reshape_and_cache_int4(
+        k, v, k_cache, v_cache, slot_mapping,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+    cu_seqlens_q = torch.tensor([0, q_len], dtype=torch.int32, device=DEVICE)
+    seqused_k = torch.tensor([seq_len], dtype=torch.int32, device=DEVICE)
+
+    out_base = run_prefill_attn(
+        kernel, q, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    # Modify K/V token at position context_len + 1 (strictly after query token 0 at context_len)
+    k_mod = k.clone()
+    v_mod = v.clone()
+    k_mod[context_len + 1] = torch.randn_like(k_mod[context_len + 1])
+    v_mod[context_len + 1] = torch.randn_like(v_mod[context_len + 1])
+
+    k_cache_mod, v_cache_mod, k_scale_mod, v_scale_mod = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    reshape_and_cache_int4(
+        k_mod, v_mod, k_cache_mod, v_cache_mod, slot_mapping,
+        k_scale_cache=k_scale_mod, v_scale_cache=v_scale_mod
+    )
+
+    out_mod = run_prefill_attn(
+        kernel, q, k_cache_mod, v_cache_mod, k_scale_mod, v_scale_mod,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    # Row 0 must be bitwise identical
+    assert torch.equal(out_mod[0], out_base[0]), (
+        f"Causality violation in {kernel}: query row 0 changed when key at context_len + 1 was modified!"
+    )
+
+    # Last query row sees key at context_len + 1, so it MUST change
+    assert not torch.equal(out_mod[-1], out_base[-1]), (
+        f"Test sensitivity failure in {kernel}: last row did not change when visible key was modified"
+    )
+
+    # Boundary test: modify unused slots in the last allocated block beyond seqused_k
+    total_slots = num_blocks * block_size
+    if total_slots > seq_len:
+        k_cache_unused = k_cache.clone()
+        v_cache_unused = v_cache.clone()
+        k_scale_unused = k_scale_cache.clone()
+        v_scale_unused = v_scale_cache.clone()
+
+        # Fill unused slots with arbitrary values
+        for slot in range(seq_len, total_slots):
+            bl = slot // block_size
+            sl = slot % block_size
+            k_cache_unused[bl, sl] = 0xAA
+            v_cache_unused[bl, sl] = 0x55
+            k_scale_unused[bl, sl] = 999.0
+            v_scale_unused[bl, sl] = 999.0
+
+        out_unused = run_prefill_attn(
+            kernel, q, k_cache_unused, v_cache_unused, k_scale_unused, v_scale_unused,
+            cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+        )
+        assert torch.equal(out_unused, out_base), (
+            f"Unused slot leakage in {kernel}: modifying slots beyond seqused_k changed output!"
+        )
+
+
+# ----------------------------------------------------------------------
+# 3. Sliding Window
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize("kernel", ["hip", "triton"])
+@pytest.mark.parametrize("block_size", [16, 32])
+def test_sliding_window(kernel, block_size):
+    """Specification 3:
+    - Modifying K/V tokens outside the window (pos_q - pos_k >= W) does not alter output (bitwise identical).
+    - Modifying K/V token on the boundary (pos_q - pos_k == W - 1) changes output.
+    """
+    head_size = 256
+    num_qh = 8
+    num_kvh = 4
+    w_len = 1024
+    window_size = (w_len - 1, 0)
+
+    seq_len = 1500
+    q_len = 17
+    num_blocks = (seq_len + block_size - 1) // block_size
+
+    torch.manual_seed(999)
+    k = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q = torch.randn(q_len, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    block_table = torch.arange(num_blocks, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+    slot_mapping = torch.arange(seq_len, dtype=torch.int64, device=DEVICE)
+
+    reshape_and_cache_int4(
+        k, v, k_cache, v_cache, slot_mapping,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+    cu_seqlens_q = torch.tensor([0, q_len], dtype=torch.int32, device=DEVICE)
+    seqused_k = torch.tensor([seq_len], dtype=torch.int32, device=DEVICE)
+
+    out_base = run_prefill_attn(
+        kernel, q, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    # For the last query token: pos_q = seq_len - 1 = 1499
+    pos_q_last = seq_len - 1
+    pos_outside = pos_q_last - w_len        # 1499 - 1024 = 475 (outside window: pos_q - pos_k = 1024 >= W)
+    pos_boundary = pos_q_last - (w_len - 1)  # 1499 - 1023 = 476 (on boundary: pos_q - pos_k = 1023 < W)
+
+    # 1. Modify key/value outside window (at 475 and at token 50)
+    k_outside = k.clone()
+    v_outside = v.clone()
+    k_outside[pos_outside] = torch.randn_like(k_outside[pos_outside])
+    v_outside[pos_outside] = torch.randn_like(v_outside[pos_outside])
+    k_outside[50] = torch.randn_like(k_outside[50])
+    v_outside[50] = torch.randn_like(v_outside[50])
+
+    k_cache_out, v_cache_out, k_scale_out, v_scale_out = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    reshape_and_cache_int4(
+        k_outside, v_outside, k_cache_out, v_cache_out, slot_mapping,
+        k_scale_cache=k_scale_out, v_scale_cache=v_scale_out
+    )
+
+    out_outside = run_prefill_attn(
+        kernel, q, k_cache_out, v_cache_out, k_scale_out, v_scale_out,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    assert torch.equal(out_outside[-1], out_base[-1]), (
+        f"Sliding window violation in {kernel}: modifying key/value outside window (pos {pos_outside}) "
+        f"altered output for query pos {pos_q_last}!"
+    )
+
+    # 2. Modify key/value on the boundary (at 476)
+    k_boundary = k.clone()
+    v_boundary = v.clone()
+    k_boundary[pos_boundary] = torch.randn_like(k_boundary[pos_boundary])
+    v_boundary[pos_boundary] = torch.randn_like(v_boundary[pos_boundary])
+
+    k_cache_bnd, v_cache_bnd, k_scale_bnd, v_scale_bnd = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    reshape_and_cache_int4(
+        k_boundary, v_boundary, k_cache_bnd, v_cache_bnd, slot_mapping,
+        k_scale_cache=k_scale_bnd, v_scale_cache=v_scale_bnd
+    )
+
+    out_boundary = run_prefill_attn(
+        kernel, q, k_cache_bnd, v_cache_bnd, k_scale_bnd, v_scale_bnd,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table
+    )
+
+    assert not torch.equal(out_boundary[-1], out_base[-1]), (
+        f"Sliding window boundary failure in {kernel}: modifying boundary key at pos {pos_boundary} "
+        f"did not alter output for query pos {pos_q_last}!"
+    )
+
+
+# ----------------------------------------------------------------------
+# 4. Page Layout Invariance
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize("kernel", ["hip", "triton"])
+@pytest.mark.parametrize(
+    "config",
+    ALL_CONFIGS,
+    ids=[c[0] for c in ALL_CONFIGS],
+)
+@pytest.mark.parametrize("block_size", [16, 32])
+@pytest.mark.parametrize(
+    "q_len, seq_len",
+    [(17, 73), (17, 257)],
+    ids=["q17_seq73", "q17_seq257"],
+)
+def test_page_layout_invariance(kernel, config, block_size, q_len, seq_len):
+    """Specification 4: Permuting physical blocks in block_table produces bitwise identical output."""
+    _, head_size, num_qh, num_kvh, window_size = config
+    num_blocks = (seq_len + block_size - 1) // block_size
+
+    torch.manual_seed(555)
+    k = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v = torch.randn(seq_len, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q = torch.randn(q_len, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    # Layout 1: contiguous physical blocks [0, 1, 2, ..., num_blocks - 1]
+    k_cache1, v_cache1, k_scale_cache1, v_scale_cache1 = allocate_int4_cache(
+        num_blocks, block_size, num_kvh, head_size
+    )
+    block_table1 = torch.arange(num_blocks, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+    slot_mapping1 = torch.arange(seq_len, dtype=torch.int64, device=DEVICE)
+
+    reshape_and_cache_int4(
+        k, v, k_cache1, v_cache1, slot_mapping1,
+        k_scale_cache=k_scale_cache1, v_scale_cache=v_scale_cache1
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+    cu_seqlens_q = torch.tensor([0, q_len], dtype=torch.int32, device=DEVICE)
+    seqused_k = torch.tensor([seq_len], dtype=torch.int32, device=DEVICE)
+
+    out1 = run_prefill_attn(
+        kernel, q, k_cache1, v_cache1, k_scale_cache1, v_scale_cache1,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table1
+    )
+
+    # Layout 2: permuted physical blocks allocated inside a larger pool
+    total_pool_blocks = num_blocks * 3 + 7
+    k_cache2, v_cache2, k_scale_cache2, v_scale_cache2 = allocate_int4_cache(
+        total_pool_blocks, block_size, num_kvh, head_size
+    )
+    # Pick a random subset of blocks from the pool
+    perm_phys = torch.randperm(total_pool_blocks, dtype=torch.int32, device=DEVICE)[:num_blocks]
+    block_table2 = perm_phys.unsqueeze(0)
+
+    # Slot mapping for permuted blocks
+    slot_mapping2 = torch.zeros(seq_len, dtype=torch.int64, device=DEVICE)
+    for p in range(seq_len):
+        bl = p // block_size
+        sl = p % block_size
+        slot_mapping2[p] = perm_phys[bl].item() * block_size + sl
+
+    reshape_and_cache_int4(
+        k, v, k_cache2, v_cache2, slot_mapping2,
+        k_scale_cache=k_scale_cache2, v_scale_cache=v_scale_cache2
+    )
+
+    out2 = run_prefill_attn(
+        kernel, q, k_cache2, v_cache2, k_scale_cache2, v_scale_cache2,
+        cu_seqlens_q, q_len, seqused_k, seq_len, softmax_scale, window_size, block_table2
+    )
+
+    assert torch.equal(out1, out2), (
+        f"Page layout invariance failure in {kernel}: permuting physical blocks altered output!"
+    )
+
