+"""HIP-ядро MoE W4A16 (fp16) для gfx1030, перенесене з RDNA3 апстріму.
+
+Розширення компілюється при першому виклику через load_rdna_ext
+за зразком skinny_int4_ext, результат кешується.
+"""
+
+import os
+from functools import lru_cache
+from typing import Any, Optional
+
+from vllm.logger import init_logger
+
+logger = init_logger("vllm.moe_q_gemm_rdna2")
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+
+@lru_cache(maxsize=1)
+def moe_q_gemm_rdna2_ext() -> Optional[Any]:
+    """Зібрати (за потреби) і повернути розширення HIP; None, якщо не вдалося."""
+    try:
+        from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+
+        ext = load_rdna_ext(
+            "vllm_moe_q_gemm_rdna2",
+            os.path.join(_DIR, "moe_q_gemm_rdna2.hip"),
+            ["-O3", "--offload-arch=gfx1030"],
+        )
+        logger.info("HIP розширення moe_q_gemm_rdna2 зібрано й завантажено")
+        return ext
+    except Exception as e:
+        # Невдачу кешує lru_cache: повторна збірка на кожному шарі дорожча
+        # за відступ на Triton-шлях.
+        logger.error(
+            "moe_q_gemm_rdna2 недоступний, лишається шлях Triton: %s", e
+        )
+        return None
