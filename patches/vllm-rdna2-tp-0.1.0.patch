+def _spec_mark(name: str, t0: float) -> float:
+    """Синхронізує пристрій і додає час фази. Повертає нову точку відліку."""
+    torch.cuda.synchronize()
+    t1 = _time.perf_counter()
+    _SPEC_T[name] = _SPEC_T.get(name, 0.0) + (t1 - t0)
+    return t1
+
+
+def _spec_step_done() -> None:
+    """Звіт за ВІКНОМ: середнє лише за останні VLLM_ROCM_TIME_SPEC викликів.
+
+    ⚠️ Кожен шлях виходу з propose() мусить викликати цю функцію, інакше
+    фази того виклику залишаться в _SPEC_T і протечуть у наступне вікно.
