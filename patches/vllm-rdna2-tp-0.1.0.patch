+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CompressedTensors MoE W4A16 using the fused RDNA2 (gfx1030) HIP kernel.
+
+The kernel is the RDNA3 ``moe_gptq_gemm_rdna3`` ported to gfx1030 for fp16
+only (``kernels/moe/moe_q_gemm_rdna2.hip``); weight layout and the forward
+pass are shared with the RDNA3 method.
+
+Zero points:
+  - symmetric: synthesized exactly as upstream (stored 7, kernel adds 1);
+  - asymmetric: compressed-tensors stores the true zero point, so it is used
+    as loaded with ``zero_offset=0``. GPTQ v1 (stored zp-1) cannot encode
+    zp=0, hence the offset is an argument of the kernel.
+"""
+
+from functools import partial
+
+import torch
+
+import vllm.envs as envs
+from vllm.model_executor.kernels.moe.moe_q_gemm_rdna2 import moe_q_gemm_rdna2_ext
+from vllm.model_executor.layers.fused_moe import (
+    RoutedExperts,
+    SharedExperts,
+)
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe.compressed_tensors_moe_wna16_rdna3 import (  # noqa: E501
+    CompressedTensorsWNA16RDNA3MoEMethod,
+    _rdna3_fused_moe,
+)
+
+
+class CompressedTensorsWNA16RDNA2MoEMethod(CompressedTensorsWNA16RDNA3MoEMethod):
+    """W4A16 MoE (fp16) using the fused RDNA2 HIP kernel."""
+
+    _native_asymmetric = True
+    _native_input_dtype = torch.float16
+
+    @property
+    def deterministic(self) -> bool:
+        # Детермінований шлях: часткові суми split-K у fp32 і зведення в
+        # фіксованому порядку; 0 повертає атомарні fp16-додавання.
+        return bool(envs.VLLM_ROCM_MOE_RDNA2_DETERMINISTIC)
+
+    @property
+    def zero_offset(self) -> int:
+        return 1 if self.symmetric else 0
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        if layer.w13_weight_scale.dtype != torch.float16:
+            raise ValueError(
+                "VLLM_ROCM_MOE_RDNA2 requires fp16 (--dtype float16), got "
+                f"{layer.w13_weight_scale.dtype}"
+            )
+        super().process_weights_after_loading(layer)
+        if self.symmetric:
+            return
+        # Replace the synthesized zero points with the loaded true ones.
+        for name in ("w13", "w2"):
+            zp = getattr(layer, f"{name}_weight_zero_point").data
+            setattr(
+                layer,
+                f"{name}_qzeros",
+                torch.nn.Parameter(zp.contiguous(), requires_grad=False),
+            )
+            delattr(layer, f"{name}_weight_zero_point")
+
+    def _gemm(
+        self,
+        a,
+        c,
+        b_q_weight,
+        b_scales,
+        b_qzeros,
+        topk_weights,
+        sorted_token_ids,
+        expert_ids,
+        num_tokens_post_padded,
+        top_k,
+        block_size_m,
+        mul_topk_weight,
+        output_topk=0,
+        rows_covered=False,
+    ) -> None:
+        moe_q_gemm_rdna2_ext().moe_gemm(
+            a,
+            c,
+            b_q_weight,
+            b_scales,
+            b_qzeros,
+            topk_weights,
+            sorted_token_ids,
+            expert_ids,
+            num_tokens_post_padded,
+            top_k,
+            block_size_m,
+            mul_topk_weight,
+            output_topk,
+            self.zero_offset,
+            self.deterministic,
+            rows_covered,
+        )
+
+    def apply(
+        self,
+        layer: RoutedExperts,
+        x: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        shared_experts: SharedExperts | None,
+        shared_experts_input: torch.Tensor | None,
+    ) -> torch.Tensor:
+        activation = (
+            layer.activation
+            if isinstance(layer.activation, MoEActivation)
+            else MoEActivation.from_str(layer.activation)
+        )
+        return _rdna3_fused_moe(
+            x,
+            topk_weights,
+            topk_ids,
+            layer=layer,
+            activation=activation,
+            apply_router_weight_on_input=layer.apply_router_weight_on_input,
+            global_num_experts=layer.global_num_experts,
+            expert_map=layer.expert_map,
+            # Без expert_map кожен рядок (токен, експерт) обчислює якийсь блок.
+            gemm_fn=partial(self._gemm, rows_covered=layer.expert_map is None),
+            zero_outputs=not self.deterministic,
+        )
