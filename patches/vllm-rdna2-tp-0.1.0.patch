+// HIP kernel for int4 KV prefill attention (qlen > 1, 2D path) on AMD RDNA2
+// (gfx1030). Counterpart of int4_decode_attn.hip for the Triton `_attn_packed`
+// 2D launch: same W4A8 arithmetic (int8 Q, nibble K, sdot4 Q.K with the
+// zero-point correction, fp16 P.V through v_dot2_f32_f16), same cache layout,
+// but one pass over the whole key range per query block and the final
+// division written straight to `out` (no segments, no reduce_segments).
+//
+// head_size 256 and 512 (Gemma 4 sliding and global layers), causal mask,
+// optional sliding window, GQA group size G in {1, 2, 4, 8}.
+//
+// Work split. A workgroup has NW waves; wave w owns RW rows, row = query
+// token x query head of the KV head (r = qi * G + g). The waves of a
+// workgroup read the same K/V tile, so every re-read after the first comes
+// from the CU cache, not from memory. Waves never synchronise with each other:
+// each keeps its own Q rows and its own P exchange buffer in LDS, so waves
+// with a shorter key range (earlier query tokens) simply finish earlier.
+//
+// Inside a wave the layouts are those of the decode kernel: Q.K with lane =
+// key token (each lane takes the full dot product of its own K row, so no
+// cross-lane reduction), P.V with lane = 8 output dims of every 256-dim chunk.
+
+#include <torch/extension.h>
+#include <ATen/hip/HIPContext.h>
+#include <hip/hip_runtime.h>
+#include <hip/hip_fp16.h>
+#include <cstdint>
+#include <algorithm>
+
+#define CUDART_INF_F __int_as_float(0x7f800000)
+
+
+typedef _Float16 half2_t __attribute__((ext_vector_type(2)));
+typedef _Float16 half8_t __attribute__((ext_vector_type(8)));
+// Row loads at the 4-byte alignment the cache guarantees; the hardware takes
+// vector global loads at dword alignment, so one instruction moves 16 bytes.
+typedef uint32_t u32x4_t __attribute__((ext_vector_type(4), aligned(4)));
+
+// Butterfly reductions over the 32 lanes of a wave: DPP within a row of 16
+// lanes (quad_perm for xor 1 and 2, row_xmask for xor 4 and 8), then a row
+// swap. Each step is one VALU op with the DPP modifier folded in, where
+// __shfl_xor lowers to ds_bpermute through LDS.
+template <int CTRL>
+__device__ __forceinline__ float dpp_f32(float x) {
+    return __builtin_bit_cast(float, __builtin_amdgcn_update_dpp(0, __builtin_bit_cast(int, x), CTRL, 0xF, 0xF, true));
+}
+
+__device__ __forceinline__ float swap_rows(float x) {
+    return __builtin_bit_cast(float, __builtin_amdgcn_permlanex16(0, __builtin_bit_cast(int, x), 0x76543210u, 0xFEDCBA98u, false, false));
+}
+
+__device__ __forceinline__ float wave_max(float x) {
+    x = fmaxf(x, dpp_f32<0xB1>(x));
+    x = fmaxf(x, dpp_f32<0x4E>(x));
+    x = fmaxf(x, dpp_f32<0x164>(x));
+    x = fmaxf(x, dpp_f32<0x168>(x));
+    return fmaxf(x, swap_rows(x));
+}
+
+__device__ __forceinline__ float wave_sum(float x) {
+    x += dpp_f32<0xB1>(x);
+    x += dpp_f32<0x4E>(x);
+    x += dpp_f32<0x164>(x);
+    x += dpp_f32<0x168>(x);
+    return x + swap_rows(x);
+}
+
+__device__ __forceinline__ float scale_bits(uint32_t raw) {
+    uint32_t bits = raw & ~0xFu;
+    return __builtin_bit_cast(float, bits);
+}
