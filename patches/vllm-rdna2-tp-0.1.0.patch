+# ==============================================================================
+# 4. w8a16_linear Specification Tests
+# ==============================================================================
+
+
+class TestW8A16LinearSpec:
+    """Tests against Specification 4: all n regimes, 3D leading dims, determinism."""
+
+    @pytest.mark.parametrize(
+        "n",
+        [
+            1, 3, 5,       # Skinny single-kernel regime (1..5)
+            6, 10, 16,     # Skinny chunked-kernel regime (6..16)
+            17, 64, 300,   # Dequantize + GEMM regime (> 16)
+        ],
+    )
+    @pytest.mark.parametrize("with_bias", [False, True])
+    def test_w8a16_linear_accuracy_all_n_regimes(self, n: int, with_bias: bool):
+        """Verify w8a16_linear matches fp32 reference (rel err <= 2e-3) across all regimes."""
+        torch.manual_seed(n * 7 + (1 if with_bias else 0))
+        m, k = 128, 256
+        w_int8 = torch.randint(-127, 128, (m, k), dtype=torch.int8, device="cuda")
+        scale = torch.rand(m, dtype=torch.float32, device="cuda") * 0.05 + 0.001
+        bias = torch.randn(m, dtype=torch.float16, device="cuda") if with_bias else None
+        x = torch.randn(n, k, dtype=torch.float16, device="cuda")
+
+        out = w8a16_linear(x, w_int8, scale, bias)
+
+        assert out.shape == (n, m)
+        assert out.dtype == torch.float16
+        ref = compute_fp32_reference(x, w_int8, scale, bias)
+        rel = compute_rel_error(out, ref)
+        assert rel <= 2e-3, (
+            f"w8a16_linear failed at n={n}, with_bias={with_bias}: rel_err={rel:.6e} > 2e-3"
+        )
+
+    @pytest.mark.parametrize(
+        "leading_shape",
+        [
+            (1, 1),
+            (2, 7),
+            (3, 4, 5),
+        ],
+    )
+    def test_w8a16_linear_multidimensional_leading_dims(self, leading_shape: tuple[int, ...]):
+        """Verify w8a16_linear accepts multi-dimensional x [*lead, K] and yields [*lead, M]."""
+        torch.manual_seed(42)
+        m, k = 64, 128
+        w_int8 = torch.randint(-127, 128, (m, k), dtype=torch.int8, device="cuda")
+        scale = torch.rand(m, dtype=torch.float32, device="cuda") * 0.05 + 0.001
+        bias = torch.randn(m, dtype=torch.float16, device="cuda")
+        x = torch.randn(*leading_shape, k, dtype=torch.float16, device="cuda")
+
+        out = w8a16_linear(x, w_int8, scale, bias)
+
+        expected_shape = (*leading_shape, m)
