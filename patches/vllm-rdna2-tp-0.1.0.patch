+    знімок повної черги має групи з таблиці для N=N0+k."""
+    _, engine, _ = _staggered_scenario(n0, k, kind, arrival)
+    n = n0 + k
+    engine.run_turns(ALIGN_TURNS)
+    engine.full_queue_snapshots.clear()
+    engine.run_turns(CHECK_TURNS)
+    expected = EXPECTED_STEADY_SIZES[n]
+    observed = [_nonempty_sizes(s) for s in engine.full_queue_snapshots]
+    wrong = [(i, sizes) for i, sizes in enumerate(observed) if sizes != expected]
+    assert observed and not wrong, (
+        f"{n0}+{k} ({kind}, {arrival}): очікувано {expected}; невідповідних "
+        f"знімків {len(wrong)} з {len(observed)}; перші: {wrong[:6]}"
+    )
