+"""HIP-ядро W4A16 для малих M (декод, перевірка чернеток MTP) на gfx1030.
+
+Розширення компілюється при першому виклику через load_rdna_ext
+за зразком int4_decode_attn, результат кешується.
+"""
+
+import os
+from functools import lru_cache
+from typing import Any, Optional
+
+from vllm.logger import init_logger
+
+logger = init_logger("vllm.skinny_int4_ext")
+_DIR = os.path.dirname(os.path.abspath(__file__))
+
+# Скільки рядків активації ядро бере за один запуск.
+SKINNY_EXT_MAX_N = 8
+
+
+@lru_cache(maxsize=1)
+def skinny_int4_ext() -> Optional[Any]:
+    """Зібрати (за потреби) і повернути розширення HIP; None, якщо не вдалося."""
+    try:
+        from vllm.model_executor.kernels.rdna_ext_build import load_rdna_ext
+        # Ім'я з хешем вмісту, прапорців і теки: каталог збірки torch
+        # спільний для всіх робочих дерев форку (див. rdna_ext_build.py).
+        ext = load_rdna_ext(
+            "vllm_skinny_int4_rdna",
+            os.path.join(_DIR, "skinny_int4_ext.hip"),
+            ["-O3", "--offload-arch=gfx1030"],
+        )
+        logger.info("HIP розширення skinny_int4 зібрано й завантажено")
+        return ext
+    except Exception as e:
+        # Невдачу кешує lru_cache: повторна збірка на кожному кроці декоду
+        # дорожча за відступ на штатне ядро до перезапуску процесу.
+        logger.error("skinny_int4 недоступний, до перезапуску процесу "
+                     "лишається штатне ядро wvSplitK_int4_g: %s", e)
+        return None
