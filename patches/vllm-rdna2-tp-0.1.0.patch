+def test_request_finishing_mid_run_does_not_break_rotation():
+    """Коли один із запитів завершується (max_tokens), решта продовжують
+    отримувати токени й не голодують: N=4 -> 3 декодуючі."""
+    scheduler, engine, requests = _start_decoding(4)
+    engine.run_turns(WARMUP_TURNS)
+    # Примусово завершуємо один запит так, як це робить клієнт.
+    victim = requests[0]
+    scheduler.finish_requests(victim.request_id, RequestStatus.FINISHED_ABORTED)
+    engine.run_turns(3)  # дати черзі звільнитися від пакетів із ним
+    before = dict(engine.tokens_received)
+    engine.run_turns(FAIRNESS_TURNS // 3)
+    gained = {
+        r.request_id: engine.tokens_received[r.request_id]
+        - before.get(r.request_id, 0)
+        for r in requests[1:]
+    }
+    assert min(gained.values()) > 0, f"Хтось голодує після завершення: {gained}"
+    assert max(gained.values()) - min(gained.values()) <= 1, (
+        f"Нерівний розподіл після завершення запиту: {gained}"
