+// ── Обгортки для Python ──
+
+std::vector<torch::Tensor> quant_act(torch::Tensor x) {
+  TORCH_CHECK(x.dtype() == torch::kHalf, "активації мають бути fp16");
+  TORCH_CHECK(x.is_contiguous(), "активації мають бути суцільними");
+  const int M = x.size(0), K = x.size(1);
+  TORCH_CHECK(K % GS == 0, "K має ділитися на розмір групи");
+  auto opt_i = torch::TensorOptions().dtype(torch::kInt32).device(x.device());
+  auto opt_f = torch::TensorOptions().dtype(torch::kFloat32).device(x.device());
+  auto aq = torch::empty({M, K / 8}, opt_i);
+  auto sap = torch::empty({M, K / GS}, opt_f);
+  auto sa = torch::empty({M, K / GS}, opt_f);  // масштаб НА ГРУПУ
+  // Порожня партія: запуск із сіткою 0 повертає hipErrorInvalidValue, тож
+  // просто віддаємо порожні тензори потрібної форми.
+  if (M == 0) return {aq, sap, sa};
+  // Одна хвиля на пару (рядок, група); у блоці 256 ниток = 8 хвиль.
+  const long hvyl = (long)M * (K / GS);
+  const int blokiv = (int)((hvyl + 7) / 8);
+  quant_groups<<<blokiv, 256, 0, at::hip::getCurrentHIPStream()>>>(
+      (const __half*)x.data_ptr(), aq.data_ptr<int>(), sap.data_ptr<float>(),
+      sa.data_ptr<float>(), M, K);
+  return {aq, sap, sa};
+}
+
+torch::Tensor gemm_w4a4(torch::Tensor aq, torch::Tensor wq, torch::Tensor sap,
+                        torch::Tensor sw, torch::Tensor zp, torch::Tensor d,
+                        torch::Tensor sa, int64_t K) {
+  const int M = aq.size(0), N = wq.size(0);
+  TORCH_CHECK(aq.dtype() == torch::kInt32 && wq.dtype() == torch::kInt32,
+              "упаковані 4-бітні операнди мають бути int32");
+  TORCH_CHECK(sap.dtype() == torch::kFloat32 && sa.dtype() == torch::kFloat32,
+              "посуми й масштаби активацій мають бути fp32");
+  TORCH_CHECK(d.dtype() == torch::kInt16,
+              "поправка E мусить бути int16: вона ціла в межах +-15360");
+  TORCH_CHECK(sw.dtype() == torch::kHalf && zp.dtype() == torch::kHalf,
+              "масштаби ваг і нулі квантизації мають бути fp16");
+  TORCH_CHECK(aq.is_contiguous() && wq.is_contiguous() && sap.is_contiguous()
+                  && sw.is_contiguous() && zp.is_contiguous()
+                  && d.is_contiguous() && sa.is_contiguous(),
+              "усі операнди мають бути суцільними");
+  TORCH_CHECK(K % (2 * GS) == 0,
+              "K має ділитися на 256: ядро бере групи парами");
+  TORCH_CHECK(d.size(0) == N && d.size(1) == (int64_t)(K / GS),
+              "форма E має бути [N, K/128]");
+  TORCH_CHECK(sa.size(0) == M && sa.size(1) == (int64_t)(K / GS),
+              "форма масштабу активацій має бути [M, K/128]");
+  auto opt = torch::TensorOptions().dtype(torch::kHalf).device(aq.device());
+  auto c = torch::empty({M, N}, opt);
+  if (M == 0) return c;
+  dim3 blk(128 * 64 / 32), grd((N + 63) / 64, (M + 127) / 128);
+  gemm_prod<128, 64, 8, 4><<<grd, blk, 0, at::hip::getCurrentHIPStream()>>>(
+      aq.data_ptr<int>(), wq.data_ptr<int>(), sap.data_ptr<float>(),
+      (const __half*)sw.data_ptr(), (const __half*)zp.data_ptr(),
+      d.data_ptr<short>(), sa.data_ptr<float>(), (__half*)c.data_ptr(),
+      M, N, (int)K);
+  return c;
+}
+
+
+std::vector<torch::Tensor> quant_act8(torch::Tensor x) {
+  TORCH_CHECK(x.dtype() == torch::kHalf, "активації мають бути fp16");
+  TORCH_CHECK(x.is_contiguous(), "активації мають бути суцільними");
+  const int M = x.size(0), K = x.size(1);
+  TORCH_CHECK(K % GS == 0, "K має ділитися на розмір групи");
+  auto opt_i = torch::TensorOptions().dtype(torch::kInt32).device(x.device());
+  auto opt_f = torch::TensorOptions().dtype(torch::kFloat32).device(x.device());
+  auto aq = torch::empty({M, K / 4}, opt_i);
+  auto sasum = torch::empty({M, K / GS}, opt_f);
+  auto sa = torch::empty({M, K / GS}, opt_f);
+  if (M == 0) return {aq, sasum, sa};
+  const long hvyl = (long)M * (K / GS);
+  const int blokiv = (int)((hvyl + 7) / 8);
+  quant_groups8<<<blokiv, 256, 0, at::hip::getCurrentHIPStream()>>>(
+      (const __half*)x.data_ptr(), aq.data_ptr<int>(),
+      sasum.data_ptr<float>(), sa.data_ptr<float>(), M, K);
+  return {aq, sasum, sa};
+}
+
+torch::Tensor gemm_w4a8(torch::Tensor aq, torch::Tensor wq,
+                        torch::Tensor sasum, torch::Tensor sw,
+                        torch::Tensor zp, torch::Tensor sa, int64_t K) {
+  const int M = aq.size(0), N = wq.size(0);
+  TORCH_CHECK(aq.dtype() == torch::kInt32 && wq.dtype() == torch::kInt32,
+              "упаковані операнди мають бути int32");
+  TORCH_CHECK(sasum.dtype() == torch::kFloat32 && sa.dtype() == torch::kFloat32,
+              "суми й масштаби активацій мають бути fp32");
+  TORCH_CHECK(sw.dtype() == torch::kHalf && zp.dtype() == torch::kHalf,
+              "масштаби ваг і нулі квантизації мають бути fp16");
+  TORCH_CHECK(aq.is_contiguous() && wq.is_contiguous() && sasum.is_contiguous()
+                  && sw.is_contiguous() && zp.is_contiguous()
+                  && sa.is_contiguous(),
+              "усі операнди мають бути суцільними");
+  // ⚠️ Досить кратності 128: ядро бере ОДНУ групу на ітерацію, на відміну від
+  // чотирибітного, яке бере пару і тому вимагає 256.
+  TORCH_CHECK(K % GS == 0, "K має ділитися на 128");
+  TORCH_CHECK(sa.size(0) == M && sa.size(1) == (int64_t)(K / GS),
+              "форма масштабу активацій має бути [M, K/128]");
+  auto opt = torch::TensorOptions().dtype(torch::kHalf).device(aq.device());
+  auto c = torch::empty({M, N}, opt);
+  if (M == 0) return c;
+
+  const char* tile_env = std::getenv("VLLM_ROCM_W4A8_TILE");
+  bool use_tile_8x8 = (tile_env != nullptr && strcmp(tile_env, "8") == 0);
+
+  if (use_tile_8x8) {
+    dim3 blk(256), grd((N + 127) / 128, (M + 127) / 128);
+    gemm_w4a8_k<128, 128, 8, 8><<<grd, blk, 0, at::hip::getCurrentHIPStream()>>>(
+        aq.data_ptr<int>(), wq.data_ptr<int>(), sasum.data_ptr<float>(),
+        (const __half*)sw.data_ptr(), (const __half*)zp.data_ptr(),
+        sa.data_ptr<float>(), (__half*)c.data_ptr(), M, N, (int)K);
+  } else {
+    dim3 blk(256), grd((N + 63) / 64, (M + 127) / 128);
+    gemm_w4a8_k_tile8x4<128, 64, 8, 4><<<grd, blk, 0, at::hip::getCurrentHIPStream()>>>(
+        aq.data_ptr<int>(), wq.data_ptr<int>(), sasum.data_ptr<float>(),
+        (const __half*)sw.data_ptr(), (const __half*)zp.data_ptr(),
+        sa.data_ptr<float>(), (__half*)c.data_ptr(), M, N, (int)K);
+  }
+  return c;
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("quant_act", &quant_act, "квантування активацій у 4 біти");
+  m.def("gemm_w4a4", &gemm_w4a4, "множення W4A4");
+  m.def("quant_act8", &quant_act8, "квантування активацій у 8 бітів знаково");
+  m.def("gemm_w4a8", &gemm_w4a8, "множення W4A8");
+}
