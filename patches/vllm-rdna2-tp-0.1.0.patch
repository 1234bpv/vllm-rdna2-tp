+@pytest.mark.skipif(not (on_gfx1x() or on_gfx10()), reason="Hybrid path is gfx11/gfx12 only")
+@pytest.mark.parametrize(
+    "group_size,expected_ok", [(32, True), (64, True), (128, True), (256, False)]
