+# ===========================================================================
+# 7. INT4 unified_attention with a sliding window (Gemma-style, head_dim 256)
+# ===========================================================================
+def _int4_quantize_rht_cache(x_logical: torch.Tensor, head_size: int):
+    """Quantize a logical [.., head_size] fp32 tensor the way the INT4 write path
+    does: RHT, asymmetric 4-bit per (token, head), zero-point hidden in the low
+    4 bits of the scale. Returns (packed uint8, packed scale fp32, dequantized
+    tensor in the ORIGINAL domain, fp32)."""
+    xr = single_rht(x_logical)
+    mn = xr.amin(dim=-1)
+    mx = xr.amax(dim=-1)
+    scale = ((mx - mn) / 15.0).clamp(min=1e-6).to(torch.float32)
+    zp = (-mn / scale).round().clamp(0, 15)
+    q = (xr / scale[..., None] + zp[..., None]).round().clamp(0, 15)
+    deq_rht = (q - zp[..., None]) * scale[..., None]
+    deq = single_rht(deq_rht, inverse=True) / head_size
+
+    u = q.to(torch.uint8)
+    packed = (u[..., 0::2] & 0xF) | ((u[..., 1::2] & 0xF) << 4)
+    bits = scale.view(torch.int32)
+    scale_packed = ((bits & -16) | (zp.to(torch.int32) & 0xF)).view(torch.float32)
+    return packed, scale_packed, deq
+
+
+@pytest.mark.parametrize("pv_int8", ["0", "1", "2"])
+@pytest.mark.parametrize("use_3d", [False, True], ids=["2D", "3D"])
