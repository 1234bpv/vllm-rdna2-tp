+_HAD128: dict = {}
+
+
+def _hadamard128(device) -> torch.Tensor:
+    """Нормована матриця Адамара 128x128. Симетрична, тож H^T = H.
+
+    ⚠️ Будується ЦІЛКОМ на карті. Перша версія складала її на процесорі й
+    копіювала через `.to(device)` — і сервер не піднімався взагалі: підміна, на
+    відміну від самого ядра, не має порога за розміром партії, тож потрапляє й
+    у ЗАХОПЛЕННЯ ГРАФІВ, а там копіювання процесор->карта заборонене
+    («Cannot copy between CPU and CUDA tensors during CUDA graph capture»).
+    Тут використано тотожність Сильвестра H[a][b] = (-1)^popcount(a & b), яка
+    рахується самими поелементними операціями на карті.
+    """
+    h = _HAD128.get(device)
+    if h is None:
+        i = torch.arange(128, device=device, dtype=torch.int32)
+        b = i.unsqueeze(1) & i.unsqueeze(0)
+        par = torch.zeros_like(b)
+        for k in range(7):
+            par = par ^ ((b >> k) & 1)
+        h = torch.where(par.bool(), -1.0, 1.0).float() / (128.0 ** 0.5)
+        _HAD128[device] = h
+    return h
+
+
+def _rotate_and_requantize(
+    unpacked: torch.Tensor,
+    w_s: torch.Tensor,
+    w_zp: torch.Tensor,
+    chunk: int = 2048,
+):
+    """Обернути вагу перетворенням Адамара в межах групи й переквантувати.
+
+    Потрібно, щоб чотирибітні активації справді потрапили в добуток:
+    `y = x·W^T = (xH)·(WH)^T`, тож у пам'яті має лежати саме `WH`. Обертання
+    розмазує канальні викиди по групі, і крок квантування активацій падає —
+    заміряно, що це знижує ціну якості з +22,4% до +3,9%.
+
+    ⚠️ Ціна: підбір масштабів AWQ втрачається, бо переквантування тут просте
+    (RTN за мінімумом і максимумом групи). Саме цю ціну й треба заміряти
+    окремо — обернути ваги, а активації лишити 16-бітними.
+
+    ⚠️ По частинах уздовж N: розквантована вага у fp32 для найбільшого шару
+    27B (17408 × 8704) займала б 606 МіБ, а це на 16-гігабайтній карті під час
+    завантаження зайве.
+    """
+    n, k = unpacked.shape
+    g = 128
+    ng = k // g
+    H = _hadamard128(unpacked.device)
+    q_out = torch.empty_like(unpacked)
+    s_out = torch.empty_like(w_s)
+    z_out = torch.empty_like(w_zp)
+    for i0 in range(0, n, chunk):
+        i1 = min(i0 + chunk, n)
+        w = (
+            unpacked[i0:i1].float().view(-1, ng, g)
+            - w_zp[i0:i1].float().unsqueeze(-1)
+        ) * w_s[i0:i1].float().unsqueeze(-1)
+        wr = w @ H
+        mn = wr.amin(-1)
+        mx = wr.amax(-1)
+        sc = ((mx - mn) / 15.0).clamp_min(1e-8)
+        zp = torch.round(-mn / sc).clamp_(0.0, 15.0)
+        q = torch.clamp(
+            torch.round(wr / sc.unsqueeze(-1)) + zp.unsqueeze(-1), 0.0, 15.0
+        )
+        q_out[i0:i1] = q.reshape(-1, k).to(unpacked.dtype)
+        s_out[i0:i1] = sc.to(w_s.dtype)
+        z_out[i0:i1] = zp.to(w_zp.dtype)
+    return q_out, s_out, z_out
+
