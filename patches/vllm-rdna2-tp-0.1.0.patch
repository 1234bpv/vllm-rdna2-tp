@@ -307,6 +313,10 @@ def on_gfx1x() -> bool:
     return _ON_GFX1X and not _ON_CDNA
 
 
+def on_gfx10() -> bool:
+    return _ON_GFX10
+
+
 def on_gfx11() -> bool:
     return _ON_GFX11
 
@@ -768,6 +778,15 @@ class RocmPlatform(Platform):
             )
             return AttentionBackendEnum.FLASH_ATTN
 
+        # RDNA2 (gfx103x): Torch SDPA has neither a flash nor a memory-efficient
+        # kernel here and falls back to the math path, which materialises the
+        # full attention matrix — a 16k-token ViT batch then asks for >100 GiB
+        # and the worker dies during the profile run. The Triton backend keeps
+        # attention tiled, so prefer it.
+        if on_gfx10() and dtype in (torch.float16, torch.bfloat16):
