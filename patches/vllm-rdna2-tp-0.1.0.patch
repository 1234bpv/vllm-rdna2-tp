+# ----------------------------------------------------------------------
+# 5. Batch Sequence Independence
+# ----------------------------------------------------------------------
+
+@pytest.mark.parametrize("kernel", ["hip", "triton"])
+@pytest.mark.parametrize(
+    "config",
+    ALL_CONFIGS,
+    ids=[c[0] for c in ALL_CONFIGS],
+)
+@pytest.mark.parametrize("block_size", [16, 32])
+@pytest.mark.parametrize(
+    "batch_case",
+    [
+        ("qB2_seqB257", 2, 257),   # Distinct length and q_len
+        ("qB8_seqB125", 8, 125),   # Distinct length and q_len
+    ],
+    ids=lambda x: x[0] if isinstance(x, tuple) else str(x),
+)
+# Специфікацію уточнено оркестратором 03.10: побітова незалежність від пакета НЕ гарантована на рівні
+# unified_attention_int4 для жодного ядра — зворотний RHT (int4_per_token_head.py, out.copy_(single_rht(...)))
+# іде одним GEMM fp16 на весь пакет, і rocBLAS обирає тайлінг за розміром пакета (1 ULP у ~2 з 34 816 елементів).
+# Для самого ядра властивість сувора: test_direct_hip_kernel_batch_independence.
+@pytest.mark.xfail(strict=False, reason="зворотний RHT — пакетний GEMM rocBLAS, тайлінг залежить від розміру пакета")
+def test_batch_independence(kernel, config, block_size, batch_case):
+    """Specification 5: Sequence A alone and in a batch with sequence B
+    (different context length, different q_len) gives bitwise identical output for sequence A.
+    """
+    _, head_size, num_qh, num_kvh, window_size = config
+    _, q_len_B, seq_len_B = batch_case
+
+    # Sequence A parameters
+    seq_len_A = 73
+    q_len_A = 17
+    num_blocks_A = (seq_len_A + block_size - 1) // block_size
+
+    # Sequence B parameters
+    num_blocks_B = (seq_len_B + block_size - 1) // block_size
+
+    torch.manual_seed(42)
+    k_A = torch.randn(seq_len_A, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v_A = torch.randn(seq_len_A, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q_A = torch.randn(q_len_A, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    k_B = torch.randn(seq_len_B, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    v_B = torch.randn(seq_len_B, num_kvh, head_size, dtype=torch.float16, device=DEVICE)
+    q_B = torch.randn(q_len_B, num_qh, head_size, dtype=torch.float16, device=DEVICE)
+
+    total_blocks = num_blocks_A + num_blocks_B
+    k_cache, v_cache, k_scale_cache, v_scale_cache = allocate_int4_cache(
+        total_blocks, block_size, num_kvh, head_size
+    )
+
+    slot_mapping_A = torch.arange(seq_len_A, dtype=torch.int64, device=DEVICE)
+    slot_mapping_B = torch.arange(seq_len_B, dtype=torch.int64, device=DEVICE) + num_blocks_A * block_size
+
+    reshape_and_cache_int4(
+        k_A, v_A, k_cache, v_cache, slot_mapping_A,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+    reshape_and_cache_int4(
+        k_B, v_B, k_cache, v_cache, slot_mapping_B,
+        k_scale_cache=k_scale_cache, v_scale_cache=v_scale_cache
+    )
+
+    softmax_scale = 1.0 / math.sqrt(head_size)
+
+    # 1. Run sequence A alone
+    cu_seqlens_q_A = torch.tensor([0, q_len_A], dtype=torch.int32, device=DEVICE)
+    seqused_k_A = torch.tensor([seq_len_A], dtype=torch.int32, device=DEVICE)
+    block_table_A = torch.arange(num_blocks_A, dtype=torch.int32, device=DEVICE).unsqueeze(0)
+
+    out_A_alone = run_prefill_attn(
+        kernel, q_A, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q_A, q_len_A, seqused_k_A, seq_len_A, softmax_scale, window_size, block_table_A
+    )
+
+    # 2. Run batch [A, B]
+    max_blocks = max(num_blocks_A, num_blocks_B)
+    block_table_AB = torch.zeros(2, max_blocks, dtype=torch.int32, device=DEVICE)
+    block_table_AB[0, :num_blocks_A] = torch.arange(num_blocks_A, dtype=torch.int32, device=DEVICE)
+    block_table_AB[1, :num_blocks_B] = torch.arange(num_blocks_A, total_blocks, dtype=torch.int32, device=DEVICE)
+
+    q_AB = torch.cat([q_A, q_B], dim=0)
+    cu_seqlens_q_AB = torch.tensor([0, q_len_A, q_len_A + q_len_B], dtype=torch.int32, device=DEVICE)
+    seqused_k_AB = torch.tensor([seq_len_A, seq_len_B], dtype=torch.int32, device=DEVICE)
+
+    out_AB = run_prefill_attn(
+        kernel, q_AB, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q_AB, max(q_len_A, q_len_B), seqused_k_AB, max(seq_len_A, seq_len_B),
+        softmax_scale, window_size, block_table_AB
+    )
+
+    out_A_from_AB = out_AB[:q_len_A]
+    diff_AB = (out_A_from_AB - out_A_alone).abs()
+    max_diff_AB = diff_AB.max().item()
+
+    assert torch.equal(out_A_from_AB, out_A_alone), (
+        f"Batch independence failure in {kernel} (batch [A, B], q_len_B={q_len_B}): "
+        f"max diff = {max_diff_AB}, mismatched elements = {(diff_AB > 0).sum().item()} / {diff_AB.numel()}"
+    )
+
+    # 3. Run reverse batch [B, A]
+    block_table_BA = torch.zeros(2, max_blocks, dtype=torch.int32, device=DEVICE)
+    block_table_BA[0, :num_blocks_B] = torch.arange(num_blocks_A, total_blocks, dtype=torch.int32, device=DEVICE)
+    block_table_BA[1, :num_blocks_A] = torch.arange(num_blocks_A, dtype=torch.int32, device=DEVICE)
+
+    q_BA = torch.cat([q_B, q_A], dim=0)
+    cu_seqlens_q_BA = torch.tensor([0, q_len_B, q_len_B + q_len_A], dtype=torch.int32, device=DEVICE)
+    seqused_k_BA = torch.tensor([seq_len_B, seq_len_A], dtype=torch.int32, device=DEVICE)
+
+    out_BA = run_prefill_attn(
+        kernel, q_BA, k_cache, v_cache, k_scale_cache, v_scale_cache,
+        cu_seqlens_q_BA, max(q_len_A, q_len_B), seqused_k_BA, max(seq_len_A, seq_len_B),
+        softmax_scale, window_size, block_table_BA
+    )
+
+    out_A_from_BA = out_BA[q_len_B:]
+    diff_BA = (out_A_from_BA - out_A_alone).abs()
+    max_diff_BA = diff_BA.max().item()
+
+    assert torch.equal(out_A_from_BA, out_A_alone), (
+        f"Batch independence failure in {kernel} (reverse batch [B, A], q_len_B={q_len_B}): "
+        f"max diff = {max_diff_BA}, mismatched elements = {(diff_BA > 0).sum().item()} / {diff_BA.numel()}"
+    )
+
