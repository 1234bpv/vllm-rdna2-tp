+    for t in (k_cache, v_cache):
+        if t.data_ptr() % 4 or any(s % 4 for s in t.stride()[:3]):
+            return "кеш KV не вирівняний на 4 байти"
+    if k_scale_cache.data_ptr() % 4 or v_scale_cache.data_ptr() % 4:
+        return "масштаби KV не вирівняні на 4 байти"
+    for t in (q, out, q_i8, q_scale, k_cache, v_cache, k_scale_cache,
+              v_scale_cache, block_table, seqused_k, cu_seqlens_q):
+        if not t.is_cuda:
+            return "тензор не на GPU"
+    if k_cache.size(3) < head_size // 2 or v_cache.size(3) < head_size // 2:
+        return "внутрішній вимір кеша KV менший за head_size / 2"
+    # вихід пишеться векторами по 16 байтів
+    if (out.dim() != 3 or out.stride(2) != 1 or out.size(0) < q.size(0)
+            or out.size(1) < num_query_heads or out.size(2) < head_size):
+        return "вихід не суцільний за виміром голови"
+    if out.data_ptr() % 16 or out.stride(0) % 8 or out.stride(1) % 8:
+        return "вихід не вирівняний на 16 байтів"
+    return None
+
