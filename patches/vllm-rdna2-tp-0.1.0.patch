+
+def _abort_long_prefill_in_flight(n0: int):
+    """N0 декодують; приходить довгий запит; щойно його шматок префілу
+    опиняється в черзі рушія — запит скасовують."""
+    scheduler, engine, decoders = _start_decoding(
+        n0, max_num_batched_tokens=STAGGER_BUDGET
+    )
+    engine.run_turns(WARMUP_TURNS)
+    (victim,) = create_requests(
+        num_requests=1, num_tokens=LONG_PROMPT, max_tokens=100,
+        ignore_eos=True, req_ids=["victim"],
+    )
+    scheduler.add_request(victim)
+    for _ in range(3 * engine.queue_size):
+        engine.step()
+        if any("victim" in so.num_scheduled_tokens for so in engine.queue):
+            break
+    assert any("victim" in so.num_scheduled_tokens for so in engine.queue), (
+        "Шматок префілу скасовуваного запиту так і не потрапив у чергу"
+    )
+    assert victim.num_computed_tokens < LONG_PROMPT
+    scheduler.finish_requests("victim", RequestStatus.FINISHED_ABORTED)
+    engine.mark_event()
+    return scheduler, engine, decoders, victim
+
+
+@pytest.mark.parametrize("n0", [3, 4], ids=lambda n: f"N0={n}")
+def test_abort_prefill_in_flight_not_rescheduled_and_decoders_continue(n0):
+    """D2. Скасований запит більше не планується; декодуючі за 3 обороти
+    дістають хоча б по токену."""
+    scheduler, engine, decoders, victim = _abort_long_prefill_in_flight(n0)
+    after_abort = len(engine.scheduled)
+    before = dict(engine.tokens_received)
+    engine.run_turns(3)
+    rescheduled = [
+        i for i, b in enumerate(engine.scheduled[after_abort:])
