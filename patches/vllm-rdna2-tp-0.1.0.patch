+        #
+        # Типово ВИМКНЕНО (0). Вмикається змінною VLLM_ROCM_MAX_TEMPERATURE.
+        _стеля = envs.VLLM_ROCM_MAX_TEMPERATURE
+        if _стеля > 0:
+            # ⚠️ Саму стелю тримаємо не нижче _MAX_TEMP. Захист від nan/inf
+            # вище (`0 < temperature < _MAX_TEMP`) відпрацьовує на ПОЧАТКУ
